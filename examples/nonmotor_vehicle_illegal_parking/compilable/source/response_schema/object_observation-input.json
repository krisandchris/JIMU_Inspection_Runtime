{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jimu:synthetic:parking:object_observation-input:1.0.0",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "media_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        }
      },
      "required": [
        "media_id",
        "sha256"
      ],
      "additionalProperties": false
    },
    "bbox": {
      "type": "object",
      "properties": {
        "xyxy": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 8192
          },
          "minItems": 4,
          "maxItems": 4
        }
      },
      "required": [
        "xyxy"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "image",
    "bbox"
  ],
  "additionalProperties": false
}
