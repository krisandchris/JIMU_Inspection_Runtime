{
  "$defs": {
    "BooleanValue": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "bool",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "BooleanValue",
      "type": "object"
    },
    "BoundedString": {
      "maxLength": 4096,
      "type": "string"
    },
    "EnumValue": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "enum",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/BoundedString"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "EnumValue",
      "type": "object"
    },
    "FieldName": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "FiniteNumber": {
      "type": "number"
    },
    "IntegerValue": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "integer",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "IntegerValue",
      "type": "object"
    },
    "ListValue": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "list",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "items": {
            "$ref": "#/$defs/Value"
          },
          "maxItems": 256,
          "title": "Value",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "ListValue",
      "type": "object"
    },
    "NumberValue": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "number",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/FiniteNumber"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "NumberValue",
      "type": "object"
    },
    "RecordValue": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "record",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "additionalProperties": {
            "$ref": "#/$defs/Value"
          },
          "maxProperties": 64,
          "propertyNames": {
            "$ref": "#/$defs/FieldName"
          },
          "title": "Value",
          "type": "object"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "RecordValue",
      "type": "object"
    },
    "StringValue": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "string",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/BoundedString"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "StringValue",
      "type": "object"
    },
    "Value": {
      "discriminator": {
        "mapping": {
          "bool": "#/$defs/BooleanValue",
          "enum": "#/$defs/EnumValue",
          "integer": "#/$defs/IntegerValue",
          "list": "#/$defs/ListValue",
          "number": "#/$defs/NumberValue",
          "record": "#/$defs/RecordValue",
          "string": "#/$defs/StringValue"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/BooleanValue"
        },
        {
          "$ref": "#/$defs/IntegerValue"
        },
        {
          "$ref": "#/$defs/NumberValue"
        },
        {
          "$ref": "#/$defs/StringValue"
        },
        {
          "$ref": "#/$defs/EnumValue"
        },
        {
          "$ref": "#/$defs/ListValue"
        },
        {
          "$ref": "#/$defs/RecordValue"
        }
      ]
    }
  },
  "$ref": "#/$defs/RecordValue",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
