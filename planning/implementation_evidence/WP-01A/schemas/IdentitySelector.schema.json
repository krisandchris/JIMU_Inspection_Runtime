{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Only approved Profile/Region applicability identity; never content authority.",
  "properties": {
    "artifact_id": {
      "maxLength": 128,
      "minLength": 1,
      "not": {
        "pattern": "\\s"
      },
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
      "title": "Artifact Id",
      "type": "string"
    },
    "artifact_kind": {
      "enum": [
        "profile",
        "region"
      ],
      "title": "Artifact Kind",
      "type": "string"
    },
    "version_selector": {
      "maxLength": 128,
      "minLength": 5,
      "not": {
        "pattern": "\\s"
      },
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "title": "Version Selector",
      "type": "string"
    }
  },
  "required": [
    "artifact_kind",
    "artifact_id",
    "version_selector"
  ],
  "title": "IdentitySelector",
  "type": "object"
}
