+                execution,
+                site,
+                media,
+                evidence_policy,
+                response.evidence,
+                audit_response=raw_asset,
+            )
+            saved = tuple(assets.values())
+            if failure is not None:
+                return audit.failure(
+                    failure,
+                    self.clock(),
+                    dispatched=True,
+                    version=version,
+                    evidence=saved,
+                    response_identity=response_identity,
+                    usage=response.resource_usage,
+                    nested_invocations=nested_invocations,
+                )
+            if version is None:
+                return audit.failure(
+                    _tool_error("unavailable", "tool_actual_implementation_unverified"),
+                    self.clock(),
+                    dispatched=True,
+                    evidence=saved,
+                    response_identity=response_identity,
+                    usage=response.resource_usage,
+                    nested_invocations=nested_invocations,
+                )
+            normalized = _decode_result(response.content)
