+                FROM jimu_workflow.execution_capabilities
+                WHERE project_id = :project_id AND client_id = :client_id
+                    AND execution_id = :execution_id
+            """),
+            _identity(scope, execution),
+        )
+    ).one_or_none()
+    if row is None:
