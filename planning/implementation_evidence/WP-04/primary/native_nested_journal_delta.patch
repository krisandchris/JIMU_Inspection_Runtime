+    RESULT_ADAPTER,
+    DispatchIntent,
+    DispatchLease,
+    DispatchResult,
+    DispatchTarget,
+    ModelDispatchResult,
+    ModelDispatchTarget,
+    NestedModelDispatchTarget,
+    ProviderDispatchObservation,
+    ToolDispatchResult,
