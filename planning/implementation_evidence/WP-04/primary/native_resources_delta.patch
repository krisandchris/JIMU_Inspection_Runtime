index 0000000..91d261f
--- /dev/null
+++ b/src/jimu_runtime/workers/process_guardian.py
@@ -0,0 +1,119 @@
+"""Private Linux subreaper and durable witness of worker-tree completion."""
+
+import ctypes
+import os
+import select
+import signal
+import socket
+import sqlite3
+import subprocess
+import sys
+from contextlib import closing, suppress
+from pathlib import Path
+from time import monotonic, sleep
+
+_TERM_GRACE_SECONDS = 0.15
+_POLL_SECONDS = 0.025
+_PR_SET_CHILD_SUBREAPER = 36
+
+
+def _kill_adopted_children() -> None:
+    # No concurrent waitpid can reap/reuse these PIDs before pidfd_open.
+    guardian = os.getpid()
+    children = Path(f"/proc/self/task/{guardian}/children").read_text(encoding="ascii")
+    for child in children.split():
+        with suppress(ProcessLookupError):
+            pid_fd = os.pidfd_open(int(child))
+            try:
+                signal.pidfd_send_signal(pid_fd, signal.SIGKILL)
+            finally:
+                os.close(pid_fd)
+
+
+def _supervise(control: socket.socket, worker_pid: int, stopping: bool) -> int:
+    worker_code = 125
+    stop_at: float | None = None
+    while True:
+        try:
+            pid, status = os.waitpid(-1, os.WNOHANG)
+        except ChildProcessError:
+            return worker_code
+        if pid > 0:
+            if pid == worker_pid:
+                code = os.waitstatus_to_exitcode(status)
+                worker_code = code if code >= 0 else 128 - code
+            continue
+        if stop_at is None and not stopping:
+            ready, _, _ = select.select((control,), (), (), _POLL_SECONDS)
+            if not ready:
+                continue
+            # Closing the owning supervisor's endpoint also initiates shutdown.
+            stopping = True
+        if stop_at is None:
+            stop_at = monotonic() + _TERM_GRACE_SECONDS
+            os.killpg(0, signal.SIGTERM)
+        elif monotonic() >= stop_at:
+            _kill_adopted_children()
+        sleep(_POLL_SECONDS)
+
+
+def _ignore_group_term(signum: int, frame: object) -> None:
+    # A caught signal resets to the default for the exec'd worker.
+    pass
+
+
+def main(
+    control_fd: int, ledger_uri: str, lease_id: str, generation: str, argv: list[str]
+) -> int:
+    with socket.socket(fileno=control_fd) as control:
+        if control.recv(1) != b"S":
+            _record_reaped(ledger_uri, lease_id, generation)
+            return 125
+        try:
+            libc = ctypes.CDLL(None, use_errno=True)
+            if libc.prctl(_PR_SET_CHILD_SUBREAPER, 1, 0, 0, 0) != 0:
+                raise OSError(ctypes.get_errno(), "cannot supervise descendants")
+            signal.signal(signal.SIGTERM, _ignore_group_term)
+            worker = subprocess.Popen(argv)
+        except OSError:
+            # No successful worker launch. Verify that no child remains before
+            # persisting the same witness used by the normal exit path.
+            try:
+                os.waitpid(-1, os.WNOHANG)
+            except ChildProcessError:
+                _record_reaped(ledger_uri, lease_id, generation)
+            with suppress(OSError):
+                control.sendall(b"N")
+            return 125
+        # The guardian must not keep worker pipe endpoints open while waiting.
+        os.close(0)
+        os.close(1)
+        try:
+            control.sendall(b"Y")
+        except OSError:
+            stopping = True
+        else:
+            stopping = False
+        worker.returncode = _supervise(control, worker.pid, stopping)
+        _record_reaped(ledger_uri, lease_id, generation)
+        return worker.returncode
+
+
+def _record_reaped(ledger_uri: str, lease_id: str, generation: str) -> None:
+    """Persist the receipt independently of the creator's control socket."""
+    stat = Path("/proc/self/stat").read_text(encoding="utf-8", errors="replace")
+    started = stat.rpartition(")")[2].split()[19]
+    with closing(sqlite3.connect(ledger_uri, uri=True, timeout=2)) as db, db:
+        db.execute("PRAGMA synchronous=FULL")
+        db.execute(
+            """UPDATE leases SET tree_reaped = 1
+               WHERE lease_id = ? AND owner_generation = ?
+               AND activity = 'group' AND pid = ? AND process_start = ?""",
+            (lease_id, generation, os.getpid(), started),
+        )
+
+
+if __name__ == "__main__":
+    sys.exit(
+        main(int(sys.argv[1]), sys.argv[2], sys.argv[3], sys.argv[4], sys.argv[5:])
+    )
