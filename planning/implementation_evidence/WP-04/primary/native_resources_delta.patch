+                    b"second",
+                    timeout_ms=1000,
+                    output_byte_limit=16,
+                )
+            assert duplicate.value.reason == WorkerFailure.START_FAILED
+            assert not duplicate.value.dispatched
+            assert admission.state(lease) == LeaseState.ACTIVE
+            os.kill(pids[1], 0)
+        finally:
