+def _model_record(
+    request: DispatchRequest,
+    outcome: InvocationOutcome,
+    actual: ActualProviderIdentity | None,
+    observation: ProviderObservation | None,
+    started_at: UTCDateTime,
+    completed_at: UTCDateTime,
