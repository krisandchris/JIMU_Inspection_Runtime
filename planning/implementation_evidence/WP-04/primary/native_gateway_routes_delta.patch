+_PURPOSE_NODE = {
+    ModelCapability.PROFILE_DISCOVERY: "N02",
+    "optional_question_proposal": "N02",
+    ModelCapability.OBJECT_GROUNDING: "N03",
+    ModelCapability.OBJECT_OBSERVATION: "N04",
