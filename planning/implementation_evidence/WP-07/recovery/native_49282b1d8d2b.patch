+def _fence(pg, *, on):
+    with _owner(pg) as owner:
+        oc = (
+            sql.SQL("REVOKE CONNECT ON DATABASE {} FROM {}")
+            if on
+            else sql.SQL("GRANT CONNECT ON DATABASE {} TO {}")
+        )
+        owner.execute(
+            oc.format(
+                sql.Identifier(pg.target.database), sql.Identifier(WORKFLOW_APP_ROLE)
+            )
+        )
