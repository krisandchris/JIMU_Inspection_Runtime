+def _owner(pg):
+    url = pg.migration_url
+    return psycopg.connect(
+        host="127.0.0.1",
+        port=url.port,
+        dbname=url.database,
+        user=url.username,
+        password=url.password,
+        connect_timeout=5,
+        autocommit=True,
+    )
