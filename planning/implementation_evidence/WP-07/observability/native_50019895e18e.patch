+    async def authorize(headers: _Headers) -> IdempotencyScope | None:
+        supplied = [value for name, value in headers if name == b"authorization"]
+        if len(supplied) == 1 and compare_digest(supplied[0], b"Bearer " + token):
+            return scope
+        return None
+
+    return ScrapeApplication(
+        PostgresObservability(engine), scope, authorize, engine=engine
+    )
