+_DISPOSITION = {
+    RuleTruth.TRUE: ApplicabilityDisposition.INCLUDED,
+    RuleTruth.FALSE: ApplicabilityDisposition.EXCLUDED,
+    RuleTruth.UNKNOWN: ApplicabilityDisposition.UNRESOLVED,
+}
