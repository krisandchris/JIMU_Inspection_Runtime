+        binding = _DispatchKey(scope, execution_id, dispatch_id)
+        dispatch = await self._require_dispatch(binding)
+        if not isinstance(
+            dispatch.intent.target, (ModelDispatchTarget, NestedModelDispatchTarget)
+        ):
