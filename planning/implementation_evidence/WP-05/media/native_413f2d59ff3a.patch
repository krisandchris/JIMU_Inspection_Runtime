+            await connection.execute(_ARTIFACT, {**binding.params(), "role": role})
+        ).one_or_none()
+        if row is None:
+            return None
+        return (
+            _Blob(
+                row.store_id,
+                row.content_sha256,
+                row.byte_size,
+                row.wire_sha256,
+                row.wire_size,
+                row.evidence_id,
+                row.evidence_claim_sha256,
+            ),
+            row.staged_at.astimezone(UTC),
