+}
+
+
+def _issue(step: str, code: str, message: str) -> ValidationIssue:
+    return ValidationIssue(code=code, message=message, path=(step,), related_refs=())
+
+
+def _record_value(value: Value | None, path: tuple[str, ...]) -> Value | None:
+    for part in path:
+        if not isinstance(value, RecordValue):
+            return None
+        value = value.value.get(part)
+    return value
+
+
+def _plain(value: Value) -> object:
+    if isinstance(value, RecordValue):
+        return {key: _plain(item) for key, item in value.value.items()}
+    if isinstance(value, ListValue):
+        return [_plain(item) for item in value.value]
+    return value.value
+
+
+def _fact_input(fact: FactRecord, source: FactInput) -> bool:
+    selection = source.selector
+    producer = selection.producer_selector
+    return (
+        isinstance(producer, QuestionProducerSelector)
+        and isinstance(fact.source, QuestionFactSource)
+        and (selection.fact_key, selection.fact_schema_ref, producer.question_ref)
+        == (fact.fact_key, fact.fact_schema_ref, fact.source.question_ref)
+    )
+
+
+def _inputs(
+    claimed: ClaimedNode,
+    envelope: NodeInputEnvelope,
+    plan: ToolPlanDefinition,
+    profile: ProfileDefinition,
