        WHERE e.project_id = %(project_id)s AND e.client_id = %(client_id)s
          AND e.status IN ('initialized','running')
          AND (CAST(%(after)s AS text) IS NULL OR e.execution_id > %(after)s)
          AND (
            e.cancel_requested_at IS NOT NULL
