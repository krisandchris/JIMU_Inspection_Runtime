{
  "$defs": {
    "AbsentOptional_ReviewReportRef_": {
      "$ref": "#/$defs/ReviewReportRef"
    },
    "CapabilityFamily": {
      "enum": [
        "model_deployment",
        "tool_implementation",
        "system_fact_producer",
        "context_derivation"
      ],
      "title": "CapabilityFamily",
      "type": "string"
    },
    "CapabilityFeature": {
      "enum": [
        "rgb_image",
        "typed_context",
        "structured_output",
        "original_xyxy",
        "mask_output",
        "geometry_output",
        "ocr_text"
      ],
      "title": "CapabilityFeature",
      "type": "string"
    },
    "ReviewReportRef": {
      "additionalProperties": false,
      "properties": {
        "report_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Report Id",
          "type": "string"
        },
        "review_registry_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Review Registry Id",
          "type": "string"
        },
        "sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "report_id",
        "version",
        "sha256",
        "review_registry_id"
      ],
      "title": "ReviewReportRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "allowed_implementation_versions": {
      "items": {
        "maxLength": 128,
        "minLength": 5,
        "not": {
          "pattern": "\\s"
        },
        "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
        "type": "string"
      },
      "maxItems": 1024,
      "minItems": 1,
      "title": "Allowed Implementation Versions",
      "type": "array",
      "uniqueItems": true
    },
    "capability_id": {
      "maxLength": 128,
      "minLength": 1,
      "not": {
        "pattern": "\\s"
      },
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
      "title": "Capability Id",
      "type": "string"
    },
    "contract_version": {
      "maxLength": 128,
      "minLength": 5,
      "not": {
        "pattern": "\\s"
      },
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "title": "Contract Version",
      "type": "string"
    },
    "evaluation_ref": {
      "$ref": "#/$defs/AbsentOptional_ReviewReportRef_"
    },
    "family": {
      "$ref": "#/$defs/CapabilityFamily"
    },
    "required_features": {
      "items": {
        "$ref": "#/$defs/CapabilityFeature"
      },
      "maxItems": 7,
      "title": "Required Features",
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "family",
    "capability_id",
    "contract_version",
    "allowed_implementation_versions",
    "required_features"
  ],
  "title": "ExternalCapabilityRequirement",
  "type": "object"
}
