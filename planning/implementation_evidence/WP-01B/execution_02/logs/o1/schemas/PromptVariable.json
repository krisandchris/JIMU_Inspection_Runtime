{
  "$defs": {
    "FieldName": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "FieldPath": {
      "items": {
        "$ref": "#/$defs/FieldName"
      },
      "maxItems": 8,
      "type": "array"
    },
    "PromptSource": {
      "enum": [
        "context",
        "profile_metadata",
        "question_metadata",
        "object_geometry",
        "image_reference"
      ],
      "type": "string"
    },
    "PromptVariableName": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$(?![\\s\\S])",
      "type": "string"
    },
    "SchemaRef": {
      "additionalProperties": false,
      "description": "A constrained ContentRef, not a second schema identity system.",
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_kind": {
          "enum": [
            "fact_schema",
            "value_schema",
            "response_schema",
            "attribute_schema",
            "context_schema",
            "tool_input_schema",
            "tool_output_schema",
            "object_schema",
            "decision_schema"
          ],
          "title": "Artifact Kind",
          "type": "string"
        },
        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "schema_dialect": {
          "const": "https://json-schema.org/draft/2020-12/schema",
          "title": "Schema Dialect",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_kind",
        "artifact_id",
        "version",
        "digest",
        "schema_dialect"
      ],
      "title": "SchemaRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "source": {
            "const": "context"
          }
        },
        "required": [
          "source"
        ]
      },
      "then": {
        "properties": {
          "schema_ref": {
            "properties": {
              "artifact_kind": {
                "const": "context_schema"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "const": "profile_metadata"
          }
        },
        "required": [
          "source"
        ]
      },
      "then": {
        "properties": {
          "schema_ref": {
            "properties": {
              "artifact_kind": {
                "const": "attribute_schema"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "const": "question_metadata"
          }
        },
        "required": [
          "source"
        ]
      },
      "then": {
        "properties": {
          "schema_ref": {
            "properties": {
              "artifact_kind": {
                "const": "attribute_schema"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "const": "object_geometry"
          }
        },
        "required": [
          "source"
        ]
      },
      "then": {
        "properties": {
          "schema_ref": {
            "properties": {
              "artifact_kind": {
                "const": "object_schema"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "const": "image_reference"
          }
        },
        "required": [
          "source"
        ]
      },
      "then": {
        "properties": {
          "schema_ref": {
            "properties": {
              "artifact_kind": {
                "const": "attribute_schema"
              }
            }
          }
        }
      }
    },
    {
      "else": {
        "properties": {
          "on_missing": {
            "const": "omit"
          }
        }
      },
      "if": {
        "properties": {
          "required": {
            "const": true
          }
        },
        "required": [
          "required"
        ]
      },
      "then": {
        "properties": {
          "on_missing": {
            "const": "block"
          }
        }
      }
    }
  ],
  "properties": {
    "field_path": {
      "$ref": "#/$defs/FieldPath"
    },
    "name": {
      "$ref": "#/$defs/PromptVariableName"
    },
    "on_missing": {
      "enum": [
        "block",
        "omit"
      ],
      "title": "On Missing",
      "type": "string"
    },
    "required": {
      "title": "Required",
      "type": "boolean"
    },
    "schema_ref": {
      "$ref": "#/$defs/SchemaRef"
    },
    "source": {
      "$ref": "#/$defs/PromptSource"
    }
  },
  "required": [
    "name",
    "source",
    "field_path",
    "schema_ref",
    "required",
    "on_missing"
  ],
  "title": "PromptVariable",
  "type": "object"
}
