{
  "$defs": {
    "AttributeSchemaContentRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_kind": {
          "const": "attribute_schema",
          "title": "Artifact Kind",
          "type": "string"
        },
        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_kind",
        "artifact_id",
        "version",
        "digest"
      ],
      "title": "AttributeSchemaContentRef",
      "type": "object"
    },
    "BooleanValue": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "bool",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "BooleanValue",
      "type": "object"
    },
    "BoundedString": {
      "maxLength": 4096,
      "type": "string"
    },
    "EnumValue": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "enum",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/BoundedString"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "EnumValue",
      "type": "object"
    },
    "FieldName": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "FiniteNumber": {
      "type": "number"
    },
    "IntegerValue": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "integer",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "IntegerValue",
      "type": "object"
    },
    "ListValue": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "list",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "items": {
            "$ref": "#/$defs/Value"
          },
          "maxItems": 256,
          "title": "Value",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "ListValue",
      "type": "object"
    },
    "NumberValue": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "number",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/FiniteNumber"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "NumberValue",
      "type": "object"
    },
    "RecordValue": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "record",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "additionalProperties": {
            "$ref": "#/$defs/Value"
          },
          "maxProperties": 64,
          "propertyNames": {
            "$ref": "#/$defs/FieldName"
          },
          "title": "Value",
          "type": "object"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "RecordValue",
      "type": "object"
    },
    "StringValue": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "string",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/BoundedString"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "StringValue",
      "type": "object"
    },
    "Value": {
      "discriminator": {
        "mapping": {
          "bool": "#/$defs/BooleanValue",
          "enum": "#/$defs/EnumValue",
          "integer": "#/$defs/IntegerValue",
          "list": "#/$defs/ListValue",
          "number": "#/$defs/NumberValue",
          "record": "#/$defs/RecordValue",
          "string": "#/$defs/StringValue"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/BooleanValue"
        },
        {
          "$ref": "#/$defs/IntegerValue"
        },
        {
          "$ref": "#/$defs/NumberValue"
        },
        {
          "$ref": "#/$defs/StringValue"
        },
        {
          "$ref": "#/$defs/EnumValue"
        },
        {
          "$ref": "#/$defs/ListValue"
        },
        {
          "$ref": "#/$defs/RecordValue"
        }
      ]
    }
  },
  "additionalProperties": false,
  "properties": {
    "attribute_schema_ref": {
      "$ref": "#/$defs/AttributeSchemaContentRef"
    },
    "namespace": {
      "maxLength": 128,
      "minLength": 1,
      "not": {
        "pattern": "\\s"
      },
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
      "title": "Namespace",
      "type": "string"
    },
    "value": {
      "$ref": "#/$defs/RecordValue"
    }
  },
  "required": [
    "namespace",
    "attribute_schema_ref",
    "value"
  ],
  "title": "FacetMetadataEntry",
  "type": "object"
}
