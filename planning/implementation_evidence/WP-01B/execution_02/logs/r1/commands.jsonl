{"command": ["uv", "run", "--locked", "--no-sync", "python", "-c", "import sys,json,hashlib,importlib.metadata\nfrom pathlib import Path\nsys.path.insert(0,\"tests\")\nfrom fixtures.wp01b.r1.support import fixtures, registration\nfrom jsonschema import Draft202012Validator\nfrom jimu_runtime.domain.fact_schemas.registry import FactSchemaRegistryBuilder\nfrom jimu_runtime.domain.validation.issues import ValidationReport,CheckResult,ValidationIssue\nlogs=Path(\"planning/implementation_evidence/WP-01B/execution_02/logs/r1\")\nchecks=[]\nfor tree,payload in fixtures()[\"values\"]:\n ref,definition,generated=registration(tree)\n schema=json.loads(generated.canonical_schema_bytes)\n Draft202012Validator.check_schema(schema)\n Draft202012Validator(schema).validate(payload)\n registry=FactSchemaRegistryBuilder().register(ref,definition).freeze()\n registry.validate_payload(ref,payload)\n checks.append({\"kind\":tree[\"kind\"],\"child_ref\":generated.child_ref.model_dump(mode=\"json\"),\"canonical_bytes_sha256\":hashlib.sha256(generated.canonical_schema_bytes).hexdigest(),\"status\":\"TEST_PASSED\"})\n(logs/\"schema_validation.json\").write_text(json.dumps({\"status\":\"TEST_PASSED\",\"checks\":checks,\"parent_digest_authentication\":\"NOT_PERFORMED\",\"scope\":\"Generated payload schemas and Registry strict value conformance only.\"},indent=2)+\"\\n\")\nreports=[]\nfor scope in (\"producer_admission\",\"authority_admission\"):\n report=ValidationReport(scope=scope,checks=(CheckResult(check_id=scope+\".full\",status=\"deferred\",issues=(ValidationIssue(code=\"scope.full_admission_deferred\",path=(),message=\"Full admission belongs to later integrated contracts; Registry core cannot establish it.\",related_refs=()),)),))\n reports.append({\"aggregate_status\":report.aggregate_status,\"report\":report.model_dump(mode=\"json\")})\n(logs/\"deferred_admission.json\").write_text(json.dumps(reports,indent=2)+\"\\n\")\nenv={\"python\":sys.version,\"dependencies\":{name:importlib.metadata.version(name) for name in [\"pydantic\",\"pytest\",\"jsonschema\",\"ruff\",\"mypy\",\"rfc8785\"]}}\n(logs/\"environment.json\").write_text(json.dumps(env,indent=2)+\"\\n\")\nprint(json.dumps({\"schemas_checked\":len(checks),\"all_passed\":True,\"deferred_reports\":len(reports),\"environment\":env}))\n"], "cwd": "/mnt/lc/LC/ares_xtws/4_agent/RSI_ares/inspect_pipeline/JIMU_Inspection_Runtime_WP01B", "start_utc": "2026-11-17T14:43:21.424512+00:00", "end_utc": "2026-11-17T14:43:21.721665+00:00", "exit_code": 0, "stdout": "{\"schemas_checked\": 7, \"all_passed\": true, \"deferred_reports\": 2, \"environment\": {\"python\": \"3.12.3 (main, Aug 31 2026, 10:18:26) [GCC 13.3.0]\", \"dependencies\": {\"pydantic\": \"2.12.5\", \"pytest\": \"8.4.2\", \"jsonschema\": \"4.25.1\", \"ruff\": \"0.14.14\", \"mypy\": \"1.18.2\", \"rfc8785\": \"0.1.4\"}}}\n", "stderr": ""}
