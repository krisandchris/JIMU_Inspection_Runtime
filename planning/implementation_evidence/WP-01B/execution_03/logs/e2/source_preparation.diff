+@pytest.mark.parametrize("kind", ["applicability", "tool_skip"])
+def test_exported_expression_policy_fixtures_and_invalid_tag(kind: str) -> None:
+    data = json.loads((ROOT / "tests/fixtures/wp01b/x1/contracts.json").read_text())
+    raw = data["artifacts"][kind]
+    document = json.loads(exporter.render_exports()["policies.PolicyArtifact.schema.json"])
+    validator = Draft202012Validator(document)
+    assert validator.is_valid(raw)
+    del raw["schema_version"]
+    assert not validator.is_valid(raw)
+    raw["schema_version"] = "1.0.0"
+    raw["policy"]["policy_kind"] = "unregistered"
+    assert not validator.is_valid(raw)
+
+
+def test_exported_producer_catalogue_fixture_and_missing_version() -> None:
+    raw = json.loads((ROOT / "tests/fixtures/wp01b/x2/contracts.json").read_text())["catalogue"]
+    document = json.loads(exporter.render_exports()["producers.ProducerCatalogue.schema.json"])
+    validator = Draft202012Validator(document)
+    assert validator.is_valid(raw)
+    del raw["schema_version"]
+    assert not validator.is_valid(raw)
