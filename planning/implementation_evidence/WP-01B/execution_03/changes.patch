+                    "Step and FailurePolicy requirement differ",
+                )
+        checks.append(_check("plan.failure_policies", "passed"))
+    except SchemaCheckError as exc:
+        checks.append(_failure("plan.failure_policies", exc))
+    if identity_valid:
+        try:
+            for step in plan.steps:
