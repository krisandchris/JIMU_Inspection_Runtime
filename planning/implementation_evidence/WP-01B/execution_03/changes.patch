+        "artifact_id": "fixture",
+        "version": "1.0.0",
+        "digest": "a" * 64,
+    }
+
+
+def producer(kind: str) -> dict[str, object]:
+    if kind == "vlm_question":
+        return {
+            "producer_kind": kind,
+            "question_ref": ref("question"),
+            "output_name": "primary",
+        }
+    if kind == "tool":
+        return {
+            "producer_kind": kind,
+            "tool_plan_ref": ref("tool_plan"),
