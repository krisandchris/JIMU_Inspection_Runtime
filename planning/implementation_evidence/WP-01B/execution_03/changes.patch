+
+from jimu_runtime.domain.definition_enums import PolicyKind
+from jimu_runtime.domain.policies import NonExpressionPolicyArtifact
+
+KINDS = (
+    "question_selection",
+    "unknown",
+    "question_validation",
+    "evidence",
+    "tool_execution",
+    "tool_failure",
+    "resource_requirements",
+    "provider",
+    "fallback",
+    "rule",
+    "conflict",
+    "coverage",
+    "context_provenance",
+    "execution",
+)
