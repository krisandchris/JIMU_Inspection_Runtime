+        check_id=check_id,
+        status=status,
+        issues=()
+        if status == "passed"
+        else (ValidationIssue(code=code, path=(), message=message, related_refs=()),),
+    )
+
+
+def _failure(check_id: str, exc: SchemaCheckError) -> CheckResult:
