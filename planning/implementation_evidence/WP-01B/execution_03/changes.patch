+    assert adapter.validate_python(" a ") == " a "
+    assert adapter.validate_python("x" * maximum) == "x" * maximum
+    for invalid in ("", "  \t", "x" * (maximum + 1), 3, True, None):
+        with pytest.raises(ValidationError):
