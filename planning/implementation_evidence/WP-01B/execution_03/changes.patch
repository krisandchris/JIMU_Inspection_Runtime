+    elif change == "depth":
+        encoded = b"[" * 33 + b"0" + b"]" * 33
+    elif change == "members":
+        budget = budget.model_copy(update={"max_object_members": 1})
+        encoded = b'{"a":0,"b":1}'
+    elif change == "array":
+        budget = budget.model_copy(update={"max_array_items": 1})
+        encoded = b"[0,1]"
+    else:
+        budget = budget.model_copy(update={"max_number_chars": 2})
