+            cast(dict[str, object], e["artifact"])
+            for e in registrations
+            if cast(dict[str, object], e["ref"])["artifact_id"] == "provider"
+        )
+        deployments = cast(
+            list[dict[str, object]],
+            cast(dict[str, object], provider["policy"])["deployments"],
+        )
