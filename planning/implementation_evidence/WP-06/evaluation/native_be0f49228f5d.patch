+class ReviewHistory(VersionedSnapshot):
+    dataset: SnapshotPin
+    scope: IdempotencyScope
+    split: Literal["holdout"]
+    sample_id: RecordId
+    base_truth: SnapshotPin | None
+    previous: SnapshotPin | None
+    votes: Entries[ReviewVote]
+    adjudication: Adjudication | None
