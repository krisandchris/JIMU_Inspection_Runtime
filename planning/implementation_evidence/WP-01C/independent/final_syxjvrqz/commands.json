    "argv": [
      "python3",
      "-c",
      "\nfrom hashlib import sha256\nfrom pathlib import Path\nimport json\nimport subprocess\nimport sys\n\nbaseline, first, second = sys.argv[1:]\ndirs = [Path('schemas/generated'), Path(first), Path(second)]\nsub = lambda args: subprocess.check_output(['git', *args])\npaths = sub(['ls-tree', '-r', '--name-only', baseline, '--', 'schemas/generated']).decode().splitlines()\nschemas = sorted(path for path in paths if path.endswith('.schema.json'))\nreport = {'baseline': baseline, 'count': len(schemas), 'schemas': {}}\nfor path in schemas:\n    name = Path(path).name\n    old = sha256(sub(['show', baseline + ':' + path])).hexdigest()\n    actual = {label: sha256((directory/name).read_bytes()).hexdigest() if (directory/name).is_file() else None\n        for label, directory in zip(('worktree', 'first', 'second'), dirs, strict=True)}\n    report['schemas'][name] = {'baseline': old, **actual, 'unchanged': all(value == old for value in actual.values())}\nold_index = sub(['show', baseline + ':schemas/generated/index.json'])\nreport['baseline_index_sha256'] = sha256(old_index).hexdigest()\nreport['current_index_sha256'] = sha256((dirs[0] / 'index.json').read_bytes()).hexdigest()\nreport['mismatches'] = [name for name, item in report['schemas'].items() if not item['unchanged']]\nreport['all_162_preserved'] = len(schemas) == 162 and not report['mismatches']\nprint(json.dumps(report, indent=2, sort_keys=True))\nsys.exit(0 if report['all_162_preserved'] else 1)\n",
      "2552affeb69fbc2594fe70724f895b0db0967d47",
      "/tmp/jimu-c-accept-inc8mpyl/first",
