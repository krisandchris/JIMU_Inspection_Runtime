{
  "$defs": {
    "BlockedCoverageScope": {
      "additionalProperties": false,
      "properties": {
        "blocker_node_run_ref": {
          "$ref": "#/$defs/NodeRunRef"
        },
        "configured_profile_refs": {
          "$ref": "#/$defs/RecordList_ProfileContentRef_"
        },
        "scope_status": {
          "const": "blocked",
          "title": "Scope Status",
          "type": "string"
        }
      },
      "required": [
        "scope_status",
        "blocker_node_run_ref",
        "configured_profile_refs"
      ],
      "title": "BlockedCoverageScope",
      "type": "object"
    },
    "ContextSnapshotRef": {
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Record Id",
          "type": "string"
        },
        "record_kind": {
          "const": "context_snapshot",
          "title": "Record Kind",
          "type": "string"
        }
      },
      "required": [
        "record_kind",
        "record_id"
      ],
      "title": "ContextSnapshotRef",
      "type": "object"
    },
    "EvaluatedCoverageScope": {
      "additionalProperties": false,
      "properties": {
        "configured_profile_refs": {
          "$ref": "#/$defs/RecordList_ProfileContentRef_"
        },
        "context_snapshot_ref": {
          "$ref": "#/$defs/ContextSnapshotRef"
        },
        "profile_eligibility_evaluation_ref": {
          "$ref": "#/$defs/ProfileEligibilityEvaluationRef"
        },
        "scope_status": {
          "const": "evaluated",
          "title": "Scope Status",
          "type": "string"
        }
      },
      "required": [
        "scope_status",
        "context_snapshot_ref",
        "profile_eligibility_evaluation_ref",
        "configured_profile_refs"
      ],
      "title": "EvaluatedCoverageScope",
      "type": "object"
    },
    "NodeRunRef": {
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Record Id",
          "type": "string"
        },
        "record_kind": {
          "const": "node_run",
          "title": "Record Kind",
          "type": "string"
        }
      },
      "required": [
        "record_kind",
        "record_id"
      ],
      "title": "NodeRunRef",
      "type": "object"
    },
    "ProfileContentRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_kind": {
          "const": "profile",
          "title": "Artifact Kind",
          "type": "string"
        },
        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_kind",
        "artifact_id",
        "version",
        "digest"
      ],
      "title": "ProfileContentRef",
      "type": "object"
    },
    "ProfileEligibilityEvaluationRef": {
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Record Id",
          "type": "string"
        },
        "record_kind": {
          "const": "profile_eligibility_evaluation",
          "title": "Record Kind",
          "type": "string"
        }
      },
      "required": [
        "record_kind",
        "record_id"
      ],
      "title": "ProfileEligibilityEvaluationRef",
      "type": "object"
    },
    "RecordList_ProfileContentRef_": {
      "items": {
        "$ref": "#/$defs/ProfileContentRef"
      },
      "maxItems": 1024,
      "type": "array",
      "uniqueItems": true
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "discriminator": {
    "mapping": {
      "blocked": "#/$defs/BlockedCoverageScope",
      "evaluated": "#/$defs/EvaluatedCoverageScope"
    },
    "propertyName": "scope_status"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/EvaluatedCoverageScope"
    },
    {
      "$ref": "#/$defs/BlockedCoverageScope"
    }
  ]
}
