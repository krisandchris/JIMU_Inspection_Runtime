{
  "$defs": {
    "AbsentOptional_JsonPointer_": {
      "$ref": "#/$defs/JsonPointer"
    },
    "AbsentOptional_ReviewReportRef_": {
      "$ref": "#/$defs/ReviewReportRef"
    },
    "ArtifactInventoryEntry": {
      "additionalProperties": false,
      "properties": {
        "content_ref": {
          "$ref": "#/$defs/ContentRef"
        },
        "json_pointer": {
          "$ref": "#/$defs/AbsentOptional_JsonPointer_"
        },
        "path": {
          "$ref": "#/$defs/BundlePayloadPath"
        }
      },
      "required": [
        "content_ref",
        "path"
      ],
      "title": "ArtifactInventoryEntry",
      "type": "object"
    },
    "ArtifactKind": {
      "enum": [
        "entity",
        "region",
        "profile",
        "facet",
        "question",
        "tool",
        "tool_plan",
        "rule",
        "rule_set",
        "model_binding",
        "fact_schema",
        "prompt_template",
        "response_schema",
        "attribute_schema",
        "context_schema",
        "tool_input_schema",
        "tool_output_schema",
        "object_schema",
        "decision_schema",
        "value_schema",
        "policy",
        "vocabulary",
        "geometry_resource",
        "static_asset",
        "fact_producer_catalog"
      ],
      "title": "ArtifactKind",
      "type": "string"
    },
    "BundlePayloadPath": {
      "maxLength": 512,
      "pattern": "^(?!(?:manifest|checksums)\\.json$(?![\\s\\S]))(?!.*(?:^|/)[.]{1,2}(?:/|$))[^\\\\\\x00-\\x1f\\x7f-\\x9f:?#/]+(?:/[^\\\\\\x00-\\x1f\\x7f-\\x9f:?#/]+)*$(?![\\s\\S])",
      "type": "string"
    },
    "CapabilityFamily": {
      "enum": [
        "model_deployment",
        "tool_implementation",
        "system_fact_producer",
        "context_derivation"
      ],
      "title": "CapabilityFamily",
      "type": "string"
    },
    "CapabilityFeature": {
      "enum": [
        "rgb_image",
        "typed_context",
        "structured_output",
        "original_xyxy",
        "mask_output",
        "geometry_output",
        "ocr_text"
      ],
      "title": "CapabilityFeature",
      "type": "string"
    },
    "CapabilityRequirements": {
      "items": {
        "$ref": "#/$defs/ExternalCapabilityRequirement"
      },
      "maxItems": 1024,
      "type": "array"
    },
    "CompatibilityRequirement": {
      "additionalProperties": false,
      "properties": {
        "maximum_runtime_version_exclusive": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Maximum Runtime Version Exclusive",
          "type": "string"
        },
        "minimum_runtime_version_inclusive": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Minimum Runtime Version Inclusive",
          "type": "string"
        }
      },
      "required": [
        "minimum_runtime_version_inclusive",
        "maximum_runtime_version_exclusive"
      ],
      "title": "CompatibilityRequirement",
      "type": "object"
    },
    "ContentRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_kind",
        "artifact_id",
        "version",
        "digest"
      ],
      "title": "ContentRef",
      "type": "object"
    },
    "DetachedSignatureRef": {
      "additionalProperties": false,
      "description": "Pin opaque signature evidence without declaring cryptographic trust.",
      "properties": {
        "sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "signature_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Signature Id",
          "type": "string"
        },
        "signature_registry_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Signature Registry Id",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "signature_id",
        "version",
        "sha256",
        "signature_registry_id"
      ],
      "title": "DetachedSignatureRef",
      "type": "object"
    },
    "ExternalCapabilityRequirement": {
      "additionalProperties": false,
      "properties": {
        "allowed_implementation_versions": {
          "items": {
            "maxLength": 128,
            "minLength": 5,
            "not": {
              "pattern": "\\s"
            },
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
            "type": "string"
          },
          "maxItems": 1024,
          "minItems": 1,
          "title": "Allowed Implementation Versions",
          "type": "array",
          "uniqueItems": true
        },
        "capability_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Capability Id",
          "type": "string"
        },
        "contract_version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Contract Version",
          "type": "string"
        },
        "evaluation_ref": {
          "$ref": "#/$defs/AbsentOptional_ReviewReportRef_"
        },
        "family": {
          "$ref": "#/$defs/CapabilityFamily"
        },
        "required_features": {
          "items": {
            "$ref": "#/$defs/CapabilityFeature"
          },
          "maxItems": 7,
          "title": "Required Features",
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "family",
        "capability_id",
        "contract_version",
        "allowed_implementation_versions",
        "required_features"
      ],
      "title": "ExternalCapabilityRequirement",
      "type": "object"
    },
    "IntegrityEnvelope": {
      "additionalProperties": false,
      "properties": {
        "canonicalization_id": {
          "const": "jcs-sha256-v1",
          "title": "Canonicalization Id",
          "type": "string"
        },
        "hash_algorithm": {
          "const": "sha256",
          "title": "Hash Algorithm",
          "type": "string"
        },
        "root_digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Root Digest",
          "type": "string"
        },
        "signatures": {
          "items": {
            "$ref": "#/$defs/DetachedSignatureRef"
          },
          "maxItems": 64,
          "title": "Signatures",
          "type": "array"
        }
      },
      "required": [
        "hash_algorithm",
        "canonicalization_id",
        "root_digest",
        "signatures"
      ],
      "title": "IntegrityEnvelope",
      "type": "object"
    },
    "JsonPointer": {
      "maxLength": 1024,
      "pattern": "^(?:/(?:[^~/]|~[01])*)*$(?![\\s\\S])",
      "type": "string"
    },
    "ReviewReportRef": {
      "additionalProperties": false,
      "properties": {
        "report_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Report Id",
          "type": "string"
        },
        "review_registry_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Review Registry Id",
          "type": "string"
        },
        "sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "report_id",
        "version",
        "sha256",
        "review_registry_id"
      ],
      "title": "ReviewReportRef",
      "type": "object"
    },
    "SourceArtifactRef": {
      "additionalProperties": false,
      "description": "External source provenance, scoped by SourceProvenance.source_system.",
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "version",
        "digest"
      ],
      "title": "SourceArtifactRef",
      "type": "object"
    },
    "SourceProvenance": {
      "additionalProperties": false,
      "properties": {
        "artifacts": {
          "items": {
            "$ref": "#/$defs/SourceArtifactRef"
          },
          "maxItems": 16384,
          "title": "Artifacts",
          "type": "array"
        },
        "source_system": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Source System",
          "type": "string"
        }
      },
      "required": [
        "source_system",
        "artifacts"
      ],
      "title": "SourceProvenance",
      "type": "object"
    },
    "UTCDateTime": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])[Tt](?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:[Zz]|\\+00:00)$(?![\\s\\S])",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/$defs/ArtifactInventoryEntry"
      },
      "maxItems": 16384,
      "title": "Artifacts",
      "type": "array"
    },
    "bundle_id": {
      "maxLength": 128,
      "minLength": 1,
      "not": {
        "pattern": "\\s"
      },
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
      "title": "Bundle Id",
      "type": "string"
    },
    "bundle_version": {
      "maxLength": 128,
      "minLength": 5,
      "not": {
        "pattern": "\\s"
      },
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "title": "Bundle Version",
      "type": "string"
    },
    "compatibility": {
      "$ref": "#/$defs/CompatibilityRequirement"
    },
    "compiler_version": {
      "maxLength": 128,
      "minLength": 5,
      "not": {
        "pattern": "\\s"
      },
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "title": "Compiler Version",
      "type": "string"
    },
    "created_at": {
      "$ref": "#/$defs/UTCDateTime"
    },
    "format": {
      "const": "jimu.runtime-bundle",
      "title": "Format",
      "type": "string"
    },
    "integrity": {
      "$ref": "#/$defs/IntegrityEnvelope"
    },
    "required_capabilities": {
      "$ref": "#/$defs/CapabilityRequirements"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/SourceProvenance"
    }
  },
  "required": [
    "format",
    "schema_version",
    "bundle_id",
    "bundle_version",
    "compiler_version",
    "created_at",
    "source",
    "artifacts",
    "compatibility",
    "required_capabilities",
    "integrity"
  ],
  "title": "BundleManifest",
  "type": "object"
}
