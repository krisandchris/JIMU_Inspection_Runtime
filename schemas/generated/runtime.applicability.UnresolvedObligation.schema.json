{
  "$defs": {
    "AbsentOptional_ApplicabilityAncestorRef_": {
      "$ref": "#/$defs/ApplicabilityAncestorRef"
    },
    "AbsentOptional_ObjectRef_": {
      "$ref": "#/$defs/ObjectRef"
    },
    "AbsentOptional_RuleSetContentRef_": {
      "$ref": "#/$defs/RuleSetContentRef"
    },
    "ApplicabilityAncestorRef": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProfileEligibilityEvaluationRef"
        },
        {
          "$ref": "#/$defs/RuleSetApplicabilityEvaluationRef"
        }
      ]
    },
    "ApplicabilityDiagnosticRef": {
      "additionalProperties": false,
      "description": "Location of a diagnostic in an evaluated level of a persisted trace.",
      "properties": {
        "issue_index": {
          "$ref": "#/$defs/IssueIndex"
        },
        "level": {
          "$ref": "#/$defs/ApplicabilityLevel"
        },
        "trace_ref": {
          "$ref": "#/$defs/ApplicabilityTraceRef"
        }
      },
      "required": [
        "trace_ref",
        "level",
        "issue_index"
      ],
      "title": "ApplicabilityDiagnosticRef",
      "type": "object"
    },
    "ApplicabilityLevel": {
      "enum": [
        "profile",
        "rule_set",
        "rule"
      ],
      "title": "ApplicabilityLevel",
      "type": "string"
    },
    "ApplicabilityTargetRef": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProfileContentRef"
        },
        {
          "$ref": "#/$defs/RuleSetContentRef"
        },
        {
          "$ref": "#/$defs/RuleContentRef"
        }
      ]
    },
    "ApplicabilityTraceRef": {
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Record Id",
          "type": "string"
        },
        "record_kind": {
          "const": "applicability_trace",
          "title": "Record Kind",
          "type": "string"
        }
      },
      "required": [
        "record_kind",
        "record_id"
      ],
      "title": "ApplicabilityTraceRef",
      "type": "object"
    },
    "IssueIndex": {
      "minimum": 0,
      "type": "integer"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Record Id",
          "type": "string"
        },
        "record_kind": {
          "const": "object",
          "title": "Record Kind",
          "type": "string"
        }
      },
      "required": [
        "record_kind",
        "record_id"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "ProfileContentRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_kind": {
          "const": "profile",
          "title": "Artifact Kind",
          "type": "string"
        },
        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_kind",
        "artifact_id",
        "version",
        "digest"
      ],
      "title": "ProfileContentRef",
      "type": "object"
    },
    "ProfileEligibilityEvaluationRef": {
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Record Id",
          "type": "string"
        },
        "record_kind": {
          "const": "profile_eligibility_evaluation",
          "title": "Record Kind",
          "type": "string"
        }
      },
      "required": [
        "record_kind",
        "record_id"
      ],
      "title": "ProfileEligibilityEvaluationRef",
      "type": "object"
    },
    "RuleContentRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_kind": {
          "const": "rule",
          "title": "Artifact Kind",
          "type": "string"
        },
        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_kind",
        "artifact_id",
        "version",
        "digest"
      ],
      "title": "RuleContentRef",
      "type": "object"
    },
    "RuleSetApplicabilityEvaluationRef": {
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Record Id",
          "type": "string"
        },
        "record_kind": {
          "const": "rule_set_applicability_evaluation",
          "title": "Record Kind",
          "type": "string"
        }
      },
      "required": [
        "record_kind",
        "record_id"
      ],
      "title": "RuleSetApplicabilityEvaluationRef",
      "type": "object"
    },
    "RuleSetContentRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_kind": {
          "const": "rule_set",
          "title": "Artifact Kind",
          "type": "string"
        },
        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_kind",
        "artifact_id",
        "version",
        "digest"
      ],
      "title": "RuleSetContentRef",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "else": {
        "properties": {
          "rule_set_ref": false
        }
      },
      "if": {
        "properties": {
          "scope": {
            "const": "rule"
          }
        }
      },
      "then": {
        "required": [
          "rule_set_ref"
        ]
      }
    },
    {
      "else": {
        "properties": {
          "decisive_ancestor_ref": false
        }
      },
      "if": {
        "properties": {
          "reason_code": {
            "const": "ancestor_unresolved"
          }
        }
      },
      "then": {
        "properties": {
          "scope": {
            "not": {
              "const": "profile"
            }
          }
        },
        "required": [
          "decisive_ancestor_ref"
        ]
      }
    }
  ],
  "properties": {
    "applicability_trace_ref": {
      "$ref": "#/$defs/ApplicabilityTraceRef"
    },
    "decisive_ancestor_ref": {
      "$ref": "#/$defs/AbsentOptional_ApplicabilityAncestorRef_"
    },
    "diagnostic_refs": {
      "items": {
        "$ref": "#/$defs/ApplicabilityDiagnosticRef"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Diagnostic Refs",
      "type": "array",
      "uniqueItems": true
    },
    "execution_id": {
      "maxLength": 128,
      "minLength": 1,
      "not": {
        "pattern": "\\s"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Execution Id",
      "type": "string"
    },
    "object_ref": {
      "$ref": "#/$defs/AbsentOptional_ObjectRef_"
    },
    "obligation_id": {
      "maxLength": 128,
      "minLength": 1,
      "not": {
        "pattern": "\\s"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Obligation Id",
      "type": "string"
    },
    "profile_ref": {
      "$ref": "#/$defs/ProfileContentRef"
    },
    "reason_code": {
      "enum": [
        "metadata_unknown",
        "metadata_invalid",
        "ancestor_unresolved"
      ],
      "title": "Reason Code",
      "type": "string"
    },
    "rule_set_ref": {
      "$ref": "#/$defs/AbsentOptional_RuleSetContentRef_"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/ApplicabilityLevel"
    },
    "target_ref": {
      "$ref": "#/$defs/ApplicabilityTargetRef"
    }
  },
  "required": [
    "schema_version",
    "obligation_id",
    "execution_id",
    "profile_ref",
    "scope",
    "target_ref",
    "applicability_trace_ref",
    "reason_code",
    "diagnostic_refs"
  ],
  "title": "UnresolvedObligation",
  "type": "object"
}
