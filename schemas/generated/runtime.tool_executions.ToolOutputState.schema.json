{
  "$defs": {
    "Description": {
      "maxLength": 4096,
      "minLength": 1,
      "pattern": "\\S",
      "type": "string"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Record Id",
          "type": "string"
        },
        "record_kind": {
          "const": "evidence",
          "title": "Record Kind",
          "type": "string"
        }
      },
      "required": [
        "record_kind",
        "record_id"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "EvidenceRefs": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "maxItems": 1024,
      "type": "array",
      "uniqueItems": true
    },
    "FactReason": {
      "additionalProperties": false,
      "properties": {
        "diagnostic_refs": {
          "$ref": "#/$defs/EvidenceRefs"
        },
        "message": {
          "$ref": "#/$defs/Description"
        },
        "reason_code": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Reason Code",
          "type": "string"
        }
      },
      "required": [
        "reason_code",
        "message",
        "diagnostic_refs"
      ],
      "title": "FactReason",
      "type": "object"
    },
    "KnownToolOutputState": {
      "additionalProperties": false,
      "properties": {
        "evidence_refs": {
          "$ref": "#/$defs/EvidenceRefs"
        },
        "fact_status": {
          "const": "known",
          "title": "Fact Status",
          "type": "string"
        },
        "output_name": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Output Name",
          "type": "string"
        }
      },
      "required": [
        "output_name",
        "evidence_refs",
        "fact_status"
      ],
      "title": "KnownToolOutputState",
      "type": "object"
    },
    "NonKnownToolOutputState": {
      "additionalProperties": false,
      "properties": {
        "evidence_refs": {
          "$ref": "#/$defs/EvidenceRefs"
        },
        "fact_status": {
          "enum": [
            "unknown",
            "error",
            "not_applicable",
            "not_evaluated"
          ],
          "title": "Fact Status",
          "type": "string"
        },
        "output_name": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Output Name",
          "type": "string"
        },
        "reason": {
          "$ref": "#/$defs/FactReason"
        }
      },
      "required": [
        "output_name",
        "evidence_refs",
        "fact_status",
        "reason"
      ],
      "title": "NonKnownToolOutputState",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "discriminator": {
    "mapping": {
      "error": "#/$defs/NonKnownToolOutputState",
      "known": "#/$defs/KnownToolOutputState",
      "not_applicable": "#/$defs/NonKnownToolOutputState",
      "not_evaluated": "#/$defs/NonKnownToolOutputState",
      "unknown": "#/$defs/NonKnownToolOutputState"
    },
    "propertyName": "fact_status"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/KnownToolOutputState"
    },
    {
      "$ref": "#/$defs/NonKnownToolOutputState"
    }
  ]
}
