{
  "$defs": {
    "AbsentOptional_ObjectRef_": {
      "$ref": "#/$defs/ObjectRef"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Record Id",
          "type": "string"
        },
        "record_kind": {
          "const": "object",
          "title": "Record Kind",
          "type": "string"
        }
      },
      "required": [
        "record_kind",
        "record_id"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "ProfileObligationTarget": {
      "additionalProperties": false,
      "properties": {
        "scope": {
          "const": "profile",
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "scope"
      ],
      "title": "ProfileObligationTarget",
      "type": "object"
    },
    "RuleContentRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_kind": {
          "const": "rule",
          "title": "Artifact Kind",
          "type": "string"
        },
        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_kind",
        "artifact_id",
        "version",
        "digest"
      ],
      "title": "RuleContentRef",
      "type": "object"
    },
    "RuleObligationTarget": {
      "additionalProperties": false,
      "properties": {
        "object_ref": {
          "$ref": "#/$defs/AbsentOptional_ObjectRef_"
        },
        "rule_ref": {
          "$ref": "#/$defs/RuleContentRef"
        },
        "rule_set_ref": {
          "$ref": "#/$defs/RuleSetContentRef"
        },
        "scope": {
          "const": "rule",
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "rule_set_ref",
        "scope",
        "rule_ref"
      ],
      "title": "RuleObligationTarget",
      "type": "object"
    },
    "RuleSetContentRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_kind": {
          "const": "rule_set",
          "title": "Artifact Kind",
          "type": "string"
        },
        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_kind",
        "artifact_id",
        "version",
        "digest"
      ],
      "title": "RuleSetContentRef",
      "type": "object"
    },
    "RuleSetObligationTarget": {
      "additionalProperties": false,
      "properties": {
        "object_ref": {
          "$ref": "#/$defs/AbsentOptional_ObjectRef_"
        },
        "rule_set_ref": {
          "$ref": "#/$defs/RuleSetContentRef"
        },
        "scope": {
          "const": "rule_set",
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "rule_set_ref",
        "scope"
      ],
      "title": "RuleSetObligationTarget",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "discriminator": {
    "mapping": {
      "profile": "#/$defs/ProfileObligationTarget",
      "rule": "#/$defs/RuleObligationTarget",
      "rule_set": "#/$defs/RuleSetObligationTarget"
    },
    "propertyName": "scope"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/ProfileObligationTarget"
    },
    {
      "$ref": "#/$defs/RuleSetObligationTarget"
    },
    {
      "$ref": "#/$defs/RuleObligationTarget"
    }
  ]
}
