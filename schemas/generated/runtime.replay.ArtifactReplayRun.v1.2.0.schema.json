{
  "$defs": {
    "ArtifactReplayRequest": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "artifact",
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scoring_protocol": {
          "$ref": "#/$defs/ScoringProtocolPin"
        },
        "source": {
          "$ref": "#/$defs/ReplayExecutionSource"
        },
        "source_artifacts": {
          "$ref": "#/$defs/ReplayArtifacts"
        }
      },
      "required": [
        "schema_version",
        "kind",
        "source",
        "scoring_protocol",
        "source_artifacts"
      ],
      "title": "ArtifactReplayRequest",
      "type": "object"
    },
    "CapabilityFeature": {
      "enum": [
        "rgb_image",
        "typed_context",
        "structured_output",
        "original_xyxy",
        "mask_output",
        "geometry_output",
        "ocr_text"
      ],
      "title": "CapabilityFeature",
      "type": "string"
    },
    "ConfiguredModelPin": {
      "additionalProperties": false,
      "properties": {
        "binding_ref": {
          "$ref": "#/$defs/ModelBindingContentRef"
        },
        "deployments": {
          "items": {
            "$ref": "#/$defs/DeploymentRequirement"
          },
          "maxItems": 1024,
          "minItems": 1,
          "title": "Deployments",
          "type": "array"
        },
        "fallback_policy_ref": {
          "$ref": "#/$defs/PolicyContentRef"
        },
        "primary_deployment_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Primary Deployment Id",
          "type": "string"
        },
        "provider_policy_ref": {
          "$ref": "#/$defs/PolicyContentRef"
        }
      },
      "required": [
        "binding_ref",
        "provider_policy_ref",
        "fallback_policy_ref",
        "primary_deployment_id",
        "deployments"
      ],
      "title": "ConfiguredModelPin",
      "type": "object"
    },
    "ConfiguredToolPin": {
      "additionalProperties": false,
      "properties": {
        "implementation_version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Implementation Version",
          "type": "string"
        },
        "tool_ref": {
          "$ref": "#/$defs/ToolContentRef"
        }
      },
      "required": [
        "tool_ref",
        "implementation_version"
      ],
      "title": "ConfiguredToolPin",
      "type": "object"
    },
    "DeploymentRequirement": {
      "additionalProperties": false,
      "properties": {
        "actual_version_constraints": {
          "$ref": "#/$defs/VersionConstraint"
        },
        "deployment_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Deployment Id",
          "type": "string"
        },
        "logical_model_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Logical Model Id",
          "type": "string"
        },
        "provider_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Provider Id",
          "type": "string"
        },
        "provider_kind": {
          "enum": [
            "remote",
            "local"
          ],
          "title": "Provider Kind",
          "type": "string"
        },
        "required_features": {
          "items": {
            "$ref": "#/$defs/CapabilityFeature"
          },
          "maxItems": 7,
          "title": "Required Features",
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "provider_id",
        "deployment_id",
        "logical_model_id",
        "provider_kind",
        "actual_version_constraints",
        "required_features"
      ],
      "title": "DeploymentRequirement",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Record Id",
          "type": "string"
        },
        "record_kind": {
          "const": "evidence",
          "title": "Record Kind",
          "type": "string"
        }
      },
      "required": [
        "record_kind",
        "record_id"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "ExecutionPins": {
      "additionalProperties": false,
      "properties": {
        "bundle_digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Bundle Digest",
          "type": "string"
        },
        "input_digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Digest",
          "type": "string"
        },
        "model_pins": {
          "items": {
            "$ref": "#/$defs/ConfiguredModelPin"
          },
          "maxItems": 1024,
          "title": "Model Pins",
          "type": "array"
        },
        "release_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Release Id",
          "type": "string"
        },
        "runtime_version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Runtime Version",
          "type": "string"
        },
        "tool_pins": {
          "items": {
            "$ref": "#/$defs/ConfiguredToolPin"
          },
          "maxItems": 1024,
          "title": "Tool Pins",
          "type": "array"
        },
        "workflow_version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Workflow Version",
          "type": "string"
        }
      },
      "required": [
        "release_id",
        "bundle_digest",
        "runtime_version",
        "workflow_version",
        "model_pins",
        "tool_pins",
        "input_digest"
      ],
      "title": "ExecutionPins",
      "type": "object"
    },
    "ExecutionRef": {
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Record Id",
          "type": "string"
        },
        "record_kind": {
          "const": "execution",
          "title": "Record Kind",
          "type": "string"
        }
      },
      "required": [
        "record_kind",
        "record_id"
      ],
      "title": "ExecutionRef",
      "type": "object"
    },
    "ModelBindingContentRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_kind": {
          "const": "model_binding",
          "title": "Artifact Kind",
          "type": "string"
        },
        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_kind",
        "artifact_id",
        "version",
        "digest"
      ],
      "title": "ModelBindingContentRef",
      "type": "object"
    },
    "PinnedRuntimeInput": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "ref": {
          "$ref": "#/$defs/RuntimeRecordRef"
        }
      },
      "required": [
        "ref",
        "digest"
      ],
      "title": "PinnedRuntimeInput",
      "type": "object"
    },
    "PolicyContentRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_kind": {
          "const": "policy",
          "title": "Artifact Kind",
          "type": "string"
        },
        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_kind",
        "artifact_id",
        "version",
        "digest"
      ],
      "title": "PolicyContentRef",
      "type": "object"
    },
    "ReplayArtifacts": {
      "items": {
        "$ref": "#/$defs/PinnedRuntimeInput"
      },
      "maxItems": 1024,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "ReplayExecutionSource": {
      "additionalProperties": false,
      "properties": {
        "execution_ref": {
          "$ref": "#/$defs/ExecutionRef"
        },
        "pins": {
          "$ref": "#/$defs/ExecutionPins"
        },
        "task_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "execution_ref",
        "task_id",
        "pins"
      ],
      "title": "ReplayExecutionSource",
      "type": "object"
    },
    "ReplayScoringEvidence": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "ref": {
          "$ref": "#/$defs/EvidenceRef"
        }
      },
      "required": [
        "ref",
        "digest"
      ],
      "title": "ReplayScoringEvidence",
      "type": "object"
    },
    "RuntimeRecordKind": {
      "enum": [
        "task",
        "execution",
        "node_run",
        "attempt",
        "object",
        "fact",
        "evidence",
        "tool_execution",
        "model_invocation",
        "decision",
        "release",
        "activation",
        "context_snapshot",
        "grounding_record",
        "question_selection_record",
        "authoritative_result_selection",
        "execution_coverage",
        "profile_eligibility_evaluation",
        "rule_set_applicability_evaluation",
        "rule_applicability_evaluation",
        "applicability_trace",
        "unresolved_obligation",
        "replay_run",
        "execution_event",
        "candidate_prediction",
        "observation_batch",
        "tool_plan_run_summary"
      ],
      "title": "RuntimeRecordKind",
      "type": "string"
    },
    "RuntimeRecordRef": {
      "additionalProperties": false,
      "description": "Record identity, interpreted within its owning root's pinned scope.\n\nIn particular an Object ID is Execution-local: this nested ref must not be\nresolved globally or reused across Executions. Scope/existence checks belong\nto the later owning record contracts, not a hidden resolver in this model.",
      "properties": {
        "record_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Record Id",
          "type": "string"
        },
        "record_kind": {
          "$ref": "#/$defs/RuntimeRecordKind"
        }
      },
      "required": [
        "record_kind",
        "record_id"
      ],
      "title": "RuntimeRecordRef",
      "type": "object"
    },
    "ScoringProtocolPin": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "protocol_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Protocol Id",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "protocol_id",
        "version",
        "digest"
      ],
      "title": "ScoringProtocolPin",
      "type": "object"
    },
    "ToolContentRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_kind": {
          "const": "tool",
          "title": "Artifact Kind",
          "type": "string"
        },
        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_kind",
        "artifact_id",
        "version",
        "digest"
      ],
      "title": "ToolContentRef",
      "type": "object"
    },
    "UTCDateTime": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])[Tt](?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:[Zz]|\\+00:00)$(?![\\s\\S])",
      "type": "string"
    },
    "VersionConstraint": {
      "additionalProperties": false,
      "properties": {
        "allowed_deployment_versions": {
          "items": {
            "maxLength": 128,
            "minLength": 5,
            "not": {
              "pattern": "\\s"
            },
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
            "type": "string"
          },
          "maxItems": 1024,
          "minItems": 1,
          "title": "Allowed Deployment Versions",
          "type": "array",
          "uniqueItems": true
        },
        "allowed_model_versions": {
          "items": {
            "maxLength": 128,
            "minLength": 5,
            "not": {
              "pattern": "\\s"
            },
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
            "type": "string"
          },
          "maxItems": 1024,
          "minItems": 1,
          "title": "Allowed Model Versions",
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "allowed_deployment_versions",
        "allowed_model_versions"
      ],
      "title": "VersionConstraint",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "artifact",
      "title": "Kind",
      "type": "string"
    },
    "recorded_at": {
      "$ref": "#/$defs/UTCDateTime"
    },
    "replay_run_id": {
      "maxLength": 128,
      "minLength": 1,
      "not": {
        "pattern": "\\s"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Replay Run Id",
      "type": "string"
    },
    "request": {
      "$ref": "#/$defs/ArtifactReplayRequest"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scoring_evidence": {
      "$ref": "#/$defs/ReplayScoringEvidence"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "replay_run_id",
    "request",
    "scoring_evidence",
    "recorded_at"
  ],
  "title": "ArtifactReplayRun",
  "type": "object"
}
