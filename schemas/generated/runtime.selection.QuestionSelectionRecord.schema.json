        }
      },
      "required": [
        "mode",
        "proposal_binding_ref",
        "additional_resource_requirements_ref",
        "max_additional_invocations_per_execution"
      ],
      "title": "AdditionalSelectionCallPolicy",
      "type": "object"
    },
    "AllDeclaredSelectionRecord": {
      "additionalProperties": false,
      "properties": {
        "attempt_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Attempt Id",
          "type": "string"
        },
        "configured_question_refs": {
          "$ref": "#/$defs/QuestionSelectionRefs",
          "minLength": 1
        },
        "context_snapshot_digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Context Snapshot Digest",
          "type": "string"
        },
        "context_snapshot_ref": {
          "$ref": "#/$defs/ContextSnapshotRef"
        },
        "created_at": {
          "$ref": "#/$defs/UTCDateTime"
