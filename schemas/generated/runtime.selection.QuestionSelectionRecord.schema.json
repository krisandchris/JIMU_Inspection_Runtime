          "$ref": "#/$defs/QuestionSelectionRefs"
        },
        "selection_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Selection Id",
          "type": "string"
        },
        "validation_issues": {
          "items": {
            "$ref": "#/$defs/ValidationIssue"
          },
          "maxItems": 1024,
          "title": "Validation Issues",
          "type": "array"
