    "FallbackSelectionEvidence": {
      "discriminator": {
        "mapping": {
          "False": "#/$defs/UndispatchedSelectionFailure",
          "True": "#/$defs/DispatchedSelectionFailure"
        },
        "propertyName": "dispatched"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/UndispatchedSelectionFailure"
