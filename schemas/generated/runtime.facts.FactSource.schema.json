{
  "$defs": {
    "AbsentOptional_ReviewReportRef_": {
      "$ref": "#/$defs/ReviewReportRef"
    },
    "CapabilityFeature": {
      "enum": [
        "rgb_image",
        "typed_context",
        "structured_output",
        "original_xyxy",
        "mask_output",
        "geometry_output",
        "ocr_text"
      ],
      "title": "CapabilityFeature",
      "type": "string"
    },
    "ExecutionEventRef": {
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Record Id",
          "type": "string"
        },
        "record_kind": {
          "const": "execution_event",
          "title": "Record Kind",
          "type": "string"
        }
      },
      "required": [
        "record_kind",
        "record_id"
      ],
      "title": "ExecutionEventRef",
      "type": "object"
    },
    "ModelInvocationRef": {
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Record Id",
          "type": "string"
        },
        "record_kind": {
          "const": "model_invocation",
          "title": "Record Kind",
          "type": "string"
        }
      },
      "required": [
        "record_kind",
        "record_id"
      ],
      "title": "ModelInvocationRef",
      "type": "object"
    },
    "ObservationBatchRef": {
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Record Id",
          "type": "string"
        },
        "record_kind": {
          "const": "observation_batch",
          "title": "Record Kind",
          "type": "string"
        }
      },
      "required": [
        "record_kind",
        "record_id"
      ],
      "title": "ObservationBatchRef",
      "type": "object"
    },
    "QuestionContentRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_kind": {
          "const": "question",
          "title": "Artifact Kind",
          "type": "string"
        },
        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_kind",
        "artifact_id",
        "version",
        "digest"
      ],
      "title": "QuestionContentRef",
      "type": "object"
    },
    "QuestionFactSource": {
      "additionalProperties": false,
      "properties": {
        "model_invocation_ref": {
          "$ref": "#/$defs/ModelInvocationRef"
        },
        "observation_batch_ref": {
          "$ref": "#/$defs/ObservationBatchRef"
        },
        "question_ref": {
          "$ref": "#/$defs/QuestionContentRef"
        },
        "source_kind": {
          "const": "vlm_question",
          "title": "Source Kind",
          "type": "string"
        }
      },
      "required": [
        "source_kind",
        "question_ref",
        "observation_batch_ref",
        "model_invocation_ref"
      ],
      "title": "QuestionFactSource",
      "type": "object"
    },
    "ReviewReportRef": {
      "additionalProperties": false,
      "properties": {
        "report_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Report Id",
          "type": "string"
        },
        "review_registry_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Review Registry Id",
          "type": "string"
        },
        "sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "report_id",
        "version",
        "sha256",
        "review_registry_id"
      ],
      "title": "ReviewReportRef",
      "type": "object"
    },
    "SystemFactSource": {
      "additionalProperties": false,
      "properties": {
        "output_name": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Output Name",
          "type": "string"
        },
        "requirement": {
          "$ref": "#/$defs/SystemProducerRequirement"
        },
        "source_kind": {
          "const": "system",
          "title": "Source Kind",
          "type": "string"
        },
        "system_output_ref": {
          "$ref": "#/$defs/ExecutionEventRef"
        }
      },
      "required": [
        "source_kind",
        "requirement",
        "system_output_ref",
        "output_name"
      ],
      "title": "SystemFactSource",
      "type": "object"
    },
    "SystemProducerRequirement": {
      "additionalProperties": false,
      "properties": {
        "allowed_implementation_versions": {
          "items": {
            "maxLength": 128,
            "minLength": 5,
            "not": {
              "pattern": "\\s"
            },
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
            "type": "string"
          },
          "maxItems": 1024,
          "minItems": 1,
          "title": "Allowed Implementation Versions",
          "type": "array",
          "uniqueItems": true
        },
        "capability_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Capability Id",
          "type": "string"
        },
        "contract_version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Contract Version",
          "type": "string"
        },
        "evaluation_ref": {
          "$ref": "#/$defs/AbsentOptional_ReviewReportRef_"
        },
        "family": {
          "const": "system_fact_producer",
          "title": "Family",
          "type": "string"
        },
        "required_features": {
          "items": {
            "$ref": "#/$defs/CapabilityFeature"
          },
          "maxItems": 7,
          "title": "Required Features",
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "family",
        "capability_id",
        "contract_version",
        "allowed_implementation_versions",
        "required_features"
      ],
      "title": "SystemProducerRequirement",
      "type": "object"
    },
    "ToolContentRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_kind": {
          "const": "tool",
          "title": "Artifact Kind",
          "type": "string"
        },
        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_kind",
        "artifact_id",
        "version",
        "digest"
      ],
      "title": "ToolContentRef",
      "type": "object"
    },
    "ToolExecutionRef": {
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Record Id",
          "type": "string"
        },
        "record_kind": {
          "const": "tool_execution",
          "title": "Record Kind",
          "type": "string"
        }
      },
      "required": [
        "record_kind",
        "record_id"
      ],
      "title": "ToolExecutionRef",
      "type": "object"
    },
    "ToolFactSource": {
      "additionalProperties": false,
      "properties": {
        "output_name": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Output Name",
          "type": "string"
        },
        "source_kind": {
          "const": "tool",
          "title": "Source Kind",
          "type": "string"
        },
        "step_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Step Id",
          "type": "string"
        },
        "tool_execution_ref": {
          "$ref": "#/$defs/ToolExecutionRef"
        },
        "tool_plan_ref": {
          "$ref": "#/$defs/ToolPlanContentRef"
        },
        "tool_ref": {
          "$ref": "#/$defs/ToolContentRef"
        }
      },
      "required": [
        "source_kind",
        "tool_execution_ref",
        "tool_plan_ref",
        "step_id",
        "tool_ref",
        "output_name"
      ],
      "title": "ToolFactSource",
      "type": "object"
    },
    "ToolPlanContentRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_kind": {
          "const": "tool_plan",
          "title": "Artifact Kind",
          "type": "string"
        },
        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_kind",
        "artifact_id",
        "version",
        "digest"
      ],
      "title": "ToolPlanContentRef",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "discriminator": {
    "mapping": {
      "system": "#/$defs/SystemFactSource",
      "tool": "#/$defs/ToolFactSource",
      "vlm_question": "#/$defs/QuestionFactSource"
    },
    "propertyName": "source_kind"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/QuestionFactSource"
    },
    {
      "$ref": "#/$defs/ToolFactSource"
    },
    {
      "$ref": "#/$defs/SystemFactSource"
    }
  ]
}
