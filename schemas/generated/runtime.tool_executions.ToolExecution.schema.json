      "$ref": "#/$defs/UTCDateTime"
    },
    "status": {
      "enum": [
        "succeeded",
        "partial",
        "failed",
        "not_dispatched"
      ],
      "title": "Status",
      "type": "string"
    },
    "tool_execution_id": {
      "maxLength": 128,
      "minLength": 1,
      "not": {
        "pattern": "\\s"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Tool Execution Id",
      "type": "string"
    },
    "tool_ref": {
      "$ref": "#/$defs/ToolContentRef"
    },
    "trace_id": {
      "maxLength": 128,
      "minLength": 1,
      "not": {
        "pattern": "\\s"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Trace Id",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "tool_execution_id",
    "execution_id",
    "profile_ref",
    "tool_ref",
    "node_run_ref",
    "attempt_ref",
    "invocation_origin",
    "scope",
    "input_refs",
    "output_refs",
    "implementation_version_resolution",
    "status",
    "attempt_result",
    "started_at",
    "completed_at",
    "generated_fact_refs",
    "evidence_refs",
