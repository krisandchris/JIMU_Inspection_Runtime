{
  "$defs": {
    "TrueFlag": {
      "const": true,
      "type": "boolean"
    },
    "UnknownPolicy": {
      "additionalProperties": false,
      "properties": {
        "envelope_failure": {
          "const": "no_fact",
          "title": "Envelope Failure",
          "type": "string"
        },
        "insufficient_visibility": {
          "const": "unknown",
          "title": "Insufficient Visibility",
          "type": "string"
        },
        "item_validation_failure": {
          "const": "error",
          "title": "Item Validation Failure",
          "type": "string"
        },
        "non_known_value": {
          "const": "forbidden",
          "title": "Non Known Value",
          "type": "string"
        },
        "policy_kind": {
          "const": "unknown",
          "title": "Policy Kind",
          "type": "string"
        },
        "reason_required": {
          "$ref": "#/$defs/TrueFlag"
        },
        "transport_failure": {
          "const": "no_fact",
          "title": "Transport Failure",
          "type": "string"
        }
      },
      "required": [
        "policy_kind",
        "insufficient_visibility",
        "transport_failure",
        "envelope_failure",
        "item_validation_failure",
        "non_known_value",
        "reason_required"
      ],
      "title": "UnknownPolicy",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "policy": {
      "$ref": "#/$defs/UnknownPolicy"
    },
    "policy_id": {
      "maxLength": 128,
      "minLength": 1,
      "not": {
        "pattern": "\\s"
      },
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
      "title": "Policy Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "version": {
      "maxLength": 128,
      "minLength": 5,
      "not": {
        "pattern": "\\s"
      },
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "policy_id",
    "version",
    "policy"
  ],
  "title": "UnknownPolicyArtifact",
  "type": "object"
}
