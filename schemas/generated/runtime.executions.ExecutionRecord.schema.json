{
  "$defs": {
    "CapabilityFeature": {
      "enum": [
        "rgb_image",
        "typed_context",
        "structured_output",
        "original_xyxy",
        "mask_output",
        "geometry_output",
        "ocr_text"
      ],
      "title": "CapabilityFeature",
      "type": "string"
    },
    "ConfiguredModelPin": {
      "additionalProperties": false,
      "properties": {
        "binding_ref": {
          "$ref": "#/$defs/ModelBindingContentRef"
        },
        "deployments": {
          "items": {
            "$ref": "#/$defs/DeploymentRequirement"
          },
          "maxItems": 1024,
          "minItems": 1,
          "title": "Deployments",
          "type": "array"
        },
        "fallback_policy_ref": {
          "$ref": "#/$defs/PolicyContentRef"
        },
        "primary_deployment_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Primary Deployment Id",
          "type": "string"
        },
        "provider_policy_ref": {
          "$ref": "#/$defs/PolicyContentRef"
        }
      },
      "required": [
        "binding_ref",
        "provider_policy_ref",
        "fallback_policy_ref",
        "primary_deployment_id",
        "deployments"
      ],
      "title": "ConfiguredModelPin",
      "type": "object"
    },
    "ConfiguredToolPin": {
      "additionalProperties": false,
      "properties": {
        "implementation_version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Implementation Version",
          "type": "string"
        },
        "tool_ref": {
          "$ref": "#/$defs/ToolContentRef"
        }
      },
      "required": [
        "tool_ref",
        "implementation_version"
      ],
      "title": "ConfiguredToolPin",
      "type": "object"
    },
    "ContextSnapshotPin": {
      "additionalProperties": false,
      "properties": {
        "snapshot_digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Snapshot Digest",
          "type": "string"
        },
        "snapshot_ref": {
          "$ref": "#/$defs/ContextSnapshotRef"
        }
      },
      "required": [
        "snapshot_ref",
        "snapshot_digest"
      ],
      "title": "ContextSnapshotPin",
      "type": "object"
    },
    "ContextSnapshotRef": {
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Record Id",
          "type": "string"
        },
        "record_kind": {
          "const": "context_snapshot",
          "title": "Record Kind",
          "type": "string"
        }
      },
      "required": [
        "record_kind",
        "record_id"
      ],
      "title": "ContextSnapshotRef",
      "type": "object"
    },
    "DeploymentRequirement": {
      "additionalProperties": false,
      "properties": {
        "actual_version_constraints": {
          "$ref": "#/$defs/VersionConstraint"
        },
        "deployment_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Deployment Id",
          "type": "string"
        },
        "logical_model_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Logical Model Id",
          "type": "string"
        },
        "provider_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Provider Id",
          "type": "string"
        },
        "provider_kind": {
          "enum": [
            "remote",
            "local"
          ],
          "title": "Provider Kind",
          "type": "string"
        },
        "required_features": {
          "items": {
            "$ref": "#/$defs/CapabilityFeature"
          },
          "maxItems": 7,
          "title": "Required Features",
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "provider_id",
        "deployment_id",
        "logical_model_id",
        "provider_kind",
        "actual_version_constraints",
        "required_features"
      ],
      "title": "DeploymentRequirement",
      "type": "object"
    },
    "ExecutionPins": {
      "additionalProperties": false,
      "properties": {
        "bundle_digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Bundle Digest",
          "type": "string"
        },
        "input_digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Digest",
          "type": "string"
        },
        "model_pins": {
          "items": {
            "$ref": "#/$defs/ConfiguredModelPin"
          },
          "maxItems": 1024,
          "title": "Model Pins",
          "type": "array"
        },
        "release_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Release Id",
          "type": "string"
        },
        "runtime_version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Runtime Version",
          "type": "string"
        },
        "tool_pins": {
          "items": {
            "$ref": "#/$defs/ConfiguredToolPin"
          },
          "maxItems": 1024,
          "title": "Tool Pins",
          "type": "array"
        },
        "workflow_version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Workflow Version",
          "type": "string"
        }
      },
      "required": [
        "release_id",
        "bundle_digest",
        "runtime_version",
        "workflow_version",
        "model_pins",
        "tool_pins",
        "input_digest"
      ],
      "title": "ExecutionPins",
      "type": "object"
    },
    "ExecutionStatus": {
      "enum": [
        "initialized",
        "running",
        "completed",
        "partial_failed",
        "failed",
        "cancelled"
      ],
      "title": "ExecutionStatus",
      "type": "string"
    },
    "ModelBindingContentRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_kind": {
          "const": "model_binding",
          "title": "Artifact Kind",
          "type": "string"
        },
        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_kind",
        "artifact_id",
        "version",
        "digest"
      ],
      "title": "ModelBindingContentRef",
      "type": "object"
    },
    "ModelInvocationRef": {
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Record Id",
          "type": "string"
        },
        "record_kind": {
          "const": "model_invocation",
          "title": "Record Kind",
          "type": "string"
        }
      },
      "required": [
        "record_kind",
        "record_id"
      ],
      "title": "ModelInvocationRef",
      "type": "object"
    },
    "PolicyContentRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_kind": {
          "const": "policy",
          "title": "Artifact Kind",
          "type": "string"
        },
        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_kind",
        "artifact_id",
        "version",
        "digest"
      ],
      "title": "PolicyContentRef",
      "type": "object"
    },
    "ToolContentRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_kind": {
          "const": "tool",
          "title": "Artifact Kind",
          "type": "string"
        },
        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_kind",
        "artifact_id",
        "version",
        "digest"
      ],
      "title": "ToolContentRef",
      "type": "object"
    },
    "TraceContext": {
      "additionalProperties": false,
      "properties": {
        "parent_span_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "not": {
                "pattern": "\\s"
              },
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Span Id"
        },
        "span_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "not": {
                "pattern": "\\s"
              },
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Span Id"
        },
        "trace_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Trace Id",
          "type": "string"
        }
      },
      "required": [
        "trace_id"
      ],
      "title": "TraceContext",
      "type": "object"
    },
    "UTCDateTime": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])[Tt](?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:[Zz]|\\+00:00)$(?![\\s\\S])",
      "type": "string"
    },
    "VersionConstraint": {
      "additionalProperties": false,
      "properties": {
        "allowed_deployment_versions": {
          "items": {
            "maxLength": 128,
            "minLength": 5,
            "not": {
              "pattern": "\\s"
            },
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
            "type": "string"
          },
          "maxItems": 1024,
          "minItems": 1,
          "title": "Allowed Deployment Versions",
          "type": "array",
          "uniqueItems": true
        },
        "allowed_model_versions": {
          "items": {
            "maxLength": 128,
            "minLength": 5,
            "not": {
              "pattern": "\\s"
            },
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
            "type": "string"
          },
          "maxItems": 1024,
          "minItems": 1,
          "title": "Allowed Model Versions",
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "allowed_deployment_versions",
        "allowed_model_versions"
      ],
      "title": "VersionConstraint",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "context_snapshot": {
      "anyOf": [
        {
          "$ref": "#/$defs/ContextSnapshotPin"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "created_at": {
      "$ref": "#/$defs/UTCDateTime"
    },
    "ended_at": {
      "anyOf": [
        {
          "$ref": "#/$defs/UTCDateTime"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "execution_id": {
      "maxLength": 128,
      "minLength": 1,
      "not": {
        "pattern": "\\s"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Execution Id",
      "type": "string"
    },
    "model_invocation_refs": {
      "items": {
        "$ref": "#/$defs/ModelInvocationRef"
      },
      "maxItems": 16384,
      "title": "Model Invocation Refs",
      "type": "array",
      "uniqueItems": true
    },
    "pins": {
      "$ref": "#/$defs/ExecutionPins"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "started_at": {
      "anyOf": [
        {
          "$ref": "#/$defs/UTCDateTime"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "status": {
      "$ref": "#/$defs/ExecutionStatus"
    },
    "task_id": {
      "maxLength": 128,
      "minLength": 1,
      "not": {
        "pattern": "\\s"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Task Id",
      "type": "string"
    },
    "trace": {
      "$ref": "#/$defs/TraceContext"
    }
  },
  "required": [
    "schema_version",
    "execution_id",
    "task_id",
    "pins",
    "trace",
    "status",
    "created_at",
    "model_invocation_refs"
  ],
  "title": "ExecutionRecord",
  "type": "object"
}
