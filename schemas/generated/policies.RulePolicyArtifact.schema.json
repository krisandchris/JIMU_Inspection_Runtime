{
  "$defs": {
    "RulePolicy": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "const": "unknown",
          "title": "Error",
          "type": "string"
        },
        "false_result": {
          "const": "no_violation",
          "title": "False Result",
          "type": "string"
        },
        "mandatory": {
          "title": "Mandatory",
          "type": "boolean"
        },
        "missing": {
          "const": "unknown",
          "title": "Missing",
          "type": "string"
        },
        "not_applicable": {
          "const": "unknown",
          "title": "Not Applicable",
          "type": "string"
        },
        "not_evaluated": {
          "const": "unknown",
          "title": "Not Evaluated",
          "type": "string"
        },
        "policy_kind": {
          "const": "rule",
          "title": "Policy Kind",
          "type": "string"
        },
        "required_guard": {
          "const": "block_unavailable",
          "title": "Required Guard",
          "type": "string"
        },
        "scan": {
          "const": "all_mandatory",
          "title": "Scan",
          "type": "string"
        },
        "true_result": {
          "const": "violation",
          "title": "True Result",
          "type": "string"
        },
        "unknown": {
          "const": "unknown",
          "title": "Unknown",
          "type": "string"
        },
        "unknown_result": {
          "const": "uncertain",
          "title": "Unknown Result",
          "type": "string"
        }
      },
      "required": [
        "policy_kind",
        "mandatory",
        "missing",
        "unknown",
        "error",
        "not_applicable",
        "not_evaluated",
        "required_guard",
        "scan",
        "true_result",
        "false_result",
        "unknown_result"
      ],
      "title": "RulePolicy",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "policy": {
      "$ref": "#/$defs/RulePolicy"
    },
    "policy_id": {
      "maxLength": 128,
      "minLength": 1,
      "not": {
        "pattern": "\\s"
      },
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
      "title": "Policy Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "version": {
      "maxLength": 128,
      "minLength": 5,
      "not": {
        "pattern": "\\s"
      },
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "policy_id",
    "version",
    "policy"
  ],
  "title": "RulePolicyArtifact",
  "type": "object"
}
