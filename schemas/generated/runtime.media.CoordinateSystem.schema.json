{
  "$defs": {
    "AssetDimensions": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "$ref": "#/$defs/PositiveBudget"
        },
        "width": {
          "$ref": "#/$defs/PositiveBudget"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "title": "AssetDimensions",
      "type": "object"
    },
    "PositiveBudget": {
      "maximum": 9223372036854775807,
      "minimum": 1,
      "type": "integer"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Image-plane pixel edges with origin at the top left and axes right/down.",
  "properties": {
    "coordinate_system_id": {
      "maxLength": 128,
      "minLength": 1,
      "not": {
        "pattern": "\\s"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Coordinate System Id",
      "type": "string"
    },
    "dimensions": {
      "$ref": "#/$defs/AssetDimensions"
    },
    "frame": {
      "enum": [
        "original_image",
        "derived_image"
      ],
      "title": "Frame",
      "type": "string"
    }
  },
  "required": [
    "coordinate_system_id",
    "frame",
    "dimensions"
  ],
  "title": "CoordinateSystem",
  "type": "object"
}
