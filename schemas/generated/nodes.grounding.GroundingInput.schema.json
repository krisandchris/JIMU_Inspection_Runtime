      "discriminator": {
        "mapping": {
          "model": "#/$defs/ModelGroundingBinding",
          "tool": "#/$defs/ToolGroundingBinding"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ModelGroundingBinding"
        },
        {
          "$ref": "#/$defs/ToolGroundingBinding"
        }
      ]
    },
    "GroundingInputBinding": {
      "additionalProperties": false,
      "if": {
        "properties": {
          "required": {
            "const": true
          }
        },
        "required": [
          "required"
        ]
      },
      "properties": {
        "on_missing": {
          "enum": [
            "block",
            "omit"
          ],
          "title": "On Missing",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "source": {
          "$ref": "#/$defs/GroundingInputSource"
        },
        "target": {
          "$ref": "#/$defs/FieldSelector"
        }
      },
      "required": [
        "source",
        "target",
        "required",
        "on_missing"
      ],
      "then": {
        "properties": {
          "on_missing": {
            "const": "block"
          }
        }
      },
      "title": "GroundingInputBinding",
      "type": "object"
    },
    "GroundingInputBindings": {
      "items": {
        "$ref": "#/$defs/GroundingInputBinding"
