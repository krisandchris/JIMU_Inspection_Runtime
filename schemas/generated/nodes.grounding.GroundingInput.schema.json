      "title": "RuntimeRecordRef",
      "type": "object"
    },
    "SchemaRef": {
      "additionalProperties": false,
      "description": "A constrained ContentRef, not a second schema identity system.",
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_kind": {
          "enum": [
            "fact_schema",
            "value_schema",
            "response_schema",
            "attribute_schema",
            "context_schema",
            "tool_input_schema",
            "tool_output_schema",
            "object_schema",
            "decision_schema"
          ],
          "title": "Artifact Kind",
          "type": "string"
        },
        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "schema_dialect": {
          "const": "https://json-schema.org/draft/2020-12/schema",
          "title": "Schema Dialect",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_kind",
        "artifact_id",
        "version",
        "digest",
        "schema_dialect"
      ],
      "title": "SchemaRef",
      "type": "object"
    },
    "ToolContentRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_kind": {
          "const": "tool",
          "title": "Artifact Kind",
          "type": "string"
        },
        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_kind",
        "artifact_id",
        "version",
        "digest"
      ],
      "title": "ToolContentRef",
      "type": "object"
    },
    "ToolGroundingBinding": {
      "additionalProperties": false,
      "properties": {
        "input_bindings": {
          "$ref": "#/$defs/AbsentOptional_GroundingInputBindings_"
        },
        "kind": {
          "const": "tool",
          "title": "Kind",
          "type": "string"
        },
        "tool_ref": {
          "$ref": "#/$defs/ToolContentRef"
        }
      },
      "required": [
        "kind",
        "tool_ref"
      ],
      "title": "ToolGroundingBinding",
      "type": "object"
    },
    "TraceContext": {
      "additionalProperties": false,
      "properties": {
        "parent_span_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "not": {
                "pattern": "\\s"
              },
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Span Id"
        },
        "span_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "not": {
                "pattern": "\\s"
              },
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Span Id"
        },
        "trace_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Trace Id",
          "type": "string"
        }
      },
      "required": [
        "trace_id"
      ],
      "title": "TraceContext",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "envelope": {
      "$ref": "#/$defs/NodeInputEnvelope"
    },
    "original_coordinate_system": {
      "$ref": "#/$defs/CoordinateSystem"
    },
    "original_media_ref": {
      "$ref": "#/$defs/MediaRef"
    },
    "profiles": {
      "items": {
        "$ref": "#/$defs/GroundingProfileInput"
      },
      "maxItems": 1024,
      "minItems": 1,
      "title": "Profiles",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "envelope",
    "original_media_ref",
    "original_coordinate_system",
    "profiles"
  ],
  "title": "GroundingInput",
  "type": "object"
}
