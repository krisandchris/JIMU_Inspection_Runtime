{
  "$defs": {
    "BooleanValue": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "bool",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "BooleanValue",
      "type": "object"
    },
    "BoundedString": {
      "maxLength": 4096,
      "type": "string"
    },
    "CameraRegistryProvenance": {
      "additionalProperties": false,
      "properties": {
        "camera_ref": {
          "$ref": "#/$defs/RegistryRecordRef"
        },
        "source": {
          "const": "camera_registry",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "source",
        "camera_ref"
      ],
      "title": "CameraRegistryProvenance",
      "type": "object"
    },
    "ContextFieldSelector": {
      "additionalProperties": false,
      "properties": {
        "field_path": {
          "items": {
            "$ref": "#/$defs/FieldName"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Field Path",
          "type": "array"
        },
        "schema_ref": {
          "$ref": "#/$defs/ContextSchemaRef"
        },
        "source": {
          "$ref": "#/$defs/ContextSource"
        }
      },
      "required": [
        "source",
        "schema_ref",
        "field_path"
      ],
      "title": "ContextFieldSelector",
      "type": "object"
    },
    "ContextSchemaRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_kind": {
          "const": "context_schema",
          "title": "Artifact Kind",
          "type": "string"
        },
        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "schema_dialect": {
          "const": "https://json-schema.org/draft/2020-12/schema",
          "title": "Schema Dialect",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_kind",
        "artifact_id",
        "version",
        "digest",
        "schema_dialect"
      ],
      "title": "ContextSchemaRef",
      "type": "object"
    },
    "ContextSource": {
      "enum": [
        "context_snapshot",
        "region_metadata",
        "profile_metadata"
      ],
      "title": "ContextSource",
      "type": "string"
    },
    "ContextValuePath": {
      "items": {
        "$ref": "#/$defs/FieldName"
      },
      "maxItems": 8,
      "minItems": 1,
      "type": "array"
    },
    "ContextValueProvenance": {
      "discriminator": {
        "mapping": {
          "camera_registry": "#/$defs/CameraRegistryProvenance",
          "declared_derivation": "#/$defs/DeclaredDerivationProvenance",
          "device_registry": "#/$defs/DeviceRegistryProvenance",
          "region_definition": "#/$defs/RegionDefinitionProvenance",
          "trusted_task_metadata": "#/$defs/TaskMetadataProvenance"
        },
        "propertyName": "source"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/TaskMetadataProvenance"
        },
        {
          "$ref": "#/$defs/DeviceRegistryProvenance"
        },
        {
          "$ref": "#/$defs/CameraRegistryProvenance"
        },
        {
          "$ref": "#/$defs/RegionDefinitionProvenance"
        },
        {
          "$ref": "#/$defs/DeclaredDerivationProvenance"
        }
      ]
    },
    "DeclaredDerivationProvenance": {
      "additionalProperties": false,
      "properties": {
        "derivation_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Derivation Id",
          "type": "string"
        },
        "implementation_digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Implementation Digest",
          "type": "string"
        },
        "implementation_version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Implementation Version",
          "type": "string"
        },
        "input_selectors": {
          "items": {
            "$ref": "#/$defs/ContextFieldSelector"
          },
          "maxItems": 64,
          "title": "Input Selectors",
          "type": "array"
        },
        "source": {
          "const": "declared_derivation",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "source",
        "derivation_id",
        "implementation_version",
        "implementation_digest",
        "input_selectors"
      ],
      "title": "DeclaredDerivationProvenance",
      "type": "object"
    },
    "DeviceRegistryProvenance": {
      "additionalProperties": false,
      "properties": {
        "device_ref": {
          "$ref": "#/$defs/RegistryRecordRef"
        },
        "source": {
          "const": "device_registry",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "source",
        "device_ref"
      ],
      "title": "DeviceRegistryProvenance",
      "type": "object"
    },
    "EnumValue": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "enum",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/BoundedString"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "EnumValue",
      "type": "object"
    },
    "FieldName": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "FiniteNumber": {
      "type": "number"
    },
    "IntegerValue": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "integer",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "IntegerValue",
      "type": "object"
    },
    "ListValue": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "list",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "items": {
            "$ref": "#/$defs/Value"
          },
          "maxItems": 256,
          "title": "Value",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "ListValue",
      "type": "object"
    },
    "NumberValue": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "number",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/FiniteNumber"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "NumberValue",
      "type": "object"
    },
    "RecordValue": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "record",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "additionalProperties": {
            "$ref": "#/$defs/Value"
          },
          "maxProperties": 64,
          "propertyNames": {
            "$ref": "#/$defs/FieldName"
          },
          "title": "Value",
          "type": "object"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "RecordValue",
      "type": "object"
    },
    "RegionContentRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_kind": {
          "const": "region",
          "title": "Artifact Kind",
          "type": "string"
        },
        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_kind",
        "artifact_id",
        "version",
        "digest"
      ],
      "title": "RegionContentRef",
      "type": "object"
    },
    "RegionDefinitionProvenance": {
      "additionalProperties": false,
      "properties": {
        "region_ref": {
          "$ref": "#/$defs/RegionContentRef"
        },
        "source": {
          "const": "region_definition",
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "source",
        "region_ref"
      ],
      "title": "RegionDefinitionProvenance",
      "type": "object"
    },
    "RegistryRecordRef": {
      "additionalProperties": false,
      "description": "Reference to exact externally supplied device or camera registry metadata.",
      "properties": {
        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "record_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Record Id",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "version",
        "digest"
      ],
      "title": "RegistryRecordRef",
      "type": "object"
    },
    "StringValue": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "string",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/BoundedString"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "StringValue",
      "type": "object"
    },
    "TaskMetadataProvenance": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "const": "trusted_task_metadata",
          "title": "Source",
          "type": "string"
        },
        "task_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "source",
        "task_id"
      ],
      "title": "TaskMetadataProvenance",
      "type": "object"
    },
    "Value": {
      "discriminator": {
        "mapping": {
          "bool": "#/$defs/BooleanValue",
          "enum": "#/$defs/EnumValue",
          "integer": "#/$defs/IntegerValue",
          "list": "#/$defs/ListValue",
          "number": "#/$defs/NumberValue",
          "record": "#/$defs/RecordValue",
          "string": "#/$defs/StringValue"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/BooleanValue"
        },
        {
          "$ref": "#/$defs/IntegerValue"
        },
        {
          "$ref": "#/$defs/NumberValue"
        },
        {
          "$ref": "#/$defs/StringValue"
        },
        {
          "$ref": "#/$defs/EnumValue"
        },
        {
          "$ref": "#/$defs/ListValue"
        },
        {
          "$ref": "#/$defs/RecordValue"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "field_path": {
      "$ref": "#/$defs/ContextValuePath"
    },
    "provenance": {
      "$ref": "#/$defs/ContextValueProvenance"
    },
    "value": {
      "$ref": "#/$defs/Value"
    }
  },
  "required": [
    "field_path",
    "value",
    "provenance"
  ],
  "title": "ContextValue",
  "type": "object"
}
