{
  "$defs": {
    "ArtifactKind": {
      "enum": [
        "entity",
        "region",
        "profile",
        "facet",
        "question",
        "tool",
        "tool_plan",
        "rule",
        "rule_set",
        "model_binding",
        "fact_schema",
        "prompt_template",
        "response_schema",
        "attribute_schema",
        "context_schema",
        "tool_input_schema",
        "tool_output_schema",
        "object_schema",
        "decision_schema",
        "value_schema",
        "policy",
        "vocabulary",
        "geometry_resource",
        "static_asset",
        "fact_producer_catalog"
      ],
      "title": "ArtifactKind",
      "type": "string"
    },
    "BooleanTypeDefinition": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "bool",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "BooleanTypeDefinition",
      "type": "object"
    },
    "ConditionInputDomain": {
      "enum": [
        "rule_applicability",
        "rule_condition",
        "tool_condition"
      ],
      "title": "ConditionInputDomain",
      "type": "string"
    },
    "ContentRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_kind",
        "artifact_id",
        "version",
        "digest"
      ],
      "title": "ContentRef",
      "type": "object"
    },
    "Description": {
      "maxLength": 4096,
      "minLength": 1,
      "pattern": "\\S",
      "type": "string"
    },
    "FailedTypeCheck": {
      "additionalProperties": false,
      "properties": {
        "input_domain": {
          "$ref": "#/$defs/ConditionInputDomain"
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/ValidationIssue"
          },
          "maxItems": 512,
          "minItems": 1,
          "title": "Issues",
          "type": "array"
        },
        "status": {
          "enum": [
            "invalid",
            "incomplete"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "input_domain",
        "issues"
      ],
      "title": "FailedTypeCheck",
      "type": "object"
    },
    "FieldName": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "IssueIndex": {
      "minimum": 0,
      "type": "integer"
    },
    "IssuePath": {
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/FieldName"
          },
          {
            "$ref": "#/$defs/IssueIndex"
          }
        ]
      },
      "maxItems": 32,
      "type": "array"
    },
    "PassedTypeCheck": {
      "additionalProperties": false,
      "properties": {
        "inferred_type": {
          "$ref": "#/$defs/BooleanTypeDefinition"
        },
        "input_domain": {
          "$ref": "#/$defs/ConditionInputDomain"
        },
        "status": {
          "const": "passed",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "input_domain",
        "inferred_type"
      ],
      "title": "PassedTypeCheck",
      "type": "object"
    },
    "ValidationIssue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "$ref": "#/$defs/Description"
        },
        "path": {
          "$ref": "#/$defs/IssuePath"
        },
        "related_refs": {
          "items": {
            "$ref": "#/$defs/ContentRef"
          },
          "maxItems": 16,
          "title": "Related Refs",
          "type": "array"
        }
      },
      "required": [
        "code",
        "path",
        "message",
        "related_refs"
      ],
      "title": "ValidationIssue",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "discriminator": {
    "mapping": {
      "incomplete": "#/$defs/FailedTypeCheck",
      "invalid": "#/$defs/FailedTypeCheck",
      "passed": "#/$defs/PassedTypeCheck"
    },
    "propertyName": "status"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/PassedTypeCheck"
    },
    {
      "$ref": "#/$defs/FailedTypeCheck"
    }
  ]
}
