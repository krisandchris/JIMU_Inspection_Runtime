        },
        "min_items": {
          "$ref": "#/$defs/jimu_runtime__domain__values__Size__2",
          "default": 0
        }
      },
      "required": [
        "kind",
        "item_type"
      ],
      "title": "ListTypeDefinition",
      "type": "object"
    },
    "ListValue": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "list",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "items": {
            "$ref": "#/$defs/Value"
          },
          "maxItems": 256,
          "title": "Value",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "ListValue",
      "type": "object"
    },
    "LiteralExpr": {
      "additionalProperties": false,
      "properties": {
        "constant": {
          "$ref": "#/$defs/ValueContract"
        },
        "kind": {
          "const": "literal",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "constant"
      ],
      "title": "LiteralExpr",
      "type": "object"
    },
    "LocalToolFactRefExpr": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "local_tool_fact_ref",
          "title": "Kind",
          "type": "string"
        },
        "selector": {
          "$ref": "#/$defs/LocalToolFactSelector"
        }
      },
      "required": [
        "kind",
        "selector"
      ],
      "title": "LocalToolFactRefExpr",
      "type": "object"
    },
    "LocalToolFactSelector": {
      "additionalProperties": false,
