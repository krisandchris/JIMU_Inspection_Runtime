          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Step Id",
          "type": "string"
        },
        "tool_ref": {
          "$ref": "#/$defs/ToolContentRef"
        }
      },
      "required": [
        "scope",
        "step_id",
        "tool_ref",
        "output_name",
        "fact_key",
        "fact_schema_ref",
        "field_path"
