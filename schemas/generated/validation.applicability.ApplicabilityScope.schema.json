        "record_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Record Id",
          "type": "string"
        },
        "record_kind": {
          "const": "node_run",
