{
  "$defs": {
    "AbsentOptional_Description_": {
      "$ref": "#/$defs/Description"
    },
    "AbsentOptional_ReviewReportRef_": {
      "$ref": "#/$defs/ReviewReportRef"
    },
    "AllExpr": {
      "additionalProperties": false,
      "properties": {
        "arguments": {
          "items": {
            "$ref": "#/$defs/ConditionExpr"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Arguments",
          "type": "array"
        },
        "kind": {
          "const": "all",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "arguments"
      ],
      "title": "AllExpr",
      "type": "object"
    },
    "AnyExpr": {
      "additionalProperties": false,
      "properties": {
        "arguments": {
          "items": {
            "$ref": "#/$defs/ConditionExpr"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Arguments",
          "type": "array"
        },
        "kind": {
          "const": "any",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "arguments"
      ],
      "title": "AnyExpr",
      "type": "object"
    },
    "ApplicabilityPolicy": {
      "additionalProperties": false,
      "properties": {
        "condition_ast": {
          "$ref": "#/$defs/ConditionExpr"
        },
        "context_allowlist": {
          "items": {
            "$ref": "#/$defs/ContextFieldSelector"
          },
          "maxItems": 1024,
          "title": "Context Allowlist",
          "type": "array"
        },
        "description": {
          "$ref": "#/$defs/AbsentOptional_Description_"
        },
        "identity_constraints": {
          "items": {
            "$ref": "#/$defs/IdentitySelector"
          },
          "maxItems": 1024,
          "title": "Identity Constraints",
          "type": "array"
        },
        "input_domain": {
          "const": "rule_applicability",
          "title": "Input Domain",
          "type": "string"
        },
        "on_unknown": {
          "const": "block",
          "title": "On Unknown",
          "type": "string"
        },
        "policy_kind": {
          "const": "applicability",
          "title": "Policy Kind",
          "type": "string"
        }
      },
      "required": [
        "policy_kind",
        "input_domain",
        "context_allowlist",
        "identity_constraints",
        "condition_ast",
        "on_unknown"
      ],
      "title": "ApplicabilityPolicy",
      "type": "object"
    },
    "ApplicabilityPolicyArtifact": {
      "additionalProperties": false,
      "properties": {
        "policy": {
          "$ref": "#/$defs/ApplicabilityPolicy"
        },
        "policy_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Policy Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "policy_id",
        "version",
        "policy"
      ],
      "title": "ApplicabilityPolicyArtifact",
      "type": "object"
    },
    "ApplicabilityTargetBinding": {
      "additionalProperties": false,
      "description": "Finite view of one Bundle member's pinned policy and forward membership.",
      "properties": {
        "child_refs": {
          "$ref": "#/$defs/_Directory_ApplicabilityTargetRef_"
        },
        "policy": {
          "$ref": "#/$defs/ApplicabilityPolicyArtifact"
        },
        "policy_ref": {
          "$ref": "#/$defs/PolicyContentRef"
        },
        "target_ref": {
          "$ref": "#/$defs/ApplicabilityTargetRef"
        }
      },
      "required": [
        "target_ref",
        "policy_ref",
        "policy",
        "child_refs"
      ],
      "title": "ApplicabilityTargetBinding",
      "type": "object"
    },
    "ApplicabilityTargetRef": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProfileContentRef"
        },
        {
          "$ref": "#/$defs/RuleSetContentRef"
        },
        {
          "$ref": "#/$defs/RuleContentRef"
        }
      ]
    },
    "BooleanTypeDefinition": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "bool",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "BooleanTypeDefinition",
      "type": "object"
    },
    "BooleanValue": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "bool",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "BooleanValue",
      "type": "object"
    },
    "BoundedString": {
      "maxLength": 4096,
      "type": "string"
    },
    "CapabilityFeature": {
      "enum": [
        "rgb_image",
        "typed_context",
        "structured_output",
        "original_xyxy",
        "mask_output",
        "geometry_output",
        "ocr_text"
      ],
      "title": "CapabilityFeature",
      "type": "string"
    },
    "ComparisonExpr": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "comparison",
          "title": "Kind",
          "type": "string"
        },
        "left": {
          "$ref": "#/$defs/ConditionExpr"
        },
        "operator": {
          "$ref": "#/$defs/ComparisonOperator"
        },
        "right": {
          "$ref": "#/$defs/ConditionExpr"
        }
      },
      "required": [
        "kind",
        "operator",
        "left",
        "right"
      ],
      "title": "ComparisonExpr",
      "type": "object"
    },
    "ComparisonOperator": {
      "enum": [
        "eq",
        "ne",
        "lt",
        "le",
        "gt",
        "ge"
      ],
      "title": "ComparisonOperator",
      "type": "string"
    },
    "ConditionExpr": {
      "discriminator": {
        "mapping": {
          "all": "#/$defs/AllExpr",
          "any": "#/$defs/AnyExpr",
          "comparison": "#/$defs/ComparisonExpr",
          "context_ref": "#/$defs/ContextRefExpr",
          "fact_ref": "#/$defs/FactRefExpr",
          "in": "#/$defs/InExpr",
          "literal": "#/$defs/LiteralExpr",
          "local_tool_fact_ref": "#/$defs/LocalToolFactRefExpr",
          "not": "#/$defs/NotExpr",
          "record_field_ref": "#/$defs/RecordFieldRefExpr"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/LiteralExpr"
        },
        {
          "$ref": "#/$defs/FactRefExpr"
        },
        {
          "$ref": "#/$defs/RecordFieldRefExpr"
        },
        {
          "$ref": "#/$defs/ContextRefExpr"
        },
        {
          "$ref": "#/$defs/LocalToolFactRefExpr"
        },
        {
          "$ref": "#/$defs/ComparisonExpr"
        },
        {
          "$ref": "#/$defs/InExpr"
        },
        {
          "$ref": "#/$defs/AllExpr"
        },
        {
          "$ref": "#/$defs/AnyExpr"
        },
        {
          "$ref": "#/$defs/NotExpr"
        }
      ]
    },
    "ContextFieldSelector": {
      "additionalProperties": false,
      "properties": {
        "field_path": {
          "items": {
            "$ref": "#/$defs/FieldName"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Field Path",
          "type": "array"
        },
        "schema_ref": {
          "$ref": "#/$defs/ContextSchemaRef"
        },
        "source": {
          "$ref": "#/$defs/ContextSource"
        }
      },
      "required": [
        "source",
        "schema_ref",
        "field_path"
      ],
      "title": "ContextFieldSelector",
      "type": "object"
    },
    "ContextRefExpr": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "context_ref",
          "title": "Kind",
          "type": "string"
        },
        "selector": {
          "$ref": "#/$defs/ContextFieldSelector"
        }
      },
      "required": [
        "kind",
        "selector"
      ],
      "title": "ContextRefExpr",
      "type": "object"
    },
    "ContextSchemaRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_kind": {
          "const": "context_schema",
          "title": "Artifact Kind",
          "type": "string"
        },
        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "schema_dialect": {
          "const": "https://json-schema.org/draft/2020-12/schema",
          "title": "Schema Dialect",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_kind",
        "artifact_id",
        "version",
        "digest",
        "schema_dialect"
      ],
      "title": "ContextSchemaRef",
      "type": "object"
    },
    "ContextSnapshotRef": {
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Record Id",
          "type": "string"
        },
        "record_kind": {
          "const": "context_snapshot",
          "title": "Record Kind",
          "type": "string"
        }
      },
      "required": [
        "record_kind",
        "record_id"
      ],
      "title": "ContextSnapshotRef",
      "type": "object"
    },
    "ContextSource": {
      "enum": [
        "context_snapshot",
        "region_metadata",
        "profile_metadata"
      ],
      "title": "ContextSource",
      "type": "string"
    },
    "Description": {
      "maxLength": 4096,
      "minLength": 1,
      "pattern": "\\S",
      "type": "string"
    },
    "EnumTypeDefinition": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "enum",
          "title": "Kind",
          "type": "string"
        },
        "members": {
          "items": {
            "$ref": "#/$defs/BoundedString"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Members",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "members"
      ],
      "title": "EnumTypeDefinition",
      "type": "object"
    },
    "EnumValue": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "enum",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/BoundedString"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "EnumValue",
      "type": "object"
    },
    "FactRefExpr": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "fact_ref",
          "title": "Kind",
          "type": "string"
        },
        "selector": {
          "$ref": "#/$defs/FactSelector"
        }
      },
      "required": [
        "kind",
        "selector"
      ],
      "title": "FactRefExpr",
      "type": "object"
    },
    "FactSchemaContentRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_kind": {
          "const": "fact_schema",
          "title": "Artifact Kind",
          "type": "string"
        },
        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_kind",
        "artifact_id",
        "version",
        "digest"
      ],
      "title": "FactSchemaContentRef",
      "type": "object"
    },
    "FactScope": {
      "enum": [
        "object",
        "execution"
      ],
      "title": "FactScope",
      "type": "string"
    },
    "FactSelector": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "scope": {
                "const": "execution"
              }
            },
            "required": [
              "scope"
            ]
          },
          "then": {
            "properties": {
              "producer_selector": {
                "properties": {
                  "producer_kind": {
                    "const": "system"
                  }
                }
              }
            }
          }
        }
      ],
      "properties": {
        "fact_key": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Fact Key",
          "type": "string"
        },
        "fact_schema_ref": {
          "$ref": "#/$defs/FactSchemaContentRef"
        },
        "field_path": {
          "$ref": "#/$defs/FieldPath"
        },
        "producer_selector": {
          "$ref": "#/$defs/ProducerSelector"
        },
        "scope": {
          "$ref": "#/$defs/FactScope"
        }
      },
      "required": [
        "scope",
        "fact_key",
        "fact_schema_ref",
        "producer_selector",
        "field_path"
      ],
      "title": "FactSelector",
      "type": "object"
    },
    "FieldName": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "FieldPath": {
      "items": {
        "$ref": "#/$defs/FieldName"
      },
      "maxItems": 8,
      "type": "array"
    },
    "FiniteNumber": {
      "type": "number"
    },
    "IdentitySelector": {
      "additionalProperties": false,
      "description": "Only approved Profile/Region applicability identity; never content authority.",
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_kind": {
          "enum": [
            "profile",
            "region"
          ],
          "title": "Artifact Kind",
          "type": "string"
        },
        "version_selector": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version Selector",
          "type": "string"
        }
      },
      "required": [
        "artifact_kind",
        "artifact_id",
        "version_selector"
      ],
      "title": "IdentitySelector",
      "type": "object"
    },
    "InExpr": {
      "additionalProperties": false,
      "properties": {
        "collection": {
          "$ref": "#/$defs/ConditionExpr"
        },
        "item": {
          "$ref": "#/$defs/ConditionExpr"
        },
        "kind": {
          "const": "in",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "item",
        "collection"
      ],
      "title": "InExpr",
      "type": "object"
    },
    "IntegerTypeDefinition": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "integer",
          "title": "Kind",
          "type": "string"
        },
        "maximum": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Maximum"
        },
        "minimum": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum"
        }
      },
      "required": [
        "kind"
      ],
      "title": "IntegerTypeDefinition",
      "type": "object"
    },
    "IntegerValue": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "integer",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "IntegerValue",
      "type": "object"
    },
    "ListTypeDefinition": {
      "additionalProperties": false,
      "properties": {
        "item_type": {
          "$ref": "#/$defs/TypeDefinition"
        },
        "kind": {
          "const": "list",
          "title": "Kind",
          "type": "string"
        },
        "max_items": {
          "$ref": "#/$defs/jimu_runtime__domain__values__Size__2",
