      "title": "Context Snapshot Digest",
      "type": "string"
    },
    "context_snapshot_ref": {
      "$ref": "#/$defs/ContextSnapshotRef"
    },
    "execution_id": {
      "maxLength": 128,
      "minLength": 1,
      "not": {
        "pattern": "\\s"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Execution Id",
      "type": "string"
    },
    "release_id": {
      "maxLength": 128,
      "minLength": 1,
      "not": {
        "pattern": "\\s"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Release Id",
      "type": "string"
    },
    "target_bindings": {
      "$ref": "#/$defs/_Directory_ApplicabilityTargetBinding_"
    },
    "workflow_version": {
      "maxLength": 128,
      "minLength": 5,
      "not": {
        "pattern": "\\s"
      },
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "title": "Workflow Version",
      "type": "string"
    }
  },
  "required": [
    "execution_id",
    "release_id",
    "bundle_digest",
    "workflow_version",
    "context_snapshot_ref",
    "context_snapshot_digest",
    "context_node_run",
    "configured_profile_refs",
    "target_bindings"
  ],
  "title": "ApplicabilityScope",
  "type": "object"
}
