        "fact_key": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Fact Key",
          "type": "string"
        },
        "fact_schema_ref": {
          "$ref": "#/$defs/FactSchemaContentRef"
        },
        "field_path": {
