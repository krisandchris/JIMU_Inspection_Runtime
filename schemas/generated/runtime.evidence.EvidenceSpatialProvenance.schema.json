{
  "$defs": {
    "AffineCoefficient": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "number"
    },
    "AssetDimensions": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "$ref": "#/$defs/PositiveBudget"
        },
        "width": {
          "$ref": "#/$defs/PositiveBudget"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "title": "AssetDimensions",
      "type": "object"
    },
    "CoordinateSystem": {
      "additionalProperties": false,
      "description": "Image-plane pixel edges with origin at the top left and axes right/down.",
      "properties": {
        "coordinate_system_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Coordinate System Id",
          "type": "string"
        },
        "dimensions": {
          "$ref": "#/$defs/AssetDimensions"
        },
        "frame": {
          "enum": [
            "original_image",
            "derived_image"
          ],
          "title": "Frame",
          "type": "string"
        }
      },
      "required": [
        "coordinate_system_id",
        "frame",
        "dimensions"
      ],
      "title": "CoordinateSystem",
      "type": "object"
    },
    "DerivedImageEvidence": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "derived_image",
          "title": "Kind",
          "type": "string"
        },
        "original_media_ref": {
          "$ref": "#/$defs/MediaRef"
        },
        "transforms": {
          "items": {
            "$ref": "#/$defs/TransformRecord"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Transforms",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "original_media_ref",
        "transforms"
      ],
      "title": "DerivedImageEvidence",
      "type": "object"
    },
    "MediaRef": {
      "additionalProperties": false,
      "properties": {
        "media_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Media Id",
          "type": "string"
        },
        "sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "media_id",
        "sha256"
      ],
      "title": "MediaRef",
      "type": "object"
    },
    "NonSpatialEvidence": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "non_spatial",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "NonSpatialEvidence",
      "type": "object"
    },
    "OriginalImageEvidence": {
      "additionalProperties": false,
      "properties": {
        "coordinate_system": {
          "$ref": "#/$defs/CoordinateSystem"
        },
        "kind": {
          "const": "original_image",
          "title": "Kind",
          "type": "string"
        },
        "original_media_ref": {
          "$ref": "#/$defs/MediaRef"
        }
      },
      "required": [
        "kind",
        "original_media_ref",
        "coordinate_system"
      ],
      "title": "OriginalImageEvidence",
      "type": "object"
    },
    "PositiveBudget": {
      "maximum": 9223372036854775807,
      "minimum": 1,
      "type": "integer"
    },
    "TransformRecord": {
      "additionalProperties": false,
      "description": "Forward affine mapping from source to target pixel coordinates.\n\nThe six coefficients are [a, b, c, d, e, f], mapping to\nx' = a*x + b*y + c and y' = d*x + e*y + f.",
      "properties": {
        "affine": {
          "maxItems": 6,
          "minItems": 6,
          "prefixItems": [
            {
              "$ref": "#/$defs/AffineCoefficient"
            },
            {
              "$ref": "#/$defs/AffineCoefficient"
            },
            {
              "$ref": "#/$defs/AffineCoefficient"
            },
            {
              "$ref": "#/$defs/AffineCoefficient"
            },
            {
              "$ref": "#/$defs/AffineCoefficient"
            },
            {
              "$ref": "#/$defs/AffineCoefficient"
            }
          ],
          "title": "Affine",
          "type": "array"
        },
        "implementation_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Implementation Id",
          "type": "string"
        },
        "implementation_version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Implementation Version",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/CoordinateSystem"
        },
        "target": {
          "$ref": "#/$defs/CoordinateSystem"
        }
      },
      "required": [
        "source",
        "target",
        "implementation_id",
        "implementation_version",
        "affine"
      ],
      "title": "TransformRecord",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "discriminator": {
    "mapping": {
      "derived_image": "#/$defs/DerivedImageEvidence",
      "non_spatial": "#/$defs/NonSpatialEvidence",
      "original_image": "#/$defs/OriginalImageEvidence"
    },
    "propertyName": "kind"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/OriginalImageEvidence"
    },
    {
      "$ref": "#/$defs/DerivedImageEvidence"
    },
    {
      "$ref": "#/$defs/NonSpatialEvidence"
    }
  ]
}
