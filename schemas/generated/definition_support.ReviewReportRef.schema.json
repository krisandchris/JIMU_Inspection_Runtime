{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "report_id": {
      "maxLength": 128,
      "minLength": 1,
      "not": {
        "pattern": "\\s"
      },
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
      "title": "Report Id",
      "type": "string"
    },
    "review_registry_id": {
      "maxLength": 128,
      "minLength": 1,
      "not": {
        "pattern": "\\s"
      },
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
      "title": "Review Registry Id",
      "type": "string"
    },
    "sha256": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "version": {
      "maxLength": 128,
      "minLength": 5,
      "not": {
        "pattern": "\\s"
      },
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "report_id",
    "version",
    "sha256",
    "review_registry_id"
  ],
  "title": "ReviewReportRef",
  "type": "object"
}
