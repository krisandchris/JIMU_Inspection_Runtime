{
  "$defs": {
    "FiniteNumber": {
      "type": "number"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "category_id": {
      "maxLength": 128,
      "minLength": 1,
      "not": {
        "pattern": "\\s"
      },
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
      "title": "Category Id",
      "type": "string"
    },
    "score": {
      "$ref": "#/$defs/FiniteNumber"
    }
  },
  "required": [
    "category_id",
    "score"
  ],
  "title": "CandidateCategory",
  "type": "object"
}
