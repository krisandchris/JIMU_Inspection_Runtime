{
  "$defs": {
    "Description": {
      "maxLength": 4096,
      "minLength": 1,
      "pattern": "\\S",
      "type": "string"
    },
    "ProviderKind": {
      "enum": [
        "remote",
        "local"
      ],
      "type": "string"
    },
    "RegistryVerifiedProviderIdentity": {
      "additionalProperties": false,
      "properties": {
        "deployment_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Deployment Id",
          "type": "string"
        },
        "deployment_version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Deployment Version",
          "type": "string"
        },
        "model_id": {
          "$ref": "#/$defs/ShortText"
        },
        "model_version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Model Version",
          "type": "string"
        },
        "provider_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Provider Id",
          "type": "string"
        },
        "provider_kind": {
          "$ref": "#/$defs/ProviderKind"
        },
        "version_evidence": {
          "$ref": "#/$defs/ReviewReportRef"
        },
        "version_resolution": {
          "const": "registry_verified",
          "title": "Version Resolution",
          "type": "string"
        }
      },
      "required": [
        "provider_id",
        "deployment_id",
        "provider_kind",
        "model_id",
        "deployment_version",
        "model_version",
        "version_resolution",
        "version_evidence"
      ],
      "title": "RegistryVerifiedProviderIdentity",
      "type": "object"
    },
    "ReportedProviderIdentity": {
      "additionalProperties": false,
      "properties": {
        "deployment_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Deployment Id",
          "type": "string"
        },
        "deployment_version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Deployment Version",
          "type": "string"
        },
        "model_id": {
          "$ref": "#/$defs/ShortText"
        },
        "model_version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Model Version",
          "type": "string"
        },
        "provider_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Provider Id",
          "type": "string"
        },
        "provider_kind": {
          "$ref": "#/$defs/ProviderKind"
        },
        "version_evidence": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Version Evidence",
          "type": "string"
        },
        "version_resolution": {
          "const": "reported",
          "title": "Version Resolution",
          "type": "string"
        }
      },
      "required": [
        "provider_id",
        "deployment_id",
        "provider_kind",
        "model_id",
        "deployment_version",
        "model_version",
        "version_resolution",
        "version_evidence"
      ],
      "title": "ReportedProviderIdentity",
      "type": "object"
    },
    "ReviewReportRef": {
      "additionalProperties": false,
      "properties": {
        "report_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Report Id",
          "type": "string"
        },
        "review_registry_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Review Registry Id",
          "type": "string"
        },
        "sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "report_id",
        "version",
        "sha256",
        "review_registry_id"
      ],
      "title": "ReviewReportRef",
      "type": "object"
    },
    "ShortText": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "\\S",
      "type": "string"
    },
    "UnavailableProviderIdentity": {
      "additionalProperties": false,
      "properties": {
        "deployment_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Deployment Id",
          "type": "string"
        },
        "model_id": {
          "$ref": "#/$defs/ShortText"
        },
        "provider_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Provider Id",
          "type": "string"
        },
        "provider_kind": {
          "$ref": "#/$defs/ProviderKind"
        },
        "version_resolution": {
          "const": "unavailable",
          "title": "Version Resolution",
          "type": "string"
        },
        "version_unavailable_reason": {
          "$ref": "#/$defs/Description"
        }
      },
      "required": [
        "provider_id",
        "deployment_id",
        "provider_kind",
        "model_id",
        "version_resolution",
        "version_unavailable_reason"
      ],
      "title": "UnavailableProviderIdentity",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "discriminator": {
    "mapping": {
      "registry_verified": "#/$defs/RegistryVerifiedProviderIdentity",
      "reported": "#/$defs/ReportedProviderIdentity",
      "unavailable": "#/$defs/UnavailableProviderIdentity"
    },
    "propertyName": "version_resolution"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/ReportedProviderIdentity"
    },
    {
      "$ref": "#/$defs/RegistryVerifiedProviderIdentity"
    },
    {
      "$ref": "#/$defs/UnavailableProviderIdentity"
    }
  ]
}
