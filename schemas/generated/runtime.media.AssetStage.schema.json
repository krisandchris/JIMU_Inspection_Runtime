{
  "$defs": {
    "FinalizedAsset": {
      "additionalProperties": false,
      "properties": {
        "object_version": {
          "$ref": "#/$defs/ShortText"
        },
        "stage": {
          "const": "finalized",
          "title": "Stage",
          "type": "string"
        },
        "staged_at": {
          "$ref": "#/$defs/UTCDateTime"
        },
        "verified_at": {
          "$ref": "#/$defs/UTCDateTime"
        },
        "verified_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Verified Sha256",
          "type": "string"
        }
      },
      "required": [
        "stage",
        "staged_at",
        "verified_at",
        "verified_sha256",
        "object_version"
      ],
      "title": "FinalizedAsset",
      "type": "object"
    },
    "ShortText": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "\\S",
      "type": "string"
    },
    "StagedAsset": {
      "additionalProperties": false,
      "properties": {
        "stage": {
          "const": "staged",
          "title": "Stage",
          "type": "string"
        },
        "staged_at": {
          "$ref": "#/$defs/UTCDateTime"
        }
      },
      "required": [
        "stage",
        "staged_at"
      ],
      "title": "StagedAsset",
      "type": "object"
    },
    "UTCDateTime": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])[Tt](?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:[Zz]|\\+00:00)$(?![\\s\\S])",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "discriminator": {
    "mapping": {
      "finalized": "#/$defs/FinalizedAsset",
      "staged": "#/$defs/StagedAsset"
    },
    "propertyName": "stage"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/StagedAsset"
    },
    {
      "$ref": "#/$defs/FinalizedAsset"
    }
  ]
}
