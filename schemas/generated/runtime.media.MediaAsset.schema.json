{
  "$defs": {
    "AssetDimensions": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "$ref": "#/$defs/PositiveBudget"
        },
        "width": {
          "$ref": "#/$defs/PositiveBudget"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "title": "AssetDimensions",
      "type": "object"
    },
    "AssetStage": {
      "discriminator": {
        "mapping": {
          "finalized": "#/$defs/FinalizedAsset",
          "staged": "#/$defs/StagedAsset"
        },
        "propertyName": "stage"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/StagedAsset"
        },
        {
          "$ref": "#/$defs/FinalizedAsset"
        }
      ]
    },
    "FinalizedAsset": {
      "additionalProperties": false,
      "properties": {
        "object_version": {
          "$ref": "#/$defs/ShortText"
        },
        "stage": {
          "const": "finalized",
          "title": "Stage",
          "type": "string"
        },
        "staged_at": {
          "$ref": "#/$defs/UTCDateTime"
        },
        "verified_at": {
          "$ref": "#/$defs/UTCDateTime"
        },
        "verified_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Verified Sha256",
          "type": "string"
        }
      },
      "required": [
        "stage",
        "staged_at",
        "verified_at",
        "verified_sha256",
        "object_version"
      ],
      "title": "FinalizedAsset",
      "type": "object"
    },
    "ImageMimeType": {
      "maxLength": 128,
      "pattern": "^image/[a-z0-9][a-z0-9.+-]*$",
      "type": "string"
    },
    "MediaRef": {
      "additionalProperties": false,
      "properties": {
        "media_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Media Id",
          "type": "string"
        },
        "sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "media_id",
        "sha256"
      ],
      "title": "MediaRef",
      "type": "object"
    },
    "ObjectKey": {
      "maxLength": 1024,
      "minLength": 1,
      "pattern": "^(?!.*(?:^|/)[.]{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*(?![\\s\\S])",
      "type": "string"
    },
    "PositiveBudget": {
      "maximum": 9223372036854775807,
      "minimum": 1,
      "type": "integer"
    },
    "ShortText": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "\\S",
      "type": "string"
    },
    "StagedAsset": {
      "additionalProperties": false,
      "properties": {
        "stage": {
          "const": "staged",
          "title": "Stage",
          "type": "string"
        },
        "staged_at": {
          "$ref": "#/$defs/UTCDateTime"
        }
      },
      "required": [
        "stage",
        "staged_at"
      ],
      "title": "StagedAsset",
      "type": "object"
    },
    "StorageReference": {
      "additionalProperties": false,
      "properties": {
        "object_key": {
          "$ref": "#/$defs/ObjectKey"
        },
        "store_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Store Id",
          "type": "string"
        }
      },
      "required": [
        "store_id",
        "object_key"
      ],
      "title": "StorageReference",
      "type": "object"
    },
    "UTCDateTime": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])[Tt](?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:[Zz]|\\+00:00)$(?![\\s\\S])",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "byte_size": {
      "$ref": "#/$defs/PositiveBudget"
    },
    "color_space": {
      "const": "RGB",
      "title": "Color Space",
      "type": "string"
    },
    "dimensions": {
      "$ref": "#/$defs/AssetDimensions"
    },
    "media_ref": {
      "$ref": "#/$defs/MediaRef"
    },
    "mime_type": {
      "$ref": "#/$defs/ImageMimeType"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "stage": {
      "$ref": "#/$defs/AssetStage"
    },
    "storage": {
      "$ref": "#/$defs/StorageReference"
    }
  },
  "required": [
    "schema_version",
    "media_ref",
    "storage",
    "stage",
    "mime_type",
    "byte_size",
    "dimensions",
    "color_space"
  ],
  "title": "MediaAsset",
  "type": "object"
}
