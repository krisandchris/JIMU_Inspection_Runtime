{
  "$defs": {
    "FiniteNumber": {
      "type": "number"
    },
    "GeometryCoordinate": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "$ref": "#/$defs/FiniteNumber"
        }
      ],
      "maximum": 9007199254740991,
      "minimum": -9007199254740991
    },
    "GeometryPoint": {
      "additionalProperties": false,
      "properties": {
        "x": {
          "$ref": "#/$defs/GeometryCoordinate"
        },
        "y": {
          "$ref": "#/$defs/GeometryCoordinate"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "GeometryPoint",
      "type": "object"
    },
    "GeometryProvenance": {
      "additionalProperties": false,
      "properties": {
        "source_asset_ref": {
          "$ref": "#/$defs/StaticAssetContentRef"
        }
      },
      "required": [
        "source_asset_ref"
      ],
      "title": "GeometryProvenance",
      "type": "object"
    },
    "PolygonGeometry": {
      "additionalProperties": false,
      "description": "One 2D exterior ring with implicit closure and no holes.",
      "properties": {
        "kind": {
          "const": "polygon",
          "title": "Kind",
          "type": "string"
        },
        "vertices": {
          "items": {
            "$ref": "#/$defs/GeometryPoint"
          },
          "maxItems": 256,
          "minItems": 3,
          "title": "Vertices",
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "kind",
        "vertices"
      ],
      "title": "PolygonGeometry",
      "type": "object"
    },
    "ShortText": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "\\S",
      "type": "string"
    },
    "StaticAssetContentRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_kind": {
          "const": "static_asset",
          "title": "Artifact Kind",
          "type": "string"
        },
        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_kind",
        "artifact_id",
        "version",
        "digest"
      ],
      "title": "StaticAssetContentRef",
      "type": "object"
    },
    "VocabularyContentRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_kind": {
          "const": "vocabulary",
          "title": "Artifact Kind",
          "type": "string"
        },
        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_kind",
        "artifact_id",
        "version",
        "digest"
      ],
      "title": "VocabularyContentRef",
      "type": "object"
    },
    "VocabularyMemberRef": {
      "additionalProperties": false,
      "properties": {
        "member": {
          "$ref": "#/$defs/ShortText"
        },
        "vocabulary_ref": {
          "$ref": "#/$defs/VocabularyContentRef"
        }
      },
      "required": [
        "vocabulary_ref",
        "member"
      ],
      "title": "VocabularyMemberRef",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "coordinate_system": {
      "$ref": "#/$defs/VocabularyMemberRef"
    },
    "geometry": {
      "$ref": "#/$defs/PolygonGeometry"
    },
    "geometry_resource_id": {
      "maxLength": 128,
      "minLength": 1,
      "not": {
        "pattern": "\\s"
      },
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
      "title": "Geometry Resource Id",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/GeometryProvenance"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "units": {
      "$ref": "#/$defs/VocabularyMemberRef"
    },
    "version": {
      "maxLength": 128,
      "minLength": 5,
      "not": {
        "pattern": "\\s"
      },
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "geometry_resource_id",
    "version",
    "coordinate_system",
    "units",
    "geometry",
    "provenance"
  ],
  "title": "GeometryResourceDefinition",
  "type": "object"
}
