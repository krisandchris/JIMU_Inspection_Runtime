{
  "$defs": {
    "AbsentOptional_TrueFlag_": {
      "$ref": "#/$defs/TrueFlag"
    },
    "EvidencePolicy": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "allowed_evidence_types": {
                "contains": {
                  "enum": [
                    "crop",
                    "bbox_visualization",
                    "mask",
                    "geometry"
                  ]
                }
              }
            },
            "required": [
              "allowed_evidence_types"
            ]
          },
          "then": {
            "required": [
              "transform_required_for_derived"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "original_media_required": {
                "const": true
              }
            },
            "required": [
              "original_media_required"
            ]
          },
          "then": {
            "properties": {
              "allowed_evidence_types": {
                "contains": {
                  "const": "original_image"
                }
              }
            }
          }
        }
      ],
      "properties": {
        "access_scope": {
          "enum": [
            "project",
            "task"
          ],
          "title": "Access Scope",
          "type": "string"
        },
        "allowed_evidence_types": {
          "$ref": "#/$defs/EvidenceTypes"
        },
        "on_missing": {
          "const": "block_result",
          "title": "On Missing",
          "type": "string"
        },
        "original_media_required": {
          "title": "Original Media Required",
          "type": "boolean"
        },
        "policy_kind": {
          "const": "evidence",
          "title": "Policy Kind",
          "type": "string"
        },
        "required_evidence_types": {
          "$ref": "#/$defs/EvidenceTypes"
        },
        "retention_class": {
          "$ref": "#/$defs/VocabularyMemberRef"
        },
        "retention_duration_seconds": {
          "$ref": "#/$defs/PositiveBudget"
        },
        "transform_required_for_derived": {
          "$ref": "#/$defs/AbsentOptional_TrueFlag_"
        }
      },
      "required": [
        "policy_kind",
        "required_evidence_types",
        "allowed_evidence_types",
        "on_missing",
        "original_media_required",
        "retention_class",
        "retention_duration_seconds",
        "access_scope"
      ],
      "title": "EvidencePolicy",
      "type": "object"
    },
    "EvidenceType": {
      "enum": [
        "original_image",
        "crop",
        "bbox_visualization",
        "mask",
        "tool_output",
        "geometry",
        "model_request",
        "model_response"
      ],
      "title": "EvidenceType",
      "type": "string"
    },
    "EvidenceTypes": {
      "items": {
        "$ref": "#/$defs/EvidenceType"
      },
      "maxItems": 8,
      "type": "array",
      "uniqueItems": true
    },
    "PositiveBudget": {
      "maximum": 9223372036854775807,
      "minimum": 1,
      "type": "integer"
    },
    "ShortText": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "\\S",
      "type": "string"
    },
    "TrueFlag": {
      "const": true,
      "type": "boolean"
    },
    "VocabularyContentRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_kind": {
          "const": "vocabulary",
          "title": "Artifact Kind",
          "type": "string"
        },
        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_kind",
        "artifact_id",
        "version",
        "digest"
      ],
      "title": "VocabularyContentRef",
      "type": "object"
    },
    "VocabularyMemberRef": {
      "additionalProperties": false,
      "properties": {
        "member": {
          "$ref": "#/$defs/ShortText"
        },
        "vocabulary_ref": {
          "$ref": "#/$defs/VocabularyContentRef"
        }
      },
      "required": [
        "vocabulary_ref",
        "member"
      ],
      "title": "VocabularyMemberRef",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "policy": {
      "$ref": "#/$defs/EvidencePolicy"
    },
    "policy_id": {
      "maxLength": 128,
      "minLength": 1,
      "not": {
        "pattern": "\\s"
      },
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
      "title": "Policy Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "version": {
      "maxLength": 128,
      "minLength": 5,
      "not": {
        "pattern": "\\s"
      },
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "policy_id",
    "version",
    "policy"
  ],
  "title": "EvidencePolicyArtifact",
  "type": "object"
}
