{
  "$defs": {
    "ApplicabilityAncestorRef": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProfileEligibilityEvaluationRef"
        },
        {
          "$ref": "#/$defs/RuleSetApplicabilityEvaluationRef"
        }
      ]
    },
    "ApplicabilityEvaluationOwner": {
      "enum": [
        "pre_n02_gate",
        "n06"
      ],
      "title": "ApplicabilityEvaluationOwner",
      "type": "string"
    },
    "ApplicabilityEvaluationRef": {
      "anyOf": [
        {
          "$ref": "#/$defs/ApplicabilityAncestorRef"
        },
        {
          "$ref": "#/$defs/RuleApplicabilityEvaluationRef"
        }
      ]
    },
    "ApplicabilityLevel": {
      "enum": [
        "profile",
        "rule_set",
        "rule"
      ],
      "title": "ApplicabilityLevel",
      "type": "string"
    },
    "ApplicabilityReason": {
      "enum": [
        "included_by_policy",
        "excluded_by_policy",
        "metadata_unknown",
        "metadata_invalid",
        "ancestor_excluded",
        "ancestor_unresolved"
      ],
      "title": "ApplicabilityReason",
      "type": "string"
    },
    "ApplicabilityReasonEvidenceRef": {
      "anyOf": [
        {
          "$ref": "#/$defs/PolicyContentRef"
        },
        {
          "$ref": "#/$defs/ContextFieldSelector"
        }
      ]
    },
    "ApplicabilityTargetRef": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProfileContentRef"
        },
        {
          "$ref": "#/$defs/RuleSetContentRef"
        },
        {
          "$ref": "#/$defs/RuleContentRef"
        }
      ]
    },
    "ArtifactKind": {
      "enum": [
        "entity",
        "region",
        "profile",
        "facet",
        "question",
        "tool",
        "tool_plan",
        "rule",
        "rule_set",
        "model_binding",
        "fact_schema",
        "prompt_template",
        "response_schema",
        "attribute_schema",
        "context_schema",
        "tool_input_schema",
        "tool_output_schema",
        "object_schema",
        "decision_schema",
        "value_schema",
        "policy",
        "vocabulary",
        "geometry_resource",
        "static_asset",
        "fact_producer_catalog"
      ],
      "title": "ArtifactKind",
      "type": "string"
    },
    "ContentRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_kind",
        "artifact_id",
        "version",
        "digest"
      ],
      "title": "ContentRef",
      "type": "object"
    },
    "ContextFieldSelector": {
      "additionalProperties": false,
      "properties": {
        "field_path": {
          "items": {
            "$ref": "#/$defs/FieldName"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Field Path",
          "type": "array"
        },
        "schema_ref": {
          "$ref": "#/$defs/ContextSchemaRef"
        },
        "source": {
          "$ref": "#/$defs/ContextSource"
        }
      },
      "required": [
        "source",
        "schema_ref",
        "field_path"
      ],
      "title": "ContextFieldSelector",
      "type": "object"
    },
    "ContextSchemaRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_kind": {
          "const": "context_schema",
          "title": "Artifact Kind",
          "type": "string"
        },
        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "schema_dialect": {
          "const": "https://json-schema.org/draft/2020-12/schema",
          "title": "Schema Dialect",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_kind",
        "artifact_id",
        "version",
        "digest",
        "schema_dialect"
      ],
      "title": "ContextSchemaRef",
      "type": "object"
    },
    "ContextSource": {
      "enum": [
        "context_snapshot",
        "region_metadata",
        "profile_metadata"
      ],
      "title": "ContextSource",
      "type": "string"
    },
    "Description": {
      "maxLength": 4096,
      "minLength": 1,
      "pattern": "\\S",
      "type": "string"
    },
    "EvaluatedApplicabilityLevel": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "truth": {
                "const": "true"
              }
            }
          },
          "then": {
            "properties": {
              "reason_code": {
                "enum": [
                  "included_by_policy"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "truth": {
                "const": "false"
              }
            }
          },
          "then": {
            "properties": {
              "reason_code": {
                "enum": [
                  "excluded_by_policy"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "truth": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "properties": {
              "reason_code": {
                "enum": [
                  "metadata_unknown",
                  "metadata_invalid"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "truth": {
                "const": "false"
              }
            }
          },
          "then": {
            "properties": {
              "reason_evidence_refs": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "truth": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "properties": {
              "validation_issues": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "level": {
                "const": "profile"
              }
            }
          },
          "then": {
            "properties": {
              "evaluation_owner": {
                "const": "pre_n02_gate"
              },
              "source_evaluation_ref": {
                "properties": {
                  "record_kind": {
                    "const": "profile_eligibility_evaluation"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "level": {
                "const": "rule_set"
              }
            }
          },
          "then": {
            "properties": {
              "evaluation_owner": {
                "const": "n06"
              },
              "source_evaluation_ref": {
                "properties": {
                  "record_kind": {
                    "const": "rule_set_applicability_evaluation"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "level": {
                "const": "rule"
              }
            }
          },
          "then": {
            "properties": {
              "evaluation_owner": {
                "const": "n06"
              },
              "source_evaluation_ref": {
                "properties": {
                  "record_kind": {
                    "const": "rule_applicability_evaluation"
                  }
                }
              }
            }
          }
        }
      ],
      "properties": {
        "declared_input_refs": {
          "items": {
            "$ref": "#/$defs/ContextFieldSelector"
          },
          "maxItems": 1024,
          "title": "Declared Input Refs",
          "type": "array",
          "uniqueItems": true
        },
        "evaluation_owner": {
          "$ref": "#/$defs/ApplicabilityEvaluationOwner"
        },
        "evaluation_status": {
          "const": "evaluated",
          "title": "Evaluation Status",
          "type": "string"
        },
        "level": {
          "$ref": "#/$defs/ApplicabilityLevel"
        },
        "policy_ref": {
          "$ref": "#/$defs/PolicyContentRef"
        },
        "reason_code": {
          "$ref": "#/$defs/ApplicabilityReason"
        },
        "reason_evidence_refs": {
          "items": {
            "$ref": "#/$defs/ApplicabilityReasonEvidenceRef"
          },
          "maxItems": 1024,
          "title": "Reason Evidence Refs",
          "type": "array",
          "uniqueItems": true
        },
        "source_evaluation_ref": {
          "$ref": "#/$defs/ApplicabilityEvaluationRef"
        },
        "target_ref": {
          "$ref": "#/$defs/ApplicabilityTargetRef"
        },
        "truth": {
          "$ref": "#/$defs/RuleTruth"
        },
        "validation_issues": {
          "items": {
            "$ref": "#/$defs/ValidationIssue"
          },
          "maxItems": 64,
          "title": "Validation Issues",
          "type": "array"
        }
      },
      "required": [
        "level",
        "target_ref",
        "policy_ref",
        "evaluation_status",
        "truth",
        "evaluation_owner",
        "source_evaluation_ref",
        "declared_input_refs",
        "reason_code",
        "reason_evidence_refs",
        "validation_issues"
      ],
      "title": "EvaluatedApplicabilityLevel",
      "type": "object"
    },
    "FieldName": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "IssueIndex": {
      "minimum": 0,
      "type": "integer"
    },
    "IssuePath": {
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/FieldName"
          },
          {
            "$ref": "#/$defs/IssueIndex"
          }
        ]
      },
      "maxItems": 32,
      "type": "array"
    },
    "NotEvaluatedApplicabilityLevel": {
      "additionalProperties": false,
      "allOf": [
        {
          "properties": {
            "level": {
              "not": {
                "const": "profile"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "level": {
                "const": "rule_set"
              }
            }
          },
          "then": {
            "properties": {
              "decisive_ancestor_ref": {
                "properties": {
                  "record_kind": {
                    "const": "profile_eligibility_evaluation"
                  }
                }
              }
            }
          }
        }
      ],
      "properties": {
        "decisive_ancestor_ref": {
          "$ref": "#/$defs/ApplicabilityAncestorRef"
        },
        "evaluation_status": {
          "const": "not_evaluated",
          "title": "Evaluation Status",
          "type": "string"
        },
        "level": {
          "$ref": "#/$defs/ApplicabilityLevel"
        },
        "policy_ref": {
          "$ref": "#/$defs/PolicyContentRef"
        },
        "reason_code": {
          "enum": [
            "ancestor_excluded",
            "ancestor_unresolved"
          ],
          "title": "Reason Code",
          "type": "string"
        },
        "target_ref": {
          "$ref": "#/$defs/ApplicabilityTargetRef"
        }
      },
      "required": [
        "level",
        "target_ref",
        "policy_ref",
        "evaluation_status",
        "reason_code",
        "decisive_ancestor_ref"
      ],
      "title": "NotEvaluatedApplicabilityLevel",
      "type": "object"
    },
    "PolicyContentRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_kind": {
          "const": "policy",
          "title": "Artifact Kind",
          "type": "string"
        },
        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_kind",
        "artifact_id",
        "version",
        "digest"
      ],
      "title": "PolicyContentRef",
      "type": "object"
    },
    "ProfileContentRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_kind": {
          "const": "profile",
          "title": "Artifact Kind",
          "type": "string"
        },
        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_kind",
        "artifact_id",
        "version",
        "digest"
      ],
      "title": "ProfileContentRef",
      "type": "object"
    },
    "ProfileEligibilityEvaluationRef": {
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Record Id",
          "type": "string"
        },
        "record_kind": {
          "const": "profile_eligibility_evaluation",
          "title": "Record Kind",
          "type": "string"
        }
      },
      "required": [
        "record_kind",
        "record_id"
      ],
      "title": "ProfileEligibilityEvaluationRef",
      "type": "object"
    },
    "RuleApplicabilityEvaluationRef": {
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Record Id",
          "type": "string"
        },
        "record_kind": {
          "const": "rule_applicability_evaluation",
          "title": "Record Kind",
          "type": "string"
        }
      },
      "required": [
        "record_kind",
        "record_id"
      ],
      "title": "RuleApplicabilityEvaluationRef",
      "type": "object"
    },
    "RuleContentRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_kind": {
          "const": "rule",
          "title": "Artifact Kind",
          "type": "string"
        },
        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_kind",
        "artifact_id",
        "version",
        "digest"
      ],
      "title": "RuleContentRef",
      "type": "object"
    },
    "RuleSetApplicabilityEvaluationRef": {
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Record Id",
          "type": "string"
        },
        "record_kind": {
          "const": "rule_set_applicability_evaluation",
          "title": "Record Kind",
          "type": "string"
        }
      },
      "required": [
        "record_kind",
        "record_id"
      ],
      "title": "RuleSetApplicabilityEvaluationRef",
      "type": "object"
    },
    "RuleSetContentRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_kind": {
          "const": "rule_set",
          "title": "Artifact Kind",
          "type": "string"
        },
        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_kind",
        "artifact_id",
        "version",
        "digest"
      ],
      "title": "RuleSetContentRef",
      "type": "object"
    },
    "RuleTruth": {
      "enum": [
        "true",
        "false",
        "unknown"
      ],
      "title": "RuleTruth",
      "type": "string"
    },
    "ValidationIssue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "$ref": "#/$defs/Description"
        },
        "path": {
          "$ref": "#/$defs/IssuePath"
        },
        "related_refs": {
          "items": {
            "$ref": "#/$defs/ContentRef"
          },
          "maxItems": 16,
          "title": "Related Refs",
          "type": "array"
        }
      },
      "required": [
        "code",
        "path",
        "message",
        "related_refs"
      ],
      "title": "ValidationIssue",
      "type": "object"
    },
    "_EvaluatedBranch": {
      "$ref": "#/$defs/EvaluatedApplicabilityLevel"
    },
    "_NotEvaluatedBranch": {
      "$ref": "#/$defs/NotEvaluatedApplicabilityLevel"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "$ref": "#/$defs/_EvaluatedBranch"
    },
    {
      "$ref": "#/$defs/_NotEvaluatedBranch"
    }
  ]
}
