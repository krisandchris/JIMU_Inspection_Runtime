{
  "$defs": {
    "BooleanValue": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "bool",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "BooleanValue",
      "type": "object"
    },
    "BoundedString": {
      "maxLength": 4096,
      "type": "string"
    },
    "CaptureClockSource": {
      "enum": [
        "device_clock",
        "server_clock",
        "external_reference"
      ],
      "title": "CaptureClockSource",
      "type": "string"
    },
    "CaptureTimezone": {
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9_+-]*(?:/[A-Za-z0-9_+-]+)*$(?![\\s\\S])",
      "type": "string"
    },
    "ClockProvenance": {
      "additionalProperties": false,
      "properties": {
        "captured_at": {
          "$ref": "#/$defs/UTCDateTime"
        },
        "clock_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Clock Id",
          "type": "string"
        },
        "original_timestamp": {
          "$ref": "#/$defs/OriginalCaptureTimestamp"
        },
        "original_timezone": {
          "anyOf": [
            {
              "$ref": "#/$defs/CaptureTimezone"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source": {
          "$ref": "#/$defs/CaptureClockSource"
        },
        "uncertainty_ms": {
          "anyOf": [
            {
              "$ref": "#/$defs/NonNegativeBudget"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "captured_at",
        "original_timestamp",
        "source",
        "clock_id"
      ],
      "title": "ClockProvenance",
      "type": "object"
    },
    "EnumValue": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "enum",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/BoundedString"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "EnumValue",
      "type": "object"
    },
    "FieldName": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "FiniteNumber": {
      "type": "number"
    },
    "IdempotencyScope": {
      "additionalProperties": false,
      "properties": {
        "client_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Client Id",
          "type": "string"
        },
        "project_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Project Id",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "client_id"
      ],
      "title": "IdempotencyScope",
      "type": "object"
    },
    "IntegerValue": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "integer",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "IntegerValue",
      "type": "object"
    },
    "ListValue": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "list",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "items": {
            "$ref": "#/$defs/Value"
          },
          "maxItems": 256,
          "title": "Value",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "ListValue",
      "type": "object"
    },
    "MediaRef": {
      "additionalProperties": false,
      "properties": {
        "media_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Media Id",
          "type": "string"
        },
        "sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "media_id",
        "sha256"
      ],
      "title": "MediaRef",
      "type": "object"
    },
    "NonNegativeBudget": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "type": "integer"
    },
    "NumberValue": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "number",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/FiniteNumber"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "NumberValue",
      "type": "object"
    },
    "OriginalCaptureTimestamp": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$(?![\\s\\S])",
      "type": "string"
    },
    "RecordValue": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "record",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "additionalProperties": {
            "$ref": "#/$defs/Value"
          },
          "maxProperties": 64,
          "propertyNames": {
            "$ref": "#/$defs/FieldName"
          },
          "title": "Value",
          "type": "object"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "RecordValue",
      "type": "object"
    },
    "ShortText": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "\\S",
      "type": "string"
    },
    "StringValue": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "string",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/BoundedString"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "StringValue",
      "type": "object"
    },
    "TaskContext": {
      "additionalProperties": false,
      "description": "Submitted identifiers and typed metadata carried into trusted intake.",
      "properties": {
        "camera_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Camera Id",
          "type": "string"
        },
        "clock": {
          "$ref": "#/$defs/ClockProvenance"
        },
        "device_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Device Id",
          "type": "string"
        },
        "metadata": {
          "$ref": "#/$defs/RecordValue"
        },
        "region_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Region Id",
          "type": "string"
        }
      },
      "required": [
        "device_id",
        "camera_id",
        "region_id",
        "clock",
        "metadata"
      ],
      "title": "TaskContext",
      "type": "object"
    },
    "TraceContext": {
      "additionalProperties": false,
      "properties": {
        "parent_span_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "not": {
                "pattern": "\\s"
              },
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Span Id"
        },
        "span_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "not": {
                "pattern": "\\s"
              },
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Span Id"
        },
        "trace_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Trace Id",
          "type": "string"
        }
      },
      "required": [
        "trace_id"
      ],
      "title": "TraceContext",
      "type": "object"
    },
    "UTCDateTime": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])[Tt](?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:[Zz]|\\+00:00)$(?![\\s\\S])",
      "type": "string"
    },
    "Value": {
      "discriminator": {
        "mapping": {
          "bool": "#/$defs/BooleanValue",
          "enum": "#/$defs/EnumValue",
          "integer": "#/$defs/IntegerValue",
          "list": "#/$defs/ListValue",
          "number": "#/$defs/NumberValue",
          "record": "#/$defs/RecordValue",
          "string": "#/$defs/StringValue"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/BooleanValue"
        },
        {
          "$ref": "#/$defs/IntegerValue"
        },
        {
          "$ref": "#/$defs/NumberValue"
        },
        {
          "$ref": "#/$defs/StringValue"
        },
        {
          "$ref": "#/$defs/EnumValue"
        },
        {
          "$ref": "#/$defs/ListValue"
        },
        {
          "$ref": "#/$defs/RecordValue"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "context": {
      "$ref": "#/$defs/TaskContext"
    },
    "idempotency_key": {
      "$ref": "#/$defs/ShortText"
    },
    "idempotency_scope": {
      "$ref": "#/$defs/IdempotencyScope"
    },
    "media_ref": {
      "$ref": "#/$defs/MediaRef"
    },
    "request_id": {
      "maxLength": 128,
      "minLength": 1,
      "not": {
        "pattern": "\\s"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Request Id",
      "type": "string"
    },
    "requested_release_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Requested Release Id"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "trace": {
      "$ref": "#/$defs/TraceContext"
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "idempotency_scope",
    "idempotency_key",
    "media_ref",
    "context",
    "trace"
  ],
  "title": "TaskSubmission",
  "type": "object"
}
