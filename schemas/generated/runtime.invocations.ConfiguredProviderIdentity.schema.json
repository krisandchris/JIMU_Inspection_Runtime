{
  "$defs": {
    "ModelBindingContentRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_kind": {
          "const": "model_binding",
          "title": "Artifact Kind",
          "type": "string"
        },
        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_kind",
        "artifact_id",
        "version",
        "digest"
      ],
      "title": "ModelBindingContentRef",
      "type": "object"
    },
    "PolicyContentRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_kind": {
          "const": "policy",
          "title": "Artifact Kind",
          "type": "string"
        },
        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_kind",
        "artifact_id",
        "version",
        "digest"
      ],
      "title": "PolicyContentRef",
      "type": "object"
    },
    "ProviderKind": {
      "enum": [
        "remote",
        "local"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "binding_ref": {
      "$ref": "#/$defs/ModelBindingContentRef"
    },
    "logical_model_id": {
      "maxLength": 128,
      "minLength": 1,
      "not": {
        "pattern": "\\s"
      },
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
      "title": "Logical Model Id",
      "type": "string"
    },
    "primary_deployment_id": {
      "maxLength": 128,
      "minLength": 1,
      "not": {
        "pattern": "\\s"
      },
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
      "title": "Primary Deployment Id",
      "type": "string"
    },
    "provider_id": {
      "maxLength": 128,
      "minLength": 1,
      "not": {
        "pattern": "\\s"
      },
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
      "title": "Provider Id",
      "type": "string"
    },
    "provider_kind": {
      "$ref": "#/$defs/ProviderKind"
    },
    "provider_policy_ref": {
      "$ref": "#/$defs/PolicyContentRef"
    }
  },
  "required": [
    "binding_ref",
    "provider_policy_ref",
    "primary_deployment_id",
    "provider_id",
    "provider_kind",
    "logical_model_id"
  ],
  "title": "ConfiguredProviderIdentity",
  "type": "object"
}
