{
  "$defs": {
    "AbsentOptional_PromptTemplateContentRef_": {
      "$ref": "#/$defs/PromptTemplateContentRef"
    },
    "ModelCapability": {
      "enum": [
        "profile_discovery",
        "object_grounding",
        "object_observation",
        "candidate_prediction",
        "vision_auxiliary"
      ],
      "title": "ModelCapability",
      "type": "string"
    },
    "PolicyContentRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_kind": {
          "const": "policy",
          "title": "Artifact Kind",
          "type": "string"
        },
        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_kind",
        "artifact_id",
        "version",
        "digest"
      ],
      "title": "PolicyContentRef",
      "type": "object"
    },
    "PromptTemplateContentRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_kind": {
          "const": "prompt_template",
          "title": "Artifact Kind",
          "type": "string"
        },
        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_kind",
        "artifact_id",
        "version",
        "digest"
      ],
      "title": "PromptTemplateContentRef",
      "type": "object"
    },
    "SchemaRef": {
      "additionalProperties": false,
      "description": "A constrained ContentRef, not a second schema identity system.",
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_kind": {
          "enum": [
            "fact_schema",
            "value_schema",
            "response_schema",
            "attribute_schema",
            "context_schema",
            "tool_input_schema",
            "tool_output_schema",
            "object_schema",
            "decision_schema"
          ],
          "title": "Artifact Kind",
          "type": "string"
        },
        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "schema_dialect": {
          "const": "https://json-schema.org/draft/2020-12/schema",
          "title": "Schema Dialect",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_kind",
        "artifact_id",
        "version",
        "digest",
        "schema_dialect"
      ],
      "title": "SchemaRef",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "capability": {
            "not": {
              "const": "vision_auxiliary"
            }
          }
        },
        "required": [
          "capability"
        ]
      },
      "then": {
        "required": [
          "prompt_template_ref"
        ]
      }
    }
  ],
  "properties": {
    "capability": {
      "$ref": "#/$defs/ModelCapability"
    },
    "fallback_policy_ref": {
      "$ref": "#/$defs/PolicyContentRef"
    },
    "input_schema_ref": {
      "$ref": "#/$defs/SchemaRef"
    },
    "logical_model_id": {
      "maxLength": 128,
      "minLength": 1,
      "not": {
        "pattern": "\\s"
      },
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
      "title": "Logical Model Id",
      "type": "string"
    },
    "model_binding_id": {
      "maxLength": 128,
      "minLength": 1,
      "not": {
        "pattern": "\\s"
      },
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
      "title": "Model Binding Id",
      "type": "string"
    },
    "output_schema_ref": {
      "$ref": "#/$defs/SchemaRef"
    },
    "prompt_template_ref": {
      "$ref": "#/$defs/AbsentOptional_PromptTemplateContentRef_"
    },
    "provider_policy_ref": {
      "$ref": "#/$defs/PolicyContentRef"
    },
    "resource_requirements_ref": {
      "$ref": "#/$defs/PolicyContentRef"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "version": {
      "maxLength": 128,
      "minLength": 5,
      "not": {
        "pattern": "\\s"
      },
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "model_binding_id",
    "version",
    "capability",
    "logical_model_id",
    "provider_policy_ref",
    "resource_requirements_ref",
    "fallback_policy_ref",
    "input_schema_ref",
    "output_schema_ref"
  ],
  "title": "ModelBinding",
  "type": "object"
}
