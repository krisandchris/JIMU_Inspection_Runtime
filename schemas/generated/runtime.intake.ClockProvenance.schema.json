{
  "$defs": {
    "CaptureClockSource": {
      "enum": [
        "device_clock",
        "server_clock",
        "external_reference"
      ],
      "title": "CaptureClockSource",
      "type": "string"
    },
    "CaptureTimezone": {
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9_+-]*(?:/[A-Za-z0-9_+-]+)*$(?![\\s\\S])",
      "type": "string"
    },
    "NonNegativeBudget": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "type": "integer"
    },
    "OriginalCaptureTimestamp": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$(?![\\s\\S])",
      "type": "string"
    },
    "UTCDateTime": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])[Tt](?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:[Zz]|\\+00:00)$(?![\\s\\S])",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "captured_at": {
      "$ref": "#/$defs/UTCDateTime"
    },
    "clock_id": {
      "maxLength": 128,
      "minLength": 1,
      "not": {
        "pattern": "\\s"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Clock Id",
      "type": "string"
    },
    "original_timestamp": {
      "$ref": "#/$defs/OriginalCaptureTimestamp"
    },
    "original_timezone": {
      "anyOf": [
        {
          "$ref": "#/$defs/CaptureTimezone"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "source": {
      "$ref": "#/$defs/CaptureClockSource"
    },
    "uncertainty_ms": {
      "anyOf": [
        {
          "$ref": "#/$defs/NonNegativeBudget"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "captured_at",
    "original_timestamp",
    "source",
    "clock_id"
  ],
  "title": "ClockProvenance",
  "type": "object"
}
