{
  "$defs": {
    "ObjectKey": {
      "maxLength": 1024,
      "minLength": 1,
      "pattern": "^(?!.*(?:^|/)[.]{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*(?![\\s\\S])",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "object_key": {
      "$ref": "#/$defs/ObjectKey"
    },
    "store_id": {
      "maxLength": 128,
      "minLength": 1,
      "not": {
        "pattern": "\\s"
      },
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
      "title": "Store Id",
      "type": "string"
    }
  },
  "required": [
    "store_id",
    "object_key"
  ],
  "title": "StorageReference",
  "type": "object"
}
