{
  "$defs": {
    "AbsentOptional_ReviewReportRef_": {
      "$ref": "#/$defs/ReviewReportRef"
    },
    "AttemptOwner": {
      "discriminator": {
        "mapping": {
          "node": "#/$defs/NodeAttemptOwner",
          "system": "#/$defs/SystemAttemptOwner"
        },
        "propertyName": "owner_kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/NodeAttemptOwner"
        },
        {
          "$ref": "#/$defs/SystemAttemptOwner"
        }
      ]
    },
    "AttemptStatus": {
      "enum": [
        "created",
        "running",
        "succeeded",
        "failed",
        "timed_out",
        "cancelled",
        "superseded"
      ],
      "title": "AttemptStatus",
      "type": "string"
    },
    "CapabilityFeature": {
      "enum": [
        "rgb_image",
        "typed_context",
        "structured_output",
        "original_xyxy",
        "mask_output",
        "geometry_output",
        "ocr_text"
      ],
      "title": "CapabilityFeature",
      "type": "string"
    },
    "LifecycleReason": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Code",
          "type": "string"
        },
        "detail": {
          "anyOf": [
            {
              "$ref": "#/$defs/ShortText"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "code"
      ],
      "title": "LifecycleReason",
      "type": "object"
    },
    "NodeAttemptOwner": {
      "additionalProperties": false,
      "properties": {
        "node_run_ref": {
          "$ref": "#/$defs/NodeRunRef"
        },
        "owner_kind": {
          "const": "node",
          "title": "Owner Kind",
          "type": "string"
        }
      },
      "required": [
        "owner_kind",
        "node_run_ref"
      ],
      "title": "NodeAttemptOwner",
      "type": "object"
    },
    "NodeRunRef": {
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Record Id",
          "type": "string"
        },
        "record_kind": {
          "const": "node_run",
          "title": "Record Kind",
          "type": "string"
        }
      },
      "required": [
        "record_kind",
        "record_id"
      ],
      "title": "NodeRunRef",
      "type": "object"
    },
    "PositiveBudget": {
      "maximum": 9223372036854775807,
      "minimum": 1,
      "type": "integer"
    },
    "ReviewReportRef": {
      "additionalProperties": false,
      "properties": {
        "report_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Report Id",
          "type": "string"
        },
        "review_registry_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Review Registry Id",
          "type": "string"
        },
        "sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "report_id",
        "version",
        "sha256",
        "review_registry_id"
      ],
      "title": "ReviewReportRef",
      "type": "object"
    },
    "ShortText": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "\\S",
      "type": "string"
    },
    "SystemAttemptOwner": {
      "additionalProperties": false,
      "properties": {
        "owner_kind": {
          "const": "system",
          "title": "Owner Kind",
          "type": "string"
        },
        "requirement": {
          "$ref": "#/$defs/SystemProducerRequirement"
        }
      },
      "required": [
        "owner_kind",
        "requirement"
      ],
      "title": "SystemAttemptOwner",
      "type": "object"
    },
    "SystemProducerRequirement": {
      "additionalProperties": false,
      "properties": {
        "allowed_implementation_versions": {
          "items": {
            "maxLength": 128,
            "minLength": 5,
            "not": {
              "pattern": "\\s"
            },
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
            "type": "string"
          },
          "maxItems": 1024,
          "minItems": 1,
          "title": "Allowed Implementation Versions",
          "type": "array",
          "uniqueItems": true
        },
        "capability_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Capability Id",
          "type": "string"
        },
        "contract_version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Contract Version",
          "type": "string"
        },
        "evaluation_ref": {
          "$ref": "#/$defs/AbsentOptional_ReviewReportRef_"
        },
        "family": {
          "const": "system_fact_producer",
          "title": "Family",
          "type": "string"
        },
        "required_features": {
          "items": {
            "$ref": "#/$defs/CapabilityFeature"
          },
          "maxItems": 7,
          "title": "Required Features",
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "family",
        "capability_id",
        "contract_version",
        "allowed_implementation_versions",
        "required_features"
      ],
      "title": "SystemProducerRequirement",
      "type": "object"
    },
    "UTCDateTime": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])[Tt](?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:[Zz]|\\+00:00)$(?![\\s\\S])",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attempt_id": {
      "maxLength": 128,
      "minLength": 1,
      "not": {
        "pattern": "\\s"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Attempt Id",
      "type": "string"
    },
    "attempt_number": {
      "$ref": "#/$defs/PositiveBudget"
    },
    "created_at": {
      "$ref": "#/$defs/UTCDateTime"
    },
    "ended_at": {
      "anyOf": [
        {
          "$ref": "#/$defs/UTCDateTime"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "execution_id": {
      "maxLength": 128,
      "minLength": 1,
      "not": {
        "pattern": "\\s"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Execution Id",
      "type": "string"
    },
    "owner": {
      "$ref": "#/$defs/AttemptOwner"
    },
    "reason": {
      "anyOf": [
        {
          "$ref": "#/$defs/LifecycleReason"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "started_at": {
      "anyOf": [
        {
          "$ref": "#/$defs/UTCDateTime"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "status": {
      "$ref": "#/$defs/AttemptStatus"
    }
  },
  "required": [
    "schema_version",
    "attempt_id",
    "execution_id",
    "owner",
    "attempt_number",
    "status",
    "created_at"
  ],
  "title": "Attempt",
  "type": "object"
}
