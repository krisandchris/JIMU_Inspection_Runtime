        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/LiteralExpr"
        },
        {
          "$ref": "#/$defs/FactRefExpr"
        },
        {
          "$ref": "#/$defs/RecordFieldRefExpr"
        },
        {
          "$ref": "#/$defs/ContextRefExpr"
        },
        {
          "$ref": "#/$defs/LocalToolFactRefExpr"
        },
        {
          "$ref": "#/$defs/ComparisonExpr"
        },
        {
          "$ref": "#/$defs/InExpr"
        },
        {
          "$ref": "#/$defs/AllExpr"
        },
        {
          "$ref": "#/$defs/AnyExpr"
        },
        {
          "$ref": "#/$defs/NotExpr"
        }
      ]
    },
    "ContextFieldSelector": {
      "additionalProperties": false,
      "properties": {
        "field_path": {
          "items": {
            "$ref": "#/$defs/FieldName"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Field Path",
          "type": "array"
        },
        "schema_ref": {
          "$ref": "#/$defs/ContextSchemaRef"
        },
        "source": {
          "$ref": "#/$defs/ContextSource"
        }
      },
      "required": [
        "source",
        "schema_ref",
        "field_path"
      ],
      "title": "ContextFieldSelector",
      "type": "object"
    },
    "ContextRefExpr": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "context_ref",
          "title": "Kind",
          "type": "string"
        },
        "selector": {
          "$ref": "#/$defs/ContextFieldSelector"
        }
      },
      "required": [
        "kind",
        "selector"
      ],
      "title": "ContextRefExpr",
      "type": "object"
    },
    "ContextSchemaRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_kind": {
          "const": "context_schema",
          "title": "Artifact Kind",
          "type": "string"
        },
        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "schema_dialect": {
          "const": "https://json-schema.org/draft/2020-12/schema",
          "title": "Schema Dialect",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_kind",
        "artifact_id",
        "version",
        "digest",
        "schema_dialect"
      ],
      "title": "ContextSchemaRef",
      "type": "object"
    },
    "ContextSource": {
      "enum": [
        "context_snapshot",
        "region_metadata",
        "profile_metadata"
      ],
