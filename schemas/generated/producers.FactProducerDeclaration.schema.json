      "type": "string"
    },
    "Description": {
      "maxLength": 4096,
      "minLength": 1,
      "pattern": "\\S",
      "type": "string"
    },
    "EnumTypeDefinition": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "enum",
          "title": "Kind",
          "type": "string"
        },
        "members": {
          "items": {
            "$ref": "#/$defs/BoundedString"
