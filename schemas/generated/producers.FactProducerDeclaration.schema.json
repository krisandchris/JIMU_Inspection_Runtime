    "FactSelector": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "scope": {
                "const": "execution"
              }
            },
            "required": [
              "scope"
            ]
          },
          "then": {
            "properties": {
              "producer_selector": {
                "properties": {
                  "producer_kind": {
                    "const": "system"
                  }
                }
              }
            }
          }
        }
      ],
      "properties": {
        "fact_key": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Fact Key",
          "type": "string"
        },
        "fact_schema_ref": {
          "$ref": "#/$defs/FactSchemaContentRef"
        },
        "field_path": {
          "$ref": "#/$defs/FieldPath"
        },
        "producer_selector": {
          "$ref": "#/$defs/ProducerSelector"
        },
        "scope": {
          "$ref": "#/$defs/FactScope"
        }
      },
      "required": [
        "scope",
        "fact_key",
        "fact_schema_ref",
        "producer_selector",
        "field_path"
