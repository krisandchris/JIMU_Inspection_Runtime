      "title": "AnyExpr",
      "type": "object"
    },
    "BooleanTypeDefinition": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "bool",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "BooleanTypeDefinition",
      "type": "object"
    },
    "BooleanValue": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "bool",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "BooleanValue",
      "type": "object"
    },
    "BoundedString": {
      "maxLength": 4096,
      "type": "string"
    },
    "CapabilityFeature": {
      "enum": [
        "rgb_image",
        "typed_context",
        "structured_output",
        "original_xyxy",
        "mask_output",
        "geometry_output",
        "ocr_text"
      ],
