    "FiniteNumber": {
      "type": "number"
    },
    "InExpr": {
      "additionalProperties": false,
      "properties": {
        "collection": {
          "$ref": "#/$defs/ConditionExpr"
        },
        "item": {
          "$ref": "#/$defs/ConditionExpr"
        },
        "kind": {
          "const": "in",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "item",
        "collection"
      ],
      "title": "InExpr",
      "type": "object"
    },
    "IntegerTypeDefinition": {
      "additionalProperties": false,
