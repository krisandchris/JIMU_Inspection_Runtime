    "ActivationCondition": {
      "discriminator": {
        "mapping": {
          "always": "#/$defs/AlwaysActivation",
          "tool_condition": "#/$defs/ToolConditionActivation"
        },
        "propertyName": "mode"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/AlwaysActivation"
        },
        {
          "$ref": "#/$defs/ToolConditionActivation"
        }
      ]
    },
    "AllExpr": {
      "additionalProperties": false,
      "properties": {
        "arguments": {
          "items": {
            "$ref": "#/$defs/ConditionExpr"
