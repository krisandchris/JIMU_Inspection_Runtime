    "ComparisonExpr": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "comparison",
          "title": "Kind",
          "type": "string"
        },
        "left": {
          "$ref": "#/$defs/ConditionExpr"
        },
        "operator": {
          "$ref": "#/$defs/ComparisonOperator"
        },
        "right": {
          "$ref": "#/$defs/ConditionExpr"
        }
      },
      "required": [
        "kind",
        "operator",
        "left",
        "right"
      ],
      "title": "ComparisonExpr",
      "type": "object"
    },
    "ComparisonOperator": {
      "enum": [
        "eq",
        "ne",
        "lt",
        "le",
        "gt",
        "ge"
      ],
      "title": "ComparisonOperator",
      "type": "string"
    },
    "ConditionExpr": {
      "discriminator": {
        "mapping": {
          "all": "#/$defs/AllExpr",
          "any": "#/$defs/AnyExpr",
          "comparison": "#/$defs/ComparisonExpr",
          "context_ref": "#/$defs/ContextRefExpr",
          "fact_ref": "#/$defs/FactRefExpr",
          "in": "#/$defs/InExpr",
          "literal": "#/$defs/LiteralExpr",
