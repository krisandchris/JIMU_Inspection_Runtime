          "type": "string"
        }
      },
      "required": [
        "mode"
      ],
      "title": "AlwaysActivation",
      "type": "object"
    },
    "AnyExpr": {
      "additionalProperties": false,
      "properties": {
        "arguments": {
          "items": {
            "$ref": "#/$defs/ConditionExpr"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Arguments",
          "type": "array"
        },
        "kind": {
          "const": "any",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "arguments"
