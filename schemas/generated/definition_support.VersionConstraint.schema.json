{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "allowed_deployment_versions": {
      "items": {
        "maxLength": 128,
        "minLength": 5,
        "not": {
          "pattern": "\\s"
        },
        "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
        "type": "string"
      },
      "maxItems": 1024,
      "minItems": 1,
      "title": "Allowed Deployment Versions",
      "type": "array",
      "uniqueItems": true
    },
    "allowed_model_versions": {
      "items": {
        "maxLength": 128,
        "minLength": 5,
        "not": {
          "pattern": "\\s"
        },
        "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
        "type": "string"
      },
      "maxItems": 1024,
      "minItems": 1,
      "title": "Allowed Model Versions",
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "allowed_deployment_versions",
    "allowed_model_versions"
  ],
  "title": "VersionConstraint",
  "type": "object"
}
