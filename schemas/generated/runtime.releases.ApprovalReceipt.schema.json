{
  "$defs": {
    "ActorRef": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Actor Id",
          "type": "string"
        },
        "actor_kind": {
          "enum": [
            "service",
            "human"
          ],
          "title": "Actor Kind",
          "type": "string"
        },
        "identity_registry_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Identity Registry Id",
          "type": "string"
        }
      },
      "required": [
        "actor_kind",
        "actor_id",
        "identity_registry_id"
      ],
      "title": "ActorRef",
      "type": "object"
    },
    "BundleRef": {
      "additionalProperties": false,
      "description": "Identity of one immutable logical Bundle, separate from artifact references.",
      "properties": {
        "bundle_digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Bundle Digest",
          "type": "string"
        },
        "bundle_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Bundle Id",
          "type": "string"
        },
        "bundle_version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Bundle Version",
          "type": "string"
        }
      },
      "required": [
        "bundle_id",
        "bundle_version",
        "bundle_digest"
      ],
      "title": "BundleRef",
      "type": "object"
    },
    "ReleaseRef": {
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Record Id",
          "type": "string"
        },
        "record_kind": {
          "const": "release",
          "title": "Record Kind",
          "type": "string"
        }
      },
      "required": [
        "record_kind",
        "record_id"
      ],
      "title": "ReleaseRef",
      "type": "object"
    },
    "UTCDateTime": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])[Tt](?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:[Zz]|\\+00:00)$(?![\\s\\S])",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Evidence of business approval for one Release and its admission receipt.",
  "properties": {
    "admission_receipt_id": {
      "maxLength": 128,
      "minLength": 1,
      "not": {
        "pattern": "\\s"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Admission Receipt Id",
      "type": "string"
    },
    "approved_at": {
      "$ref": "#/$defs/UTCDateTime"
    },
    "approved_by": {
      "$ref": "#/$defs/ActorRef"
    },
    "bundle_ref": {
      "$ref": "#/$defs/BundleRef"
    },
    "receipt_id": {
      "maxLength": 128,
      "minLength": 1,
      "not": {
        "pattern": "\\s"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Receipt Id",
      "type": "string"
    },
    "release_ref": {
      "$ref": "#/$defs/ReleaseRef"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "receipt_id",
    "release_ref",
    "bundle_ref",
    "admission_receipt_id",
    "approved_by",
    "approved_at"
  ],
  "title": "ApprovalReceipt",
  "type": "object"
}
