{
  "$defs": {
    "DeviceActivationScope": {
      "additionalProperties": false,
      "properties": {
        "device_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Device Id",
          "type": "string"
        },
        "scope": {
          "const": "device",
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "scope",
        "device_id"
      ],
      "title": "DeviceActivationScope",
      "type": "object"
    },
    "GlobalActivationScope": {
      "additionalProperties": false,
      "properties": {
        "scope": {
          "const": "global",
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "scope"
      ],
      "title": "GlobalActivationScope",
      "type": "object"
    },
    "RegionActivationScope": {
      "additionalProperties": false,
      "properties": {
        "region_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Region Id",
          "type": "string"
        },
        "scope": {
          "const": "region",
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "scope",
        "region_id"
      ],
      "title": "RegionActivationScope",
      "type": "object"
    },
    "SceneActivationScope": {
      "additionalProperties": false,
      "properties": {
        "scene_type": {
          "$ref": "#/$defs/VocabularyMemberRef"
        },
        "scope": {
          "const": "scene",
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "scope",
        "scene_type"
      ],
      "title": "SceneActivationScope",
      "type": "object"
    },
    "ShortText": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "\\S",
      "type": "string"
    },
    "VocabularyContentRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_kind": {
          "const": "vocabulary",
          "title": "Artifact Kind",
          "type": "string"
        },
        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_kind",
        "artifact_id",
        "version",
        "digest"
      ],
      "title": "VocabularyContentRef",
      "type": "object"
    },
    "VocabularyMemberRef": {
      "additionalProperties": false,
      "properties": {
        "member": {
          "$ref": "#/$defs/ShortText"
        },
        "vocabulary_ref": {
          "$ref": "#/$defs/VocabularyContentRef"
        }
      },
      "required": [
        "vocabulary_ref",
        "member"
      ],
      "title": "VocabularyMemberRef",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "discriminator": {
    "mapping": {
      "device": "#/$defs/DeviceActivationScope",
      "global": "#/$defs/GlobalActivationScope",
      "region": "#/$defs/RegionActivationScope",
      "scene": "#/$defs/SceneActivationScope"
    },
    "propertyName": "scope"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/GlobalActivationScope"
    },
    {
      "$ref": "#/$defs/SceneActivationScope"
    },
    {
      "$ref": "#/$defs/RegionActivationScope"
    },
    {
      "$ref": "#/$defs/DeviceActivationScope"
    }
  ]
}
