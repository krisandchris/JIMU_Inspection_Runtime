{
  "$defs": {
    "AttemptLink": {
      "additionalProperties": false,
      "properties": {
        "attempt_number": {
          "$ref": "#/$defs/PositiveBudget"
        },
        "attempt_ref": {
          "$ref": "#/$defs/AttemptRef"
        }
      },
      "required": [
        "attempt_ref",
        "attempt_number"
      ],
      "title": "AttemptLink",
      "type": "object"
    },
    "AttemptRef": {
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Record Id",
          "type": "string"
        },
        "record_kind": {
          "const": "attempt",
          "title": "Record Kind",
          "type": "string"
        }
      },
      "required": [
        "record_kind",
        "record_id"
      ],
      "title": "AttemptRef",
      "type": "object"
    },
    "LifecycleReason": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Code",
          "type": "string"
        },
        "detail": {
          "anyOf": [
            {
              "$ref": "#/$defs/ShortText"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "code"
      ],
      "title": "LifecycleReason",
      "type": "object"
    },
    "NodeId": {
      "enum": [
        "N01",
        "N02",
        "N03",
        "N04",
        "N05",
        "N06"
      ],
      "title": "NodeId",
      "type": "string"
    },
    "NodeRunRef": {
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Record Id",
          "type": "string"
        },
        "record_kind": {
          "const": "node_run",
          "title": "Record Kind",
          "type": "string"
        }
      },
      "required": [
        "record_kind",
        "record_id"
      ],
      "title": "NodeRunRef",
      "type": "object"
    },
    "NodeRunStatus": {
      "enum": [
        "pending",
        "ready",
        "running",
        "succeeded",
        "failed",
        "blocked",
        "skipped",
        "cancelled"
      ],
      "title": "NodeRunStatus",
      "type": "string"
    },
    "PinnedRuntimeInput": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "ref": {
          "$ref": "#/$defs/RuntimeRecordRef"
        }
      },
      "required": [
        "ref",
        "digest"
      ],
      "title": "PinnedRuntimeInput",
      "type": "object"
    },
    "PolicyContentRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_kind": {
          "const": "policy",
          "title": "Artifact Kind",
          "type": "string"
        },
        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_kind",
        "artifact_id",
        "version",
        "digest"
      ],
      "title": "PolicyContentRef",
      "type": "object"
    },
    "PositiveBudget": {
      "maximum": 9223372036854775807,
      "minimum": 1,
      "type": "integer"
    },
    "RuntimeRecordKind": {
      "enum": [
        "task",
        "execution",
        "node_run",
        "attempt",
        "object",
        "fact",
        "evidence",
        "tool_execution",
        "model_invocation",
        "decision",
        "release",
        "activation",
        "context_snapshot",
        "grounding_record",
        "question_selection_record",
        "authoritative_result_selection",
        "execution_coverage",
        "profile_eligibility_evaluation",
        "rule_set_applicability_evaluation",
        "rule_applicability_evaluation",
        "applicability_trace",
        "unresolved_obligation",
        "replay_run",
        "execution_event",
        "candidate_prediction",
        "observation_batch"
      ],
      "title": "RuntimeRecordKind",
      "type": "string"
    },
    "RuntimeRecordRef": {
      "additionalProperties": false,
      "description": "Record identity, interpreted within its owning root's pinned scope.\n\nIn particular an Object ID is Execution-local: this nested ref must not be\nresolved globally or reused across Executions. Scope/existence checks belong\nto the later owning record contracts, not a hidden resolver in this model.",
      "properties": {
        "record_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Record Id",
          "type": "string"
        },
        "record_kind": {
          "$ref": "#/$defs/RuntimeRecordKind"
        }
      },
      "required": [
        "record_kind",
        "record_id"
      ],
      "title": "RuntimeRecordRef",
      "type": "object"
    },
    "ShortText": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "\\S",
      "type": "string"
    },
    "TraceContext": {
      "additionalProperties": false,
      "properties": {
        "parent_span_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "not": {
                "pattern": "\\s"
              },
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Span Id"
        },
        "span_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "not": {
                "pattern": "\\s"
              },
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Span Id"
        },
        "trace_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Trace Id",
          "type": "string"
        }
      },
      "required": [
        "trace_id"
      ],
      "title": "TraceContext",
      "type": "object"
    },
    "UTCDateTime": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])[Tt](?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:[Zz]|\\+00:00)$(?![\\s\\S])",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "if": {
    "properties": {
      "node_id": {
        "not": {
          "const": "N05"
        }
      }
    }
  },
  "properties": {
    "attempt_history": {
      "items": {
        "$ref": "#/$defs/AttemptLink"
      },
      "maxItems": 1025,
      "title": "Attempt History",
      "type": "array"
    },
    "config_ref": {
      "$ref": "#/$defs/PolicyContentRef"
    },
    "created_at": {
      "$ref": "#/$defs/UTCDateTime"
    },
    "ended_at": {
      "anyOf": [
        {
          "$ref": "#/$defs/UTCDateTime"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "execution_id": {
      "maxLength": 128,
      "minLength": 1,
      "not": {
        "pattern": "\\s"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Execution Id",
      "type": "string"
    },
    "input_digest": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Digest",
      "type": "string"
    },
    "node_id": {
      "$ref": "#/$defs/NodeId"
    },
    "node_run_id": {
      "maxLength": 128,
      "minLength": 1,
      "not": {
        "pattern": "\\s"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Node Run Id",
      "type": "string"
    },
    "output_refs": {
      "items": {
        "$ref": "#/$defs/RuntimeRecordRef"
      },
      "maxItems": 16384,
      "title": "Output Refs",
      "type": "array",
      "uniqueItems": true
    },
    "predecessor_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/NodeRunRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "reason": {
      "anyOf": [
        {
          "$ref": "#/$defs/LifecycleReason"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "started_at": {
      "anyOf": [
        {
          "$ref": "#/$defs/UTCDateTime"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "status": {
      "$ref": "#/$defs/NodeRunStatus"
    },
    "trace": {
      "$ref": "#/$defs/TraceContext"
    },
    "upstream_inputs": {
      "items": {
        "$ref": "#/$defs/PinnedRuntimeInput"
      },
      "maxItems": 1024,
      "title": "Upstream Inputs",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "node_run_id",
    "execution_id",
    "node_id",
    "trace",
    "config_ref",
    "upstream_inputs",
    "input_digest",
    "status",
    "created_at",
    "attempt_history",
    "output_refs"
  ],
  "then": {
    "properties": {
      "attempt_history": {
        "maxItems": 1024
      }
    }
  },
  "title": "NodeRun",
  "type": "object"
}
