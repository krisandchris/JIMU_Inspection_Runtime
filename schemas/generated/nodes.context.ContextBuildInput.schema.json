{
  "$defs": {
    "AcceptedTask": {
      "additionalProperties": false,
      "description": "Immutable accepted intake, recording the resolved Release and Bundle.",
      "properties": {
        "accepted_at": {
          "$ref": "#/$defs/UTCDateTime"
        },
        "bundle_digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Bundle Digest",
          "type": "string"
        },
        "context": {
          "$ref": "#/$defs/TaskContext"
        },
        "idempotency_key": {
          "$ref": "#/$defs/ShortText"
        },
        "idempotency_scope": {
          "$ref": "#/$defs/IdempotencyScope"
        },
        "media_ref": {
          "$ref": "#/$defs/MediaRef"
        },
        "release_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Release Id",
          "type": "string"
        },
        "request_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Request Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "const": "accepted",
          "title": "Status",
          "type": "string"
        },
        "task_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Task Id",
          "type": "string"
        },
        "trace": {
          "$ref": "#/$defs/TraceContext"
        }
      },
      "required": [
        "schema_version",
        "task_id",
        "request_id",
        "idempotency_scope",
        "idempotency_key",
        "media_ref",
        "context",
        "release_id",
        "bundle_digest",
        "accepted_at",
        "status",
        "trace"
      ],
      "title": "AcceptedTask",
      "type": "object"
    },
    "ArtifactKind": {
      "enum": [
        "entity",
        "region",
        "profile",
        "facet",
        "question",
        "tool",
        "tool_plan",
        "rule",
        "rule_set",
        "model_binding",
        "fact_schema",
        "prompt_template",
        "response_schema",
        "attribute_schema",
        "context_schema",
        "tool_input_schema",
        "tool_output_schema",
        "object_schema",
        "decision_schema",
        "value_schema",
        "policy",
        "vocabulary",
        "geometry_resource",
        "static_asset",
        "fact_producer_catalog"
      ],
      "title": "ArtifactKind",
      "type": "string"
    },
    "AssetDimensions": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "$ref": "#/$defs/PositiveBudget"
        },
        "width": {
          "$ref": "#/$defs/PositiveBudget"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "title": "AssetDimensions",
      "type": "object"
    },
    "AssetStage": {
      "discriminator": {
        "mapping": {
          "finalized": "#/$defs/FinalizedAsset",
          "staged": "#/$defs/StagedAsset"
        },
        "propertyName": "stage"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/StagedAsset"
        },
        {
          "$ref": "#/$defs/FinalizedAsset"
        }
      ]
    },
    "BooleanValue": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "bool",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "BooleanValue",
      "type": "object"
    },
    "BoundedString": {
      "maxLength": 4096,
      "type": "string"
    },
    "CaptureClockSource": {
      "enum": [
        "device_clock",
        "server_clock",
        "external_reference"
      ],
      "title": "CaptureClockSource",
      "type": "string"
    },
    "CaptureTimezone": {
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9_+-]*(?:/[A-Za-z0-9_+-]+)*$(?![\\s\\S])",
      "type": "string"
    },
    "ClockProvenance": {
      "additionalProperties": false,
      "properties": {
        "captured_at": {
          "$ref": "#/$defs/UTCDateTime"
        },
        "clock_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Clock Id",
          "type": "string"
        },
        "original_timestamp": {
          "$ref": "#/$defs/OriginalCaptureTimestamp"
        },
        "original_timezone": {
          "anyOf": [
            {
              "$ref": "#/$defs/CaptureTimezone"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source": {
          "$ref": "#/$defs/CaptureClockSource"
        },
        "uncertainty_ms": {
          "anyOf": [
            {
              "$ref": "#/$defs/NonNegativeBudget"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "captured_at",
        "original_timestamp",
        "source",
        "clock_id"
      ],
      "title": "ClockProvenance",
      "type": "object"
    },
    "ContentRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_kind",
        "artifact_id",
        "version",
        "digest"
      ],
      "title": "ContentRef",
      "type": "object"
    },
    "ContextSchemaRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_kind": {
          "const": "context_schema",
          "title": "Artifact Kind",
          "type": "string"
        },
        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "schema_dialect": {
          "const": "https://json-schema.org/draft/2020-12/schema",
          "title": "Schema Dialect",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_kind",
        "artifact_id",
        "version",
        "digest",
        "schema_dialect"
      ],
      "title": "ContextSchemaRef",
      "type": "object"
    },
    "EnumValue": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "enum",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/BoundedString"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "EnumValue",
      "type": "object"
    },
    "FieldName": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "FinalizedAsset": {
      "additionalProperties": false,
      "properties": {
        "object_version": {
          "$ref": "#/$defs/ShortText"
        },
        "stage": {
          "const": "finalized",
          "title": "Stage",
          "type": "string"
        },
        "staged_at": {
          "$ref": "#/$defs/UTCDateTime"
        },
        "verified_at": {
          "$ref": "#/$defs/UTCDateTime"
        },
        "verified_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Verified Sha256",
          "type": "string"
        }
      },
      "required": [
        "stage",
        "staged_at",
        "verified_at",
        "verified_sha256",
        "object_version"
      ],
      "title": "FinalizedAsset",
      "type": "object"
    },
    "FiniteNumber": {
      "type": "number"
    },
    "IdempotencyScope": {
      "additionalProperties": false,
