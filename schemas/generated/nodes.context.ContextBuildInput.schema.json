            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Project Id",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "client_id"
      ],
      "title": "IdempotencyScope",
      "type": "object"
    },
    "ImageMimeType": {
      "maxLength": 128,
      "pattern": "^image/[a-z0-9][a-z0-9.+-]*$",
      "type": "string"
    },
    "IntegerValue": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "integer",
