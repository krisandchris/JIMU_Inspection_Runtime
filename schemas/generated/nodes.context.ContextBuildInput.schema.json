        "color_space": {
          "const": "RGB",
          "title": "Color Space",
          "type": "string"
        },
        "dimensions": {
          "$ref": "#/$defs/AssetDimensions"
        },
        "media_ref": {
          "$ref": "#/$defs/MediaRef"
        },
        "mime_type": {
          "$ref": "#/$defs/ImageMimeType"
        },
        "schema_version": {
          "const": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "stage": {
          "$ref": "#/$defs/AssetStage"
        },
        "storage": {
          "$ref": "#/$defs/StorageReference"
        }
