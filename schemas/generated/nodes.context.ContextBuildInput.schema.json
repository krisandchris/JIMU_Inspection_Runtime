    "NonNegativeBudget": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "type": "integer"
    },
    "NumberValue": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "number",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/FiniteNumber"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "NumberValue",
      "type": "object"
    },
    "ObjectKey": {
      "maxLength": 1024,
      "minLength": 1,
      "pattern": "^(?!.*(?:^|/)[.]{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*(?![\\s\\S])",
      "type": "string"
    },
    "OriginalCaptureTimestamp": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$(?![\\s\\S])",
      "type": "string"
    },
    "PinnedRuntimeInput": {
      "additionalProperties": false,
