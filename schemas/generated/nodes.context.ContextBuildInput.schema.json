    "RuntimeRecordRef": {
      "additionalProperties": false,
      "description": "Record identity, interpreted within its owning root's pinned scope.\n\nIn particular an Object ID is Execution-local: this nested ref must not be\nresolved globally or reused across Executions. Scope/existence checks belong\nto the later owning record contracts, not a hidden resolver in this model.",
      "properties": {
        "record_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Record Id",
          "type": "string"
        },
        "record_kind": {
          "$ref": "#/$defs/RuntimeRecordKind"
        }
      },
      "required": [
        "record_kind",
        "record_id"
      ],
      "title": "RuntimeRecordRef",
      "type": "object"
    },
    "ShortText": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "\\S",
      "type": "string"
    },
    "StagedAsset": {
      "additionalProperties": false,
      "properties": {
        "stage": {
          "const": "staged",
          "title": "Stage",
          "type": "string"
        },
        "staged_at": {
          "$ref": "#/$defs/UTCDateTime"
        }
      },
      "required": [
        "stage",
        "staged_at"
      ],
      "title": "StagedAsset",
      "type": "object"
    },
    "StorageReference": {
      "additionalProperties": false,
      "properties": {
        "object_key": {
          "$ref": "#/$defs/ObjectKey"
        },
        "store_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Store Id",
          "type": "string"
        }
      },
      "required": [
        "store_id",
        "object_key"
      ],
      "title": "StorageReference",
      "type": "object"
    },
    "StringValue": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "string",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/BoundedString"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "StringValue",
      "type": "object"
    },
    "TaskContext": {
      "additionalProperties": false,
      "description": "Submitted identifiers and typed metadata carried into trusted intake.",
      "properties": {
        "camera_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Camera Id",
          "type": "string"
        },
        "clock": {
          "$ref": "#/$defs/ClockProvenance"
        },
        "device_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Device Id",
          "type": "string"
        },
        "metadata": {
          "$ref": "#/$defs/RecordValue"
        },
        "region_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Region Id",
          "type": "string"
        }
      },
      "required": [
        "device_id",
        "camera_id",
        "region_id",
        "clock",
        "metadata"
      ],
      "title": "TaskContext",
      "type": "object"
    },
    "TraceContext": {
      "additionalProperties": false,
      "properties": {
        "parent_span_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "not": {
                "pattern": "\\s"
              },
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Span Id"
        },
        "span_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "not": {
                "pattern": "\\s"
              },
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Span Id"
        },
        "trace_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Trace Id",
          "type": "string"
        }
      },
      "required": [
        "trace_id"
      ],
      "title": "TraceContext",
      "type": "object"
    },
    "UTCDateTime": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])[Tt](?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:[Zz]|\\+00:00)$(?![\\s\\S])",
      "type": "string"
    },
    "Value": {
      "discriminator": {
        "mapping": {
          "bool": "#/$defs/BooleanValue",
          "enum": "#/$defs/EnumValue",
          "integer": "#/$defs/IntegerValue",
          "list": "#/$defs/ListValue",
          "number": "#/$defs/NumberValue",
          "record": "#/$defs/RecordValue",
          "string": "#/$defs/StringValue"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/BooleanValue"
        },
        {
          "$ref": "#/$defs/IntegerValue"
        },
        {
          "$ref": "#/$defs/NumberValue"
        },
        {
          "$ref": "#/$defs/StringValue"
        },
        {
          "$ref": "#/$defs/EnumValue"
        },
        {
          "$ref": "#/$defs/ListValue"
        },
        {
          "$ref": "#/$defs/RecordValue"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "accepted_task": {
      "$ref": "#/$defs/AcceptedTask"
    },
    "camera_ref": {
      "$ref": "#/$defs/RegistryRecordRef"
    },
    "context_provenance_policy_ref": {
      "$ref": "#/$defs/PolicyContentRef"
    },
    "context_schema_ref": {
      "$ref": "#/$defs/ContextSchemaRef"
    },
    "device_ref": {
      "$ref": "#/$defs/RegistryRecordRef"
    },
    "envelope": {
      "$ref": "#/$defs/NodeInputEnvelope"
    },
    "media_asset": {
      "$ref": "#/$defs/MediaAsset"
    },
    "region_ref": {
      "$ref": "#/$defs/RegionContentRef"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "envelope",
    "accepted_task",
    "media_asset",
    "device_ref",
    "camera_ref",
    "region_ref",
    "context_schema_ref",
    "context_provenance_policy_ref"
  ],
  "title": "ContextBuildInput",
  "type": "object"
}
