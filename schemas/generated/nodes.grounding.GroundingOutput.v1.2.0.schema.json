{
  "$defs": {
    "ArtifactKind": {
      "enum": [
        "entity",
        "region",
        "profile",
        "facet",
        "question",
        "tool",
        "tool_plan",
        "rule",
        "rule_set",
        "model_binding",
        "fact_schema",
        "prompt_template",
        "response_schema",
        "attribute_schema",
        "context_schema",
        "tool_input_schema",
        "tool_output_schema",
        "object_schema",
        "decision_schema",
        "value_schema",
        "policy",
        "vocabulary",
        "geometry_resource",
        "static_asset",
        "fact_producer_catalog"
      ],
      "title": "ArtifactKind",
      "type": "string"
    },
    "ArtifactOutputRef": {
      "additionalProperties": false,
      "description": "Immutable reference and digest of an emitted runtime artifact.",
      "properties": {
        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "ref": {
          "$ref": "#/$defs/RuntimeRecordRef"
        }
      },
      "required": [
        "ref",
        "digest"
      ],
      "title": "ArtifactOutputRef",
      "type": "object"
    },
    "CancelledNodeOutput": {
      "additionalProperties": false,
      "properties": {
        "attempt_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Attempt Id",
          "type": "string"
        },
        "duration_ms": {
          "$ref": "#/$defs/NonNegativeBudget"
        },
        "error": {
          "$ref": "#/$defs/NodeError"
        },
        "finished_at": {
          "$ref": "#/$defs/UTCDateTime"
        },
        "node_id": {
          "$ref": "#/$defs/NodeId"
        },
        "node_run_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Node Run Id",
          "type": "string"
        },
        "output_artifacts": {
          "$ref": "#/$defs/NodeOutputs"
        },
        "schema_version": {
          "const": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "started_at": {
          "$ref": "#/$defs/UTCDateTime"
        },
        "status": {
          "const": "cancelled",
          "title": "Status",
          "type": "string"
        },
        "trace": {
          "$ref": "#/$defs/TraceContext"
        }
      },
      "required": [
        "schema_version",
        "node_id",
        "node_run_id",
        "attempt_id",
        "trace",
        "output_artifacts",
        "started_at",
        "finished_at",
        "duration_ms",
        "status",
        "error"
      ],
      "title": "CancelledNodeOutput",
      "type": "object"
    },
    "ContentRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_kind",
        "artifact_id",
        "version",
        "digest"
      ],
      "title": "ContentRef",
      "type": "object"
    },
    "Description": {
      "maxLength": 4096,
      "minLength": 1,
      "pattern": "\\S",
      "type": "string"
    },
    "FailedNodeOutput": {
      "additionalProperties": false,
      "properties": {
        "attempt_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Attempt Id",
          "type": "string"
        },
        "duration_ms": {
          "$ref": "#/$defs/NonNegativeBudget"
        },
        "error": {
          "$ref": "#/$defs/NodeError"
        },
        "finished_at": {
          "$ref": "#/$defs/UTCDateTime"
        },
        "node_id": {
          "$ref": "#/$defs/NodeId"
        },
        "node_run_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Node Run Id",
          "type": "string"
        },
        "output_artifacts": {
          "$ref": "#/$defs/NodeOutputs"
        },
        "schema_version": {
          "const": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "started_at": {
          "$ref": "#/$defs/UTCDateTime"
        },
        "status": {
          "const": "failed",
          "title": "Status",
          "type": "string"
        },
        "trace": {
          "$ref": "#/$defs/TraceContext"
        }
      },
      "required": [
        "schema_version",
        "node_id",
        "node_run_id",
        "attempt_id",
        "trace",
        "output_artifacts",
        "started_at",
        "finished_at",
        "duration_ms",
        "status",
        "error"
      ],
      "title": "FailedNodeOutput",
      "type": "object"
    },
    "FieldName": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "GroundingOutcome": {
      "enum": [
        "objects",
        "no_target",
        "failed",
        "partial",
        "not_evaluated"
      ],
      "title": "GroundingOutcome",
      "type": "string"
    },
    "GroundingRecordRef": {
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Record Id",
          "type": "string"
        },
        "record_kind": {
          "const": "grounding_record",
          "title": "Record Kind",
          "type": "string"
        }
      },
      "required": [
        "record_kind",
        "record_id"
      ],
      "title": "GroundingRecordRef",
      "type": "object"
    },
    "IssueIndex": {
      "minimum": 0,
      "type": "integer"
    },
    "IssuePath": {
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/FieldName"
          },
          {
            "$ref": "#/$defs/IssueIndex"
          }
        ]
      },
      "maxItems": 32,
      "type": "array"
    },
    "NodeError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Code",
          "type": "string"
        },
        "error_class": {
          "enum": [
            "validation",
            "dependency",
            "transport",
            "timeout",
            "resource",
            "internal"
          ],
          "title": "Error Class",
          "type": "string"
        },
        "message": {
          "$ref": "#/$defs/Description"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        },
        "validation_issues": {
          "$ref": "#/$defs/NodeIssues"
        }
      },
      "required": [
        "code",
        "error_class",
        "retryable",
        "message",
        "validation_issues"
      ],
      "title": "NodeError",
      "type": "object"
    },
    "NodeId": {
      "enum": [
        "N01",
        "N02",
        "N03",
        "N04",
        "N05",
        "N06"
      ],
      "title": "NodeId",
      "type": "string"
    },
    "NodeIssues": {
      "items": {
        "$ref": "#/$defs/ValidationIssue"
      },
      "maxItems": 1024,
      "type": "array"
    },
    "NodeOutputEnvelope": {
      "discriminator": {
        "mapping": {
          "cancelled": "#/$defs/CancelledNodeOutput",
          "failed": "#/$defs/FailedNodeOutput",
          "succeeded": "#/$defs/SucceededNodeOutput"
        },
        "propertyName": "status"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/SucceededNodeOutput"
        },
        {
          "$ref": "#/$defs/FailedNodeOutput"
        },
        {
          "$ref": "#/$defs/CancelledNodeOutput"
        }
      ]
    },
    "NodeOutputs": {
      "items": {
        "$ref": "#/$defs/ArtifactOutputRef"
      },
      "maxItems": 1024,
      "type": "array",
      "uniqueItems": true
    },
    "NonNegativeBudget": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "type": "integer"
    },
    "ObjectRef": {
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Record Id",
          "type": "string"
        },
        "record_kind": {
          "const": "object",
          "title": "Record Kind",
          "type": "string"
        }
      },
      "required": [
        "record_kind",
        "record_id"
      ],
      "title": "ObjectRef",
      "type": "object"
    },
    "ObjectRefs": {
      "items": {
        "$ref": "#/$defs/ObjectRef"
      },
      "maxItems": 1024,
      "type": "array",
      "uniqueItems": true
    },
    "PerceptionValidationIssues": {
      "items": {
        "$ref": "#/$defs/ValidationIssue"
      },
      "maxItems": 1024,
      "type": "array"
    },
    "ProfileContentRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_kind": {
          "const": "profile",
          "title": "Artifact Kind",
          "type": "string"
        },
        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_kind",
        "artifact_id",
        "version",
        "digest"
      ],
      "title": "ProfileContentRef",
      "type": "object"
    },
    "ProfileGroundingResult": {
      "additionalProperties": false,
      "properties": {
        "effective_question_refs": {
          "$ref": "#/$defs/QuestionSelectionRefs"
        },
        "grounding_record_ref": {
          "$ref": "#/$defs/GroundingRecordRef"
        },
        "object_refs": {
          "$ref": "#/$defs/ObjectRefs"
        },
        "outcome": {
          "$ref": "#/$defs/GroundingOutcome"
        },
        "profile_ref": {
          "$ref": "#/$defs/ProfileContentRef"
        },
        "question_selection_ref": {
          "$ref": "#/$defs/QuestionSelectionRef"
        },
        "validation_issues": {
          "$ref": "#/$defs/PerceptionValidationIssues"
        }
      },
      "required": [
        "profile_ref",
        "question_selection_ref",
        "effective_question_refs",
        "outcome",
        "grounding_record_ref",
        "object_refs",
        "validation_issues"
      ],
      "title": "ProfileGroundingResult",
      "type": "object"
    },
    "QuestionContentRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_kind": {
          "const": "question",
          "title": "Artifact Kind",
          "type": "string"
        },
        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_kind",
        "artifact_id",
        "version",
        "digest"
      ],
      "title": "QuestionContentRef",
      "type": "object"
    },
    "QuestionSelectionRef": {
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Record Id",
          "type": "string"
        },
        "record_kind": {
          "const": "question_selection_record",
          "title": "Record Kind",
          "type": "string"
        }
      },
      "required": [
        "record_kind",
        "record_id"
      ],
      "title": "QuestionSelectionRef",
      "type": "object"
    },
    "QuestionSelectionRefs": {
      "items": {
        "$ref": "#/$defs/QuestionContentRef"
      },
      "maxItems": 1024,
      "type": "array",
      "uniqueItems": true
    },
    "RuntimeRecordKind": {
      "enum": [
        "task",
        "execution",
        "node_run",
        "attempt",
        "object",
        "fact",
        "evidence",
        "tool_execution",
        "model_invocation",
        "decision",
        "release",
        "activation",
        "context_snapshot",
        "grounding_record",
        "question_selection_record",
        "authoritative_result_selection",
        "execution_coverage",
        "profile_eligibility_evaluation",
        "rule_set_applicability_evaluation",
        "rule_applicability_evaluation",
        "applicability_trace",
        "unresolved_obligation",
        "replay_run",
        "execution_event",
        "candidate_prediction",
        "observation_batch",
        "tool_plan_run_summary"
      ],
      "title": "RuntimeRecordKind",
      "type": "string"
    },
    "RuntimeRecordRef": {
      "additionalProperties": false,
      "description": "Record identity, interpreted within its owning root's pinned scope.\n\nIn particular an Object ID is Execution-local: this nested ref must not be\nresolved globally or reused across Executions. Scope/existence checks belong\nto the later owning record contracts, not a hidden resolver in this model.",
      "properties": {
        "record_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Record Id",
          "type": "string"
        },
        "record_kind": {
          "$ref": "#/$defs/RuntimeRecordKind"
        }
      },
      "required": [
        "record_kind",
        "record_id"
      ],
      "title": "RuntimeRecordRef",
      "type": "object"
    },
    "SucceededNodeOutput": {
      "additionalProperties": false,
      "properties": {
        "attempt_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Attempt Id",
          "type": "string"
        },
        "duration_ms": {
          "$ref": "#/$defs/NonNegativeBudget"
        },
        "finished_at": {
          "$ref": "#/$defs/UTCDateTime"
        },
        "node_id": {
          "$ref": "#/$defs/NodeId"
        },
        "node_run_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Node Run Id",
          "type": "string"
        },
        "output_artifacts": {
          "$ref": "#/$defs/NodeOutputs"
        },
        "schema_version": {
          "const": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "started_at": {
          "$ref": "#/$defs/UTCDateTime"
        },
        "status": {
          "const": "succeeded",
          "title": "Status",
          "type": "string"
        },
        "trace": {
          "$ref": "#/$defs/TraceContext"
        }
      },
      "required": [
        "schema_version",
        "node_id",
        "node_run_id",
        "attempt_id",
        "trace",
        "output_artifacts",
        "started_at",
        "finished_at",
        "duration_ms",
        "status"
      ],
      "title": "SucceededNodeOutput",
      "type": "object"
    },
    "TraceContext": {
      "additionalProperties": false,
      "properties": {
        "parent_span_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "not": {
                "pattern": "\\s"
              },
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Span Id"
        },
        "span_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "not": {
                "pattern": "\\s"
              },
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Span Id"
        },
        "trace_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Trace Id",
          "type": "string"
        }
      },
      "required": [
        "trace_id"
      ],
      "title": "TraceContext",
      "type": "object"
    },
    "UTCDateTime": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])[Tt](?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:[Zz]|\\+00:00)$(?![\\s\\S])",
      "type": "string"
    },
    "ValidationIssue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "$ref": "#/$defs/Description"
        },
        "path": {
          "$ref": "#/$defs/IssuePath"
        },
        "related_refs": {
          "items": {
            "$ref": "#/$defs/ContentRef"
          },
          "maxItems": 16,
          "title": "Related Refs",
          "type": "array"
        }
      },
      "required": [
        "code",
        "path",
        "message",
        "related_refs"
      ],
      "title": "ValidationIssue",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "envelope": {
      "$ref": "#/$defs/NodeOutputEnvelope"
    },
    "profile_results": {
      "items": {
        "$ref": "#/$defs/ProfileGroundingResult"
      },
      "maxItems": 1024,
      "minItems": 1,
      "title": "Profile Results",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "envelope",
    "profile_results"
  ],
  "title": "GroundingOutput",
  "type": "object"
}
