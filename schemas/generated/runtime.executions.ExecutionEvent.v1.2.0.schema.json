      "type": "string"
    },
    "SystemOutputAuthorityWitness": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "scope": {
                "const": "object"
              }
            },
            "required": [
              "scope"
            ]
          },
          "then": {
            "required": [
              "object_id",
              "profile_ref"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "scope": {
                "const": "execution"
              }
            },
            "required": [
              "scope"
            ]
          },
          "then": {
            "properties": {
              "object_id": false,
              "profile_ref": false
            }
          }
        }
      ],
      "properties": {
        "arrival_qualification": {
          "enum": [
            "on_time",
            "late",
            "unresolved"
          ],
          "title": "Arrival Qualification",
          "type": "string"
        },
        "execution_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Execution Id",
          "type": "string"
        },
        "object_id": {
          "$ref": "#/$defs/AbsentOptional_Annotated_str__StringConstraints__FieldInfo_annotation_NoneType__required_True__json_schema_extra___not_____pattern___"
        },
        "output": {
          "$ref": "#/$defs/MappedOutputResult"
        },
        "profile_ref": {
          "$ref": "#/$defs/AbsentOptional_ProfileContentRef_"
        },
        "scope": {
          "$ref": "#/$defs/FactScope"
        }
      },
      "required": [
        "execution_id",
        "scope",
        "arrival_qualification",
        "output"
      ],
      "title": "SystemOutputAuthorityWitness",
      "type": "object"
    },
