{
  "$defs": {
    "AbsentOptional_ReviewReportRef_": {
      "$ref": "#/$defs/ReviewReportRef"
    },
    "AuthoritySelectionRef": {
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Record Id",
          "type": "string"
        },
        "record_kind": {
          "const": "authoritative_result_selection",
          "title": "Record Kind",
          "type": "string"
        }
      },
      "required": [
        "record_kind",
        "record_id"
      ],
      "title": "AuthoritySelectionRef",
      "type": "object"
    },
    "BlockedRequiredEvidenceGuard": {
      "additionalProperties": false,
      "properties": {
        "authoritative_result_selection_refs": {
          "$ref": "#/$defs/RecordList_AuthoritySelectionRef_"
        },
        "fact_proofs": {
          "$ref": "#/$defs/RecordList_RequiredFactProof_"
        },
        "outcome": {
          "const": "blocked",
          "title": "Outcome",
          "type": "string"
        },
        "reasons": {
          "items": {
            "$ref": "#/$defs/RequiredEvidenceReason"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Reasons",
          "type": "array",
          "uniqueItems": true
        },
        "required_evidence_refs": {
          "$ref": "#/$defs/EvidenceRefs"
        },
        "required_fact_refs": {
          "$ref": "#/$defs/FactRefs"
        }
      },
      "required": [
        "required_fact_refs",
        "required_evidence_refs",
        "authoritative_result_selection_refs",
        "fact_proofs",
        "outcome",
        "reasons"
      ],
      "title": "BlockedRequiredEvidenceGuard",
      "type": "object"
    },
    "CapabilityFeature": {
      "enum": [
        "rgb_image",
        "typed_context",
        "structured_output",
        "original_xyxy",
        "mask_output",
        "geometry_output",
        "ocr_text"
      ],
      "title": "CapabilityFeature",
      "type": "string"
    },
    "CompleteRequiredEvidenceGuard": {
      "additionalProperties": false,
      "properties": {
        "authoritative_result_selection_refs": {
          "$ref": "#/$defs/RecordList_AuthoritySelectionRef_"
        },
        "fact_proofs": {
          "$ref": "#/$defs/RecordList_RequiredFactProof_"
        },
        "outcome": {
          "const": "complete",
          "title": "Outcome",
          "type": "string"
        },
        "required_evidence_refs": {
          "$ref": "#/$defs/EvidenceRefs"
        },
        "required_fact_refs": {
          "$ref": "#/$defs/FactRefs"
        }
      },
      "required": [
        "required_fact_refs",
        "required_evidence_refs",
        "authoritative_result_selection_refs",
        "fact_proofs",
        "outcome"
      ],
      "title": "CompleteRequiredEvidenceGuard",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Record Id",
          "type": "string"
        },
        "record_kind": {
          "const": "evidence",
          "title": "Record Kind",
          "type": "string"
        }
      },
      "required": [
        "record_kind",
        "record_id"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "EvidenceRefs": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "maxItems": 1024,
      "type": "array",
      "uniqueItems": true
    },
    "FactRef": {
      "additionalProperties": false,
      "properties": {
        "record_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Record Id",
          "type": "string"
        },
        "record_kind": {
          "const": "fact",
          "title": "Record Kind",
          "type": "string"
        }
      },
      "required": [
        "record_kind",
        "record_id"
      ],
      "title": "FactRef",
      "type": "object"
    },
    "FactRefs": {
      "items": {
        "$ref": "#/$defs/FactRef"
      },
      "maxItems": 1024,
      "type": "array",
      "uniqueItems": true
    },
    "FactSchemaContentRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_kind": {
          "const": "fact_schema",
          "title": "Artifact Kind",
          "type": "string"
        },
        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_kind",
        "artifact_id",
        "version",
        "digest"
      ],
      "title": "FactSchemaContentRef",
      "type": "object"
    },
    "FactScope": {
      "enum": [
        "object",
        "execution"
      ],
      "title": "FactScope",
      "type": "string"
    },
    "FactSelector": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "scope": {
                "const": "execution"
              }
            },
            "required": [
              "scope"
            ]
          },
          "then": {
            "properties": {
              "producer_selector": {
                "properties": {
                  "producer_kind": {
                    "const": "system"
                  }
                }
              }
            }
          }
        }
      ],
      "properties": {
        "fact_key": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Fact Key",
          "type": "string"
        },
        "fact_schema_ref": {
          "$ref": "#/$defs/FactSchemaContentRef"
        },
        "field_path": {
          "$ref": "#/$defs/FieldPath"
        },
        "producer_selector": {
          "$ref": "#/$defs/ProducerSelector"
        },
        "scope": {
          "$ref": "#/$defs/FactScope"
        }
      },
      "required": [
        "scope",
        "fact_key",
        "fact_schema_ref",
        "producer_selector",
        "field_path"
      ],
      "title": "FactSelector",
      "type": "object"
    },
    "FieldName": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "FieldPath": {
      "items": {
        "$ref": "#/$defs/FieldName"
      },
      "maxItems": 8,
      "type": "array"
    },
    "ProducerSelector": {
      "discriminator": {
        "mapping": {
          "system": "#/$defs/SystemProducerSelector",
          "tool": "#/$defs/ToolProducerSelector",
          "vlm_question": "#/$defs/QuestionProducerSelector"
        },
        "propertyName": "producer_kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/QuestionProducerSelector"
        },
        {
          "$ref": "#/$defs/ToolProducerSelector"
        },
        {
          "$ref": "#/$defs/SystemProducerSelector"
        }
      ]
    },
    "QuestionContentRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_kind": {
          "const": "question",
          "title": "Artifact Kind",
          "type": "string"
        },
        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_kind",
        "artifact_id",
        "version",
        "digest"
      ],
      "title": "QuestionContentRef",
      "type": "object"
    },
    "QuestionProducerSelector": {
      "additionalProperties": false,
      "properties": {
        "output_name": {
          "const": "primary",
          "title": "Output Name",
          "type": "string"
        },
        "producer_kind": {
          "const": "vlm_question",
          "title": "Producer Kind",
          "type": "string"
        },
        "question_ref": {
          "$ref": "#/$defs/QuestionContentRef"
        }
      },
      "required": [
        "producer_kind",
        "question_ref",
        "output_name"
      ],
      "title": "QuestionProducerSelector",
      "type": "object"
    },
    "RecordList_AuthoritySelectionRef_": {
      "items": {
        "$ref": "#/$defs/AuthoritySelectionRef"
      },
      "maxItems": 1024,
      "type": "array",
      "uniqueItems": true
    },
    "RecordList_RequiredFactProof_": {
      "items": {
        "$ref": "#/$defs/RequiredFactProof"
      },
      "maxItems": 1024,
      "type": "array",
      "uniqueItems": true
    },
    "RequiredEvidenceReason": {
      "enum": [
        "required_fact_unavailable",
        "evidence_unavailable",
        "producer_authority_unresolved"
      ],
      "title": "RequiredEvidenceReason",
      "type": "string"
    },
    "RequiredFactProof": {
      "additionalProperties": false,
      "properties": {
        "authority_selection_ref": {
          "$ref": "#/$defs/AuthoritySelectionRef"
        },
        "fact_ref": {
          "$ref": "#/$defs/FactRef"
        },
        "selector": {
          "$ref": "#/$defs/FactSelector"
        }
      },
      "required": [
        "selector",
        "fact_ref",
        "authority_selection_ref"
      ],
      "title": "RequiredFactProof",
      "type": "object"
    },
    "ReviewReportRef": {
      "additionalProperties": false,
      "properties": {
        "report_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Report Id",
          "type": "string"
        },
        "review_registry_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Review Registry Id",
          "type": "string"
        },
        "sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "report_id",
        "version",
        "sha256",
        "review_registry_id"
      ],
      "title": "ReviewReportRef",
      "type": "object"
    },
    "SystemProducerRequirement": {
      "additionalProperties": false,
      "properties": {
        "allowed_implementation_versions": {
          "items": {
            "maxLength": 128,
            "minLength": 5,
            "not": {
              "pattern": "\\s"
            },
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
            "type": "string"
          },
          "maxItems": 1024,
          "minItems": 1,
          "title": "Allowed Implementation Versions",
          "type": "array",
          "uniqueItems": true
        },
        "capability_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Capability Id",
          "type": "string"
        },
        "contract_version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Contract Version",
          "type": "string"
        },
        "evaluation_ref": {
          "$ref": "#/$defs/AbsentOptional_ReviewReportRef_"
        },
        "family": {
          "const": "system_fact_producer",
          "title": "Family",
          "type": "string"
        },
        "required_features": {
          "items": {
            "$ref": "#/$defs/CapabilityFeature"
          },
          "maxItems": 7,
          "title": "Required Features",
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "family",
        "capability_id",
        "contract_version",
        "allowed_implementation_versions",
        "required_features"
      ],
      "title": "SystemProducerRequirement",
      "type": "object"
    },
    "SystemProducerSelector": {
      "additionalProperties": false,
      "properties": {
        "output_name": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Output Name",
          "type": "string"
        },
        "producer_kind": {
          "const": "system",
          "title": "Producer Kind",
          "type": "string"
        },
        "requirement": {
          "$ref": "#/$defs/SystemProducerRequirement"
        }
      },
      "required": [
        "producer_kind",
        "requirement",
        "output_name"
      ],
      "title": "SystemProducerSelector",
      "type": "object"
    },
    "ToolContentRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_kind": {
          "const": "tool",
          "title": "Artifact Kind",
          "type": "string"
        },
        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_kind",
        "artifact_id",
        "version",
        "digest"
      ],
      "title": "ToolContentRef",
      "type": "object"
    },
    "ToolPlanContentRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_kind": {
          "const": "tool_plan",
          "title": "Artifact Kind",
          "type": "string"
        },
        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_kind",
        "artifact_id",
        "version",
        "digest"
      ],
      "title": "ToolPlanContentRef",
      "type": "object"
    },
    "ToolProducerSelector": {
      "additionalProperties": false,
      "properties": {
        "output_name": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Output Name",
          "type": "string"
        },
        "producer_kind": {
          "const": "tool",
          "title": "Producer Kind",
          "type": "string"
        },
        "step_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Step Id",
          "type": "string"
        },
        "tool_plan_ref": {
          "$ref": "#/$defs/ToolPlanContentRef"
        },
        "tool_ref": {
          "$ref": "#/$defs/ToolContentRef"
        }
      },
      "required": [
        "producer_kind",
        "tool_plan_ref",
        "step_id",
        "tool_ref",
        "output_name"
      ],
      "title": "ToolProducerSelector",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "discriminator": {
    "mapping": {
      "blocked": "#/$defs/BlockedRequiredEvidenceGuard",
      "complete": "#/$defs/CompleteRequiredEvidenceGuard"
    },
    "propertyName": "outcome"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/CompleteRequiredEvidenceGuard"
    },
    {
      "$ref": "#/$defs/BlockedRequiredEvidenceGuard"
    }
  ]
}
