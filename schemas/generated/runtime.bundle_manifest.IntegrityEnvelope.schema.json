{
  "$defs": {
    "DetachedSignatureRef": {
      "additionalProperties": false,
      "description": "Pin opaque signature evidence without declaring cryptographic trust.",
      "properties": {
        "sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "signature_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Signature Id",
          "type": "string"
        },
        "signature_registry_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Signature Registry Id",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "signature_id",
        "version",
        "sha256",
        "signature_registry_id"
      ],
      "title": "DetachedSignatureRef",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "canonicalization_id": {
      "const": "jcs-sha256-v1",
      "title": "Canonicalization Id",
      "type": "string"
    },
    "hash_algorithm": {
      "const": "sha256",
      "title": "Hash Algorithm",
      "type": "string"
    },
    "root_digest": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Root Digest",
      "type": "string"
    },
    "signatures": {
      "items": {
        "$ref": "#/$defs/DetachedSignatureRef"
      },
      "maxItems": 64,
      "title": "Signatures",
      "type": "array"
    }
  },
  "required": [
    "hash_algorithm",
    "canonicalization_id",
    "root_digest",
    "signatures"
  ],
  "title": "IntegrityEnvelope",
  "type": "object"
}
