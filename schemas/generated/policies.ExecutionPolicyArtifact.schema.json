{
  "$defs": {
    "ExecutionPolicy": {
      "additionalProperties": false,
      "properties": {
        "artifact_schema_refs": {
          "items": {
            "$ref": "#/$defs/SchemaRef"
          },
          "maxItems": 1024,
          "title": "Artifact Schema Refs",
          "type": "array"
        },
        "context_provenance_policy_ref": {
          "$ref": "#/$defs/PolicyContentRef"
        },
        "coverage_policy_ref": {
          "$ref": "#/$defs/PolicyContentRef"
        },
        "node_order": {
          "maxItems": 6,
          "minItems": 6,
          "prefixItems": [
            {
              "const": "N01",
              "type": "string"
            },
            {
              "const": "N02",
              "type": "string"
            },
            {
              "const": "N03",
              "type": "string"
            },
            {
              "const": "N04",
              "type": "string"
            },
            {
              "const": "N05",
              "type": "string"
            },
            {
              "const": "N06",
              "type": "string"
            }
          ],
          "title": "Node Order",
          "type": "array"
        },
        "policy_kind": {
          "const": "execution",
          "title": "Policy Kind",
          "type": "string"
        },
        "resource_requirements_ref": {
          "$ref": "#/$defs/PolicyContentRef"
        },
        "workflow_version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Workflow Version",
          "type": "string"
        }
      },
      "required": [
        "policy_kind",
        "workflow_version",
        "node_order",
        "coverage_policy_ref",
        "context_provenance_policy_ref",
        "resource_requirements_ref",
        "artifact_schema_refs"
      ],
      "title": "ExecutionPolicy",
      "type": "object"
    },
    "PolicyContentRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_kind": {
          "const": "policy",
          "title": "Artifact Kind",
          "type": "string"
        },
        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_kind",
        "artifact_id",
        "version",
        "digest"
      ],
      "title": "PolicyContentRef",
      "type": "object"
    },
    "SchemaRef": {
      "additionalProperties": false,
      "description": "A constrained ContentRef, not a second schema identity system.",
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_kind": {
          "enum": [
            "fact_schema",
            "value_schema",
            "response_schema",
            "attribute_schema",
            "context_schema",
            "tool_input_schema",
            "tool_output_schema",
            "object_schema",
            "decision_schema"
          ],
          "title": "Artifact Kind",
          "type": "string"
        },
        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "schema_dialect": {
          "const": "https://json-schema.org/draft/2020-12/schema",
          "title": "Schema Dialect",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_kind",
        "artifact_id",
        "version",
        "digest",
        "schema_dialect"
      ],
      "title": "SchemaRef",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "policy": {
      "$ref": "#/$defs/ExecutionPolicy"
    },
    "policy_id": {
      "maxLength": 128,
      "minLength": 1,
      "not": {
        "pattern": "\\s"
      },
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
      "title": "Policy Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "version": {
      "maxLength": 128,
      "minLength": 5,
      "not": {
        "pattern": "\\s"
      },
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "policy_id",
    "version",
    "policy"
  ],
  "title": "ExecutionPolicyArtifact",
  "type": "object"
}
