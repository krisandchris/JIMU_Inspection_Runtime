{
  "$defs": {
    "FieldName": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "FieldPath": {
      "items": {
        "$ref": "#/$defs/FieldName"
      },
      "maxItems": 8,
      "type": "array"
    },
    "SchemaRef": {
      "additionalProperties": false,
      "description": "A constrained ContentRef, not a second schema identity system.",
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_kind": {
          "enum": [
            "fact_schema",
            "value_schema",
            "response_schema",
            "attribute_schema",
            "context_schema",
            "tool_input_schema",
            "tool_output_schema",
            "object_schema",
            "decision_schema"
          ],
          "title": "Artifact Kind",
          "type": "string"
        },
        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "schema_dialect": {
          "const": "https://json-schema.org/draft/2020-12/schema",
          "title": "Schema Dialect",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_kind",
        "artifact_id",
        "version",
        "digest",
        "schema_dialect"
      ],
      "title": "SchemaRef",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "field_path": {
      "$ref": "#/$defs/FieldPath"
    },
    "schema_ref": {
      "$ref": "#/$defs/SchemaRef"
    }
  },
  "required": [
    "schema_ref",
    "field_path"
  ],
  "title": "FieldSelector",
  "type": "object"
}
