{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Identity of one immutable logical Bundle, separate from artifact references.",
  "properties": {
    "bundle_digest": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Bundle Digest",
      "type": "string"
    },
    "bundle_id": {
      "maxLength": 128,
      "minLength": 1,
      "not": {
        "pattern": "\\s"
      },
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
      "title": "Bundle Id",
      "type": "string"
    },
    "bundle_version": {
      "maxLength": 128,
      "minLength": 5,
      "not": {
        "pattern": "\\s"
      },
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "title": "Bundle Version",
      "type": "string"
    }
  },
  "required": [
    "bundle_id",
    "bundle_version",
    "bundle_digest"
  ],
  "title": "BundleRef",
  "type": "object"
}
