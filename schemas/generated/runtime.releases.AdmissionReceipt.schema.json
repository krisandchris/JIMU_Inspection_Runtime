{
  "$defs": {
    "AbsentOptional_ReviewReportRef_": {
      "$ref": "#/$defs/ReviewReportRef"
    },
    "ActorRef": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Actor Id",
          "type": "string"
        },
        "actor_kind": {
          "enum": [
            "service",
            "human"
          ],
          "title": "Actor Kind",
          "type": "string"
        },
        "identity_registry_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Identity Registry Id",
          "type": "string"
        }
      },
      "required": [
        "actor_kind",
        "actor_id",
        "identity_registry_id"
      ],
      "title": "ActorRef",
      "type": "object"
    },
    "AdmissionIssues": {
      "items": {
        "$ref": "#/$defs/ValidationIssue"
      },
      "maxItems": 128,
      "type": "array"
    },
    "ArtifactKind": {
      "enum": [
        "entity",
        "region",
        "profile",
        "facet",
        "question",
        "tool",
        "tool_plan",
        "rule",
        "rule_set",
        "model_binding",
        "fact_schema",
        "prompt_template",
        "response_schema",
        "attribute_schema",
        "context_schema",
        "tool_input_schema",
        "tool_output_schema",
        "object_schema",
        "decision_schema",
        "value_schema",
        "policy",
        "vocabulary",
        "geometry_resource",
        "static_asset",
        "fact_producer_catalog"
      ],
      "title": "ArtifactKind",
      "type": "string"
    },
    "CapabilityAssessment": {
      "discriminator": {
        "mapping": {
          "not_evaluated": "#/$defs/UnavailableCapability",
          "supported": "#/$defs/SupportedCapability",
          "unsupported": "#/$defs/UnavailableCapability"
        },
        "propertyName": "status"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/SupportedCapability"
        },
        {
          "$ref": "#/$defs/UnavailableCapability"
        }
      ]
    },
    "CapabilityAssessments": {
      "items": {
        "$ref": "#/$defs/CapabilityAssessment"
      },
      "maxItems": 1024,
      "type": "array"
    },
    "CapabilityFamily": {
      "enum": [
        "model_deployment",
        "tool_implementation",
        "system_fact_producer",
        "context_derivation"
      ],
      "title": "CapabilityFamily",
      "type": "string"
    },
    "CapabilityFeature": {
      "enum": [
        "rgb_image",
        "typed_context",
        "structured_output",
        "original_xyxy",
        "mask_output",
        "geometry_output",
        "ocr_text"
      ],
      "title": "CapabilityFeature",
      "type": "string"
    },
    "CapabilityReport": {
      "additionalProperties": false,
      "properties": {
        "optional": {
          "$ref": "#/$defs/CapabilityAssessments"
        },
        "required": {
          "$ref": "#/$defs/CapabilityAssessments"
        }
      },
      "required": [
        "required",
        "optional"
      ],
      "title": "CapabilityReport",
      "type": "object"
    },
    "ContentRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_kind": {
          "$ref": "#/$defs/ArtifactKind"
        },
        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_kind",
        "artifact_id",
        "version",
        "digest"
      ],
      "title": "ContentRef",
      "type": "object"
    },
    "Description": {
      "maxLength": 4096,
      "minLength": 1,
      "pattern": "\\S",
      "type": "string"
    },
    "ExternalCapabilityRequirement": {
      "additionalProperties": false,
      "properties": {
        "allowed_implementation_versions": {
          "items": {
            "maxLength": 128,
            "minLength": 5,
            "not": {
              "pattern": "\\s"
            },
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
            "type": "string"
          },
          "maxItems": 1024,
          "minItems": 1,
          "title": "Allowed Implementation Versions",
          "type": "array",
          "uniqueItems": true
        },
        "capability_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Capability Id",
          "type": "string"
        },
        "contract_version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Contract Version",
          "type": "string"
        },
        "evaluation_ref": {
          "$ref": "#/$defs/AbsentOptional_ReviewReportRef_"
        },
        "family": {
          "$ref": "#/$defs/CapabilityFamily"
        },
        "required_features": {
          "items": {
            "$ref": "#/$defs/CapabilityFeature"
          },
          "maxItems": 7,
          "title": "Required Features",
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "family",
        "capability_id",
        "contract_version",
        "allowed_implementation_versions",
        "required_features"
      ],
      "title": "ExternalCapabilityRequirement",
      "type": "object"
    },
    "FieldName": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "IssueIndex": {
      "minimum": 0,
      "type": "integer"
    },
    "IssuePath": {
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/FieldName"
          },
          {
            "$ref": "#/$defs/IssueIndex"
          }
        ]
      },
      "maxItems": 32,
      "type": "array"
    },
    "ReviewReportRef": {
      "additionalProperties": false,
      "properties": {
        "report_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Report Id",
          "type": "string"
        },
        "review_registry_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Review Registry Id",
          "type": "string"
        },
        "sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "report_id",
        "version",
        "sha256",
        "review_registry_id"
      ],
      "title": "ReviewReportRef",
      "type": "object"
    },
    "SupportedCapability": {
      "additionalProperties": false,
      "properties": {
        "implementation_version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Implementation Version",
          "type": "string"
        },
        "requirement": {
          "$ref": "#/$defs/ExternalCapabilityRequirement"
        },
        "status": {
          "const": "supported",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "requirement",
        "implementation_version"
      ],
      "title": "SupportedCapability",
      "type": "object"
    },
    "UTCDateTime": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])[Tt](?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:[Zz]|\\+00:00)$(?![\\s\\S])",
      "type": "string"
    },
    "UnavailableCapability": {
      "additionalProperties": false,
      "properties": {
        "requirement": {
          "$ref": "#/$defs/ExternalCapabilityRequirement"
        },
        "status": {
          "enum": [
            "unsupported",
            "not_evaluated"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "requirement"
      ],
      "title": "UnavailableCapability",
      "type": "object"
    },
    "ValidationIssue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "$ref": "#/$defs/Description"
        },
        "path": {
          "$ref": "#/$defs/IssuePath"
        },
        "related_refs": {
          "items": {
            "$ref": "#/$defs/ContentRef"
          },
          "maxItems": 16,
          "title": "Related Refs",
          "type": "array"
        }
      },
      "required": [
        "code",
        "path",
        "message",
        "related_refs"
      ],
      "title": "ValidationIssue",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Runtime technical decision. The receipt carries no business approval.",
  "properties": {
    "accepted": {
      "title": "Accepted",
      "type": "boolean"
    },
    "bundle_digest": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Bundle Digest",
      "type": "string"
    },
    "bundle_id": {
      "maxLength": 128,
      "minLength": 1,
      "not": {
        "pattern": "\\s"
      },
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
      "title": "Bundle Id",
      "type": "string"
    },
    "bundle_version": {
      "maxLength": 128,
      "minLength": 5,
      "not": {
        "pattern": "\\s"
      },
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "title": "Bundle Version",
      "type": "string"
    },
    "capability_report": {
      "$ref": "#/$defs/CapabilityReport"
    },
    "errors": {
      "$ref": "#/$defs/AdmissionIssues"
    },
    "receipt_id": {
      "maxLength": 128,
      "minLength": 1,
      "not": {
        "pattern": "\\s"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Receipt Id",
      "type": "string"
    },
    "runtime_identity": {
      "$ref": "#/$defs/ActorRef"
    },
    "runtime_version": {
      "maxLength": 128,
      "minLength": 5,
      "not": {
        "pattern": "\\s"
      },
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "title": "Runtime Version",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "timestamp": {
      "$ref": "#/$defs/UTCDateTime"
    },
    "warnings": {
      "$ref": "#/$defs/AdmissionIssues"
    }
  },
  "required": [
    "bundle_id",
    "bundle_version",
    "bundle_digest",
    "schema_version",
    "receipt_id",
    "runtime_version",
    "runtime_identity",
    "accepted",
    "capability_report",
    "errors",
    "warnings",
    "timestamp"
  ],
  "title": "AdmissionReceipt",
  "type": "object"
}
