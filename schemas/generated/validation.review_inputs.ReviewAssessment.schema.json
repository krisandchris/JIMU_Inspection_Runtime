{
  "$defs": {
    "BindingRefs": {
      "items": {
        "$ref": "#/$defs/ReviewBindingRef"
      },
      "maxItems": 1024,
      "minItems": 1,
      "type": "array"
    },
    "BindingReviewScope": {
      "additionalProperties": false,
      "properties": {
        "binding_refs": {
          "$ref": "#/$defs/BindingRefs"
        },
        "scope_kind": {
          "const": "binding",
          "title": "Scope Kind",
          "type": "string"
        }
      },
      "required": [
        "binding_refs",
        "scope_kind"
      ],
      "title": "BindingReviewScope",
      "type": "object"
    },
    "FallbackTransitionAssessment": {
      "additionalProperties": false,
      "properties": {
        "assessment_kind": {
          "const": "fallback_transition",
          "title": "Assessment Kind",
          "type": "string"
        },
        "capability": {
          "$ref": "#/$defs/ModelCapability"
        },
        "contract_compatibility": {
          "const": "exact",
          "title": "Contract Compatibility",
          "type": "string"
        },
        "input_schema_ref": {
          "$ref": "#/$defs/SchemaRef"
        },
        "output_schema_ref": {
          "$ref": "#/$defs/SchemaRef"
        },
        "quality_evaluated": {
          "const": true,
          "title": "Quality Evaluated",
          "type": "boolean"
        },
        "scope": {
          "$ref": "#/$defs/ReviewScope"
        },
        "source": {
          "$ref": "#/$defs/ReviewedDeployment"
        },
        "target": {
          "$ref": "#/$defs/ReviewedDeployment"
        },
        "trigger_errors": {
          "items": {
            "$ref": "#/$defs/TriggerError"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Trigger Errors",
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "assessment_kind",
        "source",
        "target",
        "capability",
        "scope",
        "trigger_errors",
        "input_schema_ref",
        "output_schema_ref",
        "contract_compatibility",
        "quality_evaluated"
      ],
      "title": "FallbackTransitionAssessment",
      "type": "object"
    },
    "LocalExceptionAssessment": {
      "additionalProperties": false,
      "properties": {
        "applicable_capabilities": {
          "items": {
            "$ref": "#/$defs/ModelCapability"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Applicable Capabilities",
          "type": "array",
          "uniqueItems": true
        },
        "assessment_kind": {
          "const": "local_primary_exception",
          "title": "Assessment Kind",
          "type": "string"
        },
        "exception_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Exception Id",
          "type": "string"
        },
        "exception_version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Exception Version",
          "type": "string"
        },
        "primary": {
          "$ref": "#/$defs/ReviewedLocalDeployment"
        },
        "reason": {
          "enum": [
            "explicit_local_capability",
            "privacy_restriction",
            "unavailable_remote_capability"
          ],
          "title": "Reason",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/ReviewScope"
        }
      },
      "required": [
        "assessment_kind",
        "exception_id",
        "exception_version",
        "primary",
        "applicable_capabilities",
        "scope",
        "reason"
      ],
      "title": "LocalExceptionAssessment",
      "type": "object"
    },
    "ModelCapability": {
      "enum": [
        "profile_discovery",
        "object_grounding",
        "object_observation",
        "candidate_prediction",
        "vision_auxiliary"
      ],
      "title": "ModelCapability",
      "type": "string"
    },
    "ProfileRefs": {
      "items": {
        "$ref": "#/$defs/ReviewProfileRef"
      },
      "maxItems": 1024,
      "minItems": 1,
      "type": "array"
    },
    "ProfileRegionReviewScope": {
      "additionalProperties": false,
      "properties": {
        "binding_refs": {
          "$ref": "#/$defs/BindingRefs"
        },
        "profile_refs": {
          "$ref": "#/$defs/ProfileRefs"
        },
        "region_refs": {
          "$ref": "#/$defs/RegionRefs"
        },
        "scope_kind": {
          "const": "profile_region",
          "title": "Scope Kind",
          "type": "string"
        }
      },
      "required": [
        "scope_kind",
        "binding_refs",
        "profile_refs",
        "region_refs"
      ],
      "title": "ProfileRegionReviewScope",
      "type": "object"
    },
    "ProfileReviewScope": {
      "additionalProperties": false,
      "properties": {
        "binding_refs": {
          "$ref": "#/$defs/BindingRefs"
        },
        "profile_refs": {
          "$ref": "#/$defs/ProfileRefs"
        },
        "scope_kind": {
          "const": "profile",
          "title": "Scope Kind",
          "type": "string"
        }
      },
      "required": [
        "binding_refs",
        "scope_kind",
        "profile_refs"
      ],
      "title": "ProfileReviewScope",
      "type": "object"
    },
    "RegionRefs": {
      "items": {
        "$ref": "#/$defs/ReviewRegionRef"
      },
      "maxItems": 1024,
      "minItems": 1,
      "type": "array"
    },
    "RegionReviewScope": {
      "additionalProperties": false,
      "properties": {
        "binding_refs": {
          "$ref": "#/$defs/BindingRefs"
        },
        "region_refs": {
          "$ref": "#/$defs/RegionRefs"
        },
        "scope_kind": {
          "const": "region",
          "title": "Scope Kind",
          "type": "string"
        }
      },
      "required": [
        "binding_refs",
        "scope_kind",
        "region_refs"
      ],
      "title": "RegionReviewScope",
      "type": "object"
    },
    "ReviewBindingRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_kind": {
          "const": "model_binding",
          "title": "Artifact Kind",
          "type": "string"
        },
        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_kind",
        "artifact_id",
        "version",
        "digest"
      ],
      "title": "ReviewBindingRef",
      "type": "object"
    },
    "ReviewProfileRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_kind": {
          "const": "profile",
          "title": "Artifact Kind",
          "type": "string"
        },
        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_kind",
        "artifact_id",
        "version",
        "digest"
      ],
      "title": "ReviewProfileRef",
      "type": "object"
    },
    "ReviewRegionRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_kind": {
          "const": "region",
          "title": "Artifact Kind",
          "type": "string"
        },
        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_kind",
        "artifact_id",
        "version",
        "digest"
      ],
      "title": "ReviewRegionRef",
      "type": "object"
    },
    "ReviewScope": {
      "discriminator": {
        "mapping": {
          "binding": "#/$defs/BindingReviewScope",
          "profile": "#/$defs/ProfileReviewScope",
          "profile_region": "#/$defs/ProfileRegionReviewScope",
          "region": "#/$defs/RegionReviewScope"
        },
        "propertyName": "scope_kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/BindingReviewScope"
        },
        {
          "$ref": "#/$defs/ProfileReviewScope"
        },
        {
          "$ref": "#/$defs/RegionReviewScope"
        },
        {
          "$ref": "#/$defs/ProfileRegionReviewScope"
        }
      ]
    },
    "ReviewedDeployment": {
      "additionalProperties": false,
      "properties": {
        "deployment_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Deployment Id",
          "type": "string"
        },
        "deployment_version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Deployment Version",
          "type": "string"
        },
        "logical_model_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Logical Model Id",
          "type": "string"
        },
        "model_version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Model Version",
          "type": "string"
        },
        "provider_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Provider Id",
          "type": "string"
        },
        "provider_kind": {
          "enum": [
            "remote",
            "local"
          ],
          "title": "Provider Kind",
          "type": "string"
        }
      },
      "required": [
        "provider_id",
        "deployment_id",
        "logical_model_id",
        "provider_kind",
        "deployment_version",
        "model_version"
      ],
      "title": "ReviewedDeployment",
      "type": "object"
    },
    "ReviewedLocalDeployment": {
      "additionalProperties": false,
      "properties": {
        "deployment_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Deployment Id",
          "type": "string"
        },
        "deployment_version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Deployment Version",
          "type": "string"
        },
        "logical_model_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Logical Model Id",
          "type": "string"
        },
        "model_version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Model Version",
          "type": "string"
        },
        "provider_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Provider Id",
          "type": "string"
        },
        "provider_kind": {
          "const": "local",
          "title": "Provider Kind",
          "type": "string"
        }
      },
      "required": [
        "provider_id",
        "deployment_id",
        "logical_model_id",
        "provider_kind",
        "deployment_version",
        "model_version"
      ],
      "title": "ReviewedLocalDeployment",
      "type": "object"
    },
    "SchemaRef": {
      "additionalProperties": false,
      "description": "A constrained ContentRef, not a second schema identity system.",
      "properties": {
        "artifact_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "artifact_kind": {
          "enum": [
            "fact_schema",
            "value_schema",
            "response_schema",
            "attribute_schema",
            "context_schema",
            "tool_input_schema",
            "tool_output_schema",
            "object_schema",
            "decision_schema"
          ],
          "title": "Artifact Kind",
          "type": "string"
        },
        "digest": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "schema_dialect": {
          "const": "https://json-schema.org/draft/2020-12/schema",
          "title": "Schema Dialect",
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 5,
          "not": {
            "pattern": "\\s"
          },
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_kind",
        "artifact_id",
        "version",
        "digest",
        "schema_dialect"
      ],
      "title": "SchemaRef",
      "type": "object"
    },
    "TriggerError": {
      "enum": [
        "transport",
        "timeout",
        "rate_limit",
        "unavailable"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "discriminator": {
    "mapping": {
      "fallback_transition": "#/$defs/FallbackTransitionAssessment",
      "local_primary_exception": "#/$defs/LocalExceptionAssessment"
    },
    "propertyName": "assessment_kind"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/FallbackTransitionAssessment"
    },
    {
      "$ref": "#/$defs/LocalExceptionAssessment"
    }
  ]
}
