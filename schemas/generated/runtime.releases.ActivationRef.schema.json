{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "record_id": {
      "maxLength": 128,
      "minLength": 1,
      "not": {
        "pattern": "\\s"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Record Id",
      "type": "string"
    },
    "record_kind": {
      "const": "activation",
      "title": "Record Kind",
      "type": "string"
    }
  },
  "required": [
    "record_kind",
    "record_id"
  ],
  "title": "ActivationRef",
  "type": "object"
}
